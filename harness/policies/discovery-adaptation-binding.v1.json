{
  "schema_version": "startup_opportunity.discovery_adaptation_binding_policy.v1",
  "policy_id": "startup_opportunity.g2_candidate_pre_kill_adaptation",
  "policy_version": "1.0.0",
  "trigger_gap_type": "candidate_pre_killed",
  "allowed_action": "skip_unit",
  "candidate_ref_pattern": "^artifacts/discovery/candidates/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$",
  "target_binding": "exact_gap_subject_in_unit_input_refs",
  "shared_unit_rule": "retain_or_supersede_never_skip",
  "execution_boundary": {
    "harness_dispatches_agent": false,
    "harness_executes_research": false,
    "apply_revalidates": true
  }
}
