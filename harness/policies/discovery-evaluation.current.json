{
  "schema_version": "startup_opportunity.discovery_evaluation_policy.current",
  "policy_id": "startup_opportunity.g2_4_evaluation",
  "policy_version": "3.0.0",
  "eligible_branch_statuses": ["completed", "partial", "insufficient_evidence"],
  "excluded_branch_statuses": ["failed", "ignored_late", "superseded"],
  "required_hard_gates": [
    "user_jtbd_entry_scene",
    "baseline_delta",
    "buyer_purchase",
    "business_engine",
    "source_independence",
    "generation_evaluation_separation",
    "opposing_evidence",
    "compliance_boundary",
    "ai_mandatory_bundle",
    "ai_baseline_gap",
    "ai_reliability",
    "data_rights",
    "unit_economics"
  ],
  "required_comparison_panels": [
    "demand_and_market",
    "solution_and_business",
    "evidence_strength",
    "team_fit_and_learning"
  ],
  "recommendation_ceiling": {
    "failed_gate": "reject",
    "insufficient_gate": "investigate_further",
    "weak_or_unknown_evidence": "investigate_further",
    "partial_branch": "investigate_further",
    "missing_ai_bundle": "investigate_further",
    "business_engine_unknown": "investigate_further",
    "external_validation_missing": "no_automatic_downgrade_beyond_evidence_ceiling"
  },
  "ai_solution_gate_contract": {
    "selected_solution_field": "selected_solution_ref",
    "ai_usage_field": "uses_ai",
    "mandatory_gate_id": "ai_mandatory_bundle",
    "missing_bundle_status": "insufficient_evidence",
    "missing_bundle_decision_tier_ceiling": "investigate_further",
    "g3_bundle_generated_by_g2": false
  },
  "ai_mandatory_bundle_contract": {
    "trigger_version": "startup_opportunity.ai_mandatory_coverage_trigger.v1",
    "required_dimensions": [
      "capability_frontier",
      "cost_and_deployment",
      "workflow_and_human_boundary",
      "ecosystem_and_platform",
      "data_and_evaluation",
      "adoption_and_trust"
    ],
    "coverage_statuses": ["covered", "insufficient_evidence", "not_applicable"],
    "source_unavailable_status": "insufficient_evidence",
    "consumer_binding_statuses": ["bound", "missing", "not_required"],
    "non_ai_binding_status": "not_required",
    "degraded_bundle_states": ["missing", "incomplete", "desk_research_only", "stale"],
    "degraded_decision_tier_ceiling": "investigate_further",
    "caller_supplied_only": true,
    "harness_generated_bundle": false
  },
  "decision_tier_ceiling": {
    "tier_order": ["reject", "insufficient_evidence", "watch", "investigate_further", "prioritize"],
    "first_bet_subject_scope": "selected_subject_only",
    "alternative_bet_effect": "candidate_only",
    "candidate_commercial_ceiling_required": true,
    "no_first_bet_strategy": "best_candidate_readiness",
    "no_first_bet_tiers": ["investigate_further", "watch", "insufficient_evidence"],
    "first_bet_ready_requirements": [
      "portfolio_first_bet_exact",
      "comparison_strong_candidate",
      "hard_gates_eligible",
      "fan_in_strong_candidate",
      "panels_sufficient",
      "ai_bundle_complete_or_not_required",
      "commercial_subject_prioritize"
    ],
    "mixed_inputs_use_strictest_ceiling": true
  },
  "solution_exploration_projection_contract": {
    "comparison_reads_exact_opportunity_summary": true,
    "report_projects_all_formal_solutions": true,
    "non_compared_selection_posture": "provisional_implementation",
    "changes_demand_gate_or_ranking": false,
    "harness_selects_or_generates_solutions": false
  },
  "publication_order": [
    "enrichment_task",
    "typed_material",
    "enrichment_branch",
    "enrichment_fan_in",
    "domain_enrichment",
    "opportunity_comparison",
    "sensitivity",
    "portfolio",
    "decision_recommendation",
    "traceability",
    "report"
  ],
  "reporting_contract": {
    "structured_source": "startup_opportunity.report.v1",
    "materialized_views": ["decision-brief.md", "report.md"],
    "consistency_required": true,
    "consistency_dimensions": [
      "decision",
      "refs",
      "hashes",
      "freshness",
      "limitations",
      "counter_evidence",
      "partial_order",
      "panel_independence",
      "evidence_ceiling",
      "external_action_boundary",
      "new_conclusions",
      "market_validation_language",
      "probability_language",
      "global_score_language",
      "solution_exploration"
    ],
    "global_score_forbidden": true,
    "market_validation_claim_forbidden": true,
    "scan_contract_version": "startup_opportunity.deterministic_forbidden_expression_scan.v2",
    "scan_surfaces": ["structured_report", "decision_brief", "report_view"],
    "forbidden_rule_ids": [
      "market_validation_success",
      "probability_claim",
      "global_score",
      "comparative_selection_claim"
    ]
  },
  "execution_boundary": {
    "formal_artifacts_explicit": true,
    "harness_generated_research": false,
    "harness_generated_judgment": false,
    "agent_dispatch": false,
    "hidden_llm_calls": false,
    "network_research": false,
    "external_validation": false,
    "publication_implies_validation": false
  }
}
