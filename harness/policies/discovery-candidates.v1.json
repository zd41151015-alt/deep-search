{
  "schema_version": "startup_opportunity.discovery_candidate_policy.v1",
  "policy_id": "startup_opportunity.g2_2_pre_thesis_candidate_contract",
  "policy_version": "1.0.0",
  "schema_bundle_version": "8.0.0",
  "artifact_contracts": {
    "candidate": "startup_opportunity.discovery_candidate.v1",
    "research_task": "startup_opportunity.research_task.v2",
    "evidence": "startup_opportunity.evidence.v2",
    "claim": "startup_opportunity.claim.v2",
    "finding": "startup_opportunity.finding.v2",
    "insight": "startup_opportunity.insight.v2",
    "judgment": "startup_opportunity.judgment_assessment.v2",
    "source_manifest": "startup_opportunity.source_manifest.v2",
    "lane_result": "startup_opportunity.discovery_lane_result.v1",
    "fan_in": "startup_opportunity.discovery_fan_in.v1",
    "conversion": "startup_opportunity.discovery_candidate_conversion.v1",
    "artifact_envelope": "startup_opportunity.artifact_envelope.v9",
    "document_bundle": "startup_opportunity.document_bundle.v9"
  },
  "candidate_kinds": {
    "demand_seed": {
      "map_schema_version": "startup_opportunity.opportunity_space_map.v1",
      "allowed_fragment_collections": [
        "/initial_demand_hypotheses",
        "/jobs_to_be_done",
        "/workflow_friction_points",
        "/non_consumption"
      ],
      "fragment_id_field": "hypothesis_id",
      "formal_target_schema": "startup_opportunity.demand_thesis.v1"
    },
    "baseline_seed": {
      "map_schema_version": "startup_opportunity.opportunity_space_map.v1",
      "allowed_fragment_collections": ["/baseline_options", "/current_alternatives"],
      "fragment_id_field": "hypothesis_id",
      "formal_target_schema": "startup_opportunity.baseline_option.v1"
    },
    "solution_seed": {
      "map_schema_version": "startup_opportunity.solution_space_map.v1",
      "allowed_fragment_collections": ["/solution_candidates"],
      "fragment_id_field": "candidate_id",
      "formal_target_schema": "startup_opportunity.solution_hypothesis.v1"
    }
  },
  "ownership": {
    "candidate": "main_agent",
    "research_task": "main_agent",
    "lane_material": "lane_researcher",
    "lane_result": "lane_researcher",
    "fan_in": "main_agent",
    "conversion": "main_agent_g2_3_only"
  },
  "revision_contract": {
    "path_pattern": "artifacts/discovery/candidates/<candidate_id>.r<revision>.json",
    "parent_revision": "exactly_previous",
    "parent_hash": "canonical_json_sha256",
    "append_only_ref_fields": [
      "evidence_refs",
      "claim_refs",
      "finding_refs",
      "insight_refs",
      "judgment_assessment_refs",
      "source_manifest_refs",
      "audit_refs"
    ],
    "mutable_enrichment_fields": ["subject", "source_partition", "limitations"],
    "in_place_overwrite": false
  },
  "source_separation_contract": {
    "generation_and_evaluation_distinct_by_default": true,
    "overlap_requires_disclosure": true,
    "source_manifest_required": true,
    "evidence_phase_role_required": true
  },
  "disposition_contract": {
    "values": ["retained", "watchlist", "rejected"],
    "sets_are_exclusive": true,
    "decision_identity_required": true,
    "typed_candidate_target_required": true,
    "diversity_retention_explicit": true
  },
  "fan_in_contract": {
    "reference_only": true,
    "eligible_lane_statuses": ["completed", "partial", "insufficient_evidence"],
    "excluded_lane_statuses": ["failed", "ignored_late", "superseded"],
    "missing_work_is_neutral": false,
    "candidate_revision_upgrade_explicit": true
  },
  "conversion_contract": {
    "owner_slice": "G2.3",
    "path_pattern": "artifacts/discovery/conversions/<candidate_id>.r<revision>.json",
    "parent_revision": "exactly_previous",
    "parent_hash": "canonical_json_sha256",
    "kind_target_map": {
      "demand_seed": "startup_opportunity.demand_thesis.v1",
      "baseline_seed": "startup_opportunity.baseline_option.v1",
      "solution_seed": "startup_opportunity.solution_hypothesis.v1"
    },
    "requires_retained_current_candidate": true,
    "source_candidate_immutable": true,
    "conversion_is_evidence": false,
    "validation_success_claimed": false
  },
  "publication_boundary": {
    "offline_bundle_validation_installed": true,
    "store_v9_adapter_installed": false,
    "current_store_bundle_version": "7.0.0",
    "unsupported_envelope_error": "artifact.envelope_unsupported",
    "v1_v8_adapters_unchanged": true
  },
  "manifest_adapter_boundary": {
    "g2_2_runtime_adapter_installed": false,
    "contract_validation_may_change_manifest": false,
    "status_mapping": {
      "completed": "eligible_reference_only",
      "partial": "eligible_reference_only_with_gap",
      "insufficient_evidence": "eligible_reference_only_with_ceiling",
      "failed": "excluded_reference_only",
      "ignored_late": "excluded_reference_only",
      "superseded": "excluded_reference_only"
    }
  }
}
