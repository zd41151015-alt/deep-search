{
  "schema_version": "startup_opportunity.discovery_candidate_policy.current",
  "policy_id": "startup_opportunity.g2_2_pre_thesis_candidate_contract",
  "policy_version": "1.0.0",
  "artifact_contracts": {
    "candidate": "startup_opportunity.discovery_candidate.v1",
    "research_task": "startup_opportunity.research_task.discovery_candidate.current",
    "evidence": "startup_opportunity.evidence.discovery_candidate.current",
    "claim": "startup_opportunity.claim.discovery_candidate.current",
    "finding": "startup_opportunity.finding.discovery_candidate.current",
    "insight": "startup_opportunity.insight.discovery_candidate.current",
    "judgment": "startup_opportunity.judgment_assessment.discovery_candidate.current",
    "source_manifest": "startup_opportunity.source_manifest.discovery_candidate.current",
    "lane_result": "startup_opportunity.discovery_lane_result.v1",
    "concrete_pre_candidate": "startup_opportunity.concrete_pre_candidate.v1",
    "pre_candidate_relation": "startup_opportunity.pre_candidate_relation.v1",
    "fan_in": "startup_opportunity.discovery_fan_in.v2",
    "artifact_envelope": "startup_opportunity.artifact_envelope.current",
    "document_bundle": "startup_opportunity.document_bundle.current"
  },
  "candidate_kinds": {
    "demand_seed": {
      "map_schema_version": "startup_opportunity.opportunity_space_map.v1",
      "allowed_fragment_collections": [
        "/initial_demand_hypotheses",
        "/jobs_to_be_done",
        "/workflow_friction_points",
        "/non_consumption"
      ],
      "fragment_id_field": "hypothesis_id",
      "formal_target_schema": "startup_opportunity.demand_thesis.v1"
    },
    "baseline_seed": {
      "map_schema_version": "startup_opportunity.opportunity_space_map.v1",
      "allowed_fragment_collections": ["/baseline_options", "/current_alternatives"],
      "fragment_id_field": "hypothesis_id",
      "formal_target_schema": "startup_opportunity.baseline_option.v1"
    },
    "solution_seed": {
      "map_schema_version": "startup_opportunity.solution_space_map.v1",
      "allowed_fragment_collections": ["/solution_candidates"],
      "fragment_id_field": "candidate_id",
      "formal_target_schema": "startup_opportunity.solution_hypothesis.v1"
    }
  },
  "ownership": {
    "candidate": "main_agent",
    "research_task": "main_agent",
    "lane_material": "lane_researcher",
    "lane_result": "lane_researcher",
    "concrete_pre_candidate": "main_agent",
    "pre_candidate_relation": "main_agent",
    "fan_in": "main_agent"
  },
  "revision_contract": {
    "path_pattern": "artifacts/discovery/candidates/<candidate_id>.r<revision>.json",
    "parent_revision": "exactly_previous",
    "parent_hash": "canonical_json_sha256",
    "append_only_ref_fields": [
      "evidence_refs",
      "claim_refs",
      "finding_refs",
      "insight_refs",
      "judgment_assessment_refs",
      "source_manifest_refs",
      "audit_refs"
    ],
    "mutable_enrichment_fields": ["subject", "source_partition", "limitations"],
    "new_material_requires_exact_source_candidate_task_binding": true,
    "new_judgment_subject_must_equal_source_candidate": true,
    "in_place_overwrite": false
  },
  "source_separation_contract": {
    "generation_and_evaluation_distinct_by_default": true,
    "overlap_requires_disclosure": true,
    "source_manifest_required": true,
    "evidence_phase_role_required": true
  },
  "disposition_contract": {
    "values": ["retained", "watchlist", "rejected"],
    "sets_are_exclusive": true,
    "decision_identity_required": true,
    "typed_candidate_target_required": true,
    "judgment_subject_equals_candidate_ref": true,
    "judgment_task_matches_lane_task": true,
    "diversity_retention_explicit": true
  },
  "fan_in_contract": {
    "reference_only": true,
    "eligible_lane_statuses": ["completed", "partial", "insufficient_evidence"],
    "excluded_lane_statuses": ["failed", "ignored_late", "superseded"],
    "missing_work_is_neutral": false,
    "candidate_revision_upgrade_explicit": true,
    "current_concrete_pre_candidate_set_closed": true,
    "materialized_pre_candidate_refs_exact_current_set": true,
    "pre_candidate_disposition_sets_exclusive_and_closed": true,
    "pre_candidate_material_dispositions_exact_typed_closure": true,
    "pre_candidate_relation_explicit_for_split_merge": true,
    "pre_candidate_disposition_hash_binding_required": true,
    "judgment_subject_matches_source_candidate_revision": true,
    "judgment_subject_must_ancestor_final_candidate": true,
    "judgments_must_come_from_supporting_lane_disposition": true,
    "top_level_judgment_refs_exact_disposition_closure": true
  },
  "publication_contract": {
    "envelope_schema_version": "startup_opportunity.artifact_envelope.current",
    "document_bundle_schema_version": "startup_opportunity.document_bundle.current",
    "explicit_artifact_input_only": true,
    "publication_implies_validation": false
  },
  "manifest_projection_contract": {
    "publication_updates_manifest": true,
    "late_or_superseded_can_enter_current_refs": false,
    "status_mapping": {
      "completed": "completed_units",
      "partial": "completed_units",
      "insufficient_evidence": "completed_units",
      "failed": "failed_units",
      "ignored_late": "ignored_late_artifact_refs",
      "superseded": "superseded_units"
    }
  }
}
