{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v5/research-publication-policy.schema.json",
  "title": "Startup Opportunity Research Publication Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "current_schema_bundle_version",
    "adapters",
    "evidence_contract",
    "traceability_contract",
    "task_lifecycle_contract",
    "branch_status_adapter"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.research_publication_policy.v1" },
    "policy_id": { "const": "startup_opportunity.g1_2_research_publication" },
    "policy_version": { "const": "1.0.0" },
    "current_schema_bundle_version": { "const": "4.0.0" },
    "adapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "envelope_version",
          "document_bundle_version",
          "receipt_version",
          "manifest_schema_bundle_version",
          "checkpoint_preferred",
          "blocked_artifact_types"
        ],
        "properties": {
          "envelope_version": {
            "enum": [
              "startup_opportunity.artifact_envelope.v1",
              "startup_opportunity.artifact_envelope.v2",
              "startup_opportunity.artifact_envelope.v3",
              "startup_opportunity.artifact_envelope.v4",
              "startup_opportunity.artifact_envelope.v5"
            ]
          },
          "document_bundle_version": {
            "enum": [
              "startup_opportunity.document_bundle.v1",
              "startup_opportunity.document_bundle.v2",
              "startup_opportunity.document_bundle.v3",
              "startup_opportunity.document_bundle.v4",
              "startup_opportunity.document_bundle.v5"
            ]
          },
          "receipt_version": {
            "enum": [
              "startup_opportunity.artifact_store_operation.v1",
              "startup_opportunity.artifact_store_operation.v2",
              "startup_opportunity.artifact_store_operation.v3",
              "startup_opportunity.artifact_store_operation.v4"
            ]
          },
          "manifest_schema_bundle_version": {
            "anyOf": [{ "enum": ["2.2.0", "3.0.0", "4.0.0"] }, { "type": "null" }]
          },
          "checkpoint_preferred": { "type": "boolean" },
          "blocked_artifact_types": {
            "type": "array",
            "items": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_substrate_record",
        "materialized_substrate_record",
        "business_evidence",
        "stable_identity",
        "raw_dedup_identity",
        "mechanical_fields",
        "agent_attested_fields"
      ],
      "properties": {
        "legacy_substrate_record": { "const": "startup_opportunity.evidence_store_record.v1" },
        "materialized_substrate_record": {
          "const": "startup_opportunity.evidence_store_record.v2"
        },
        "business_evidence": { "const": "startup_opportunity.evidence.v1" },
        "stable_identity": { "const": "canonical_source_content_research_goal_sha256.v2" },
        "raw_dedup_identity": { "const": "content_sha256.v1" },
        "mechanical_fields": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
        "agent_attested_fields": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" }
      }
    },
    "traceability_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "chat_is_artifact", "completion_message_is_artifact"],
      "properties": {
        "direction": { "const": "branch_to_insight_to_finding_to_claim_to_evidence" },
        "chat_is_artifact": { "const": false },
        "completion_message_is_artifact": { "const": false }
      }
    },
    "task_lifecycle_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_publication_transition", "harness_dispatches_agent", "partial_retry"],
      "properties": {
        "task_publication_transition": { "const": "pending_to_active" },
        "harness_dispatches_agent": { "const": false },
        "partial_retry": { "const": "fail_closed" }
      }
    },
    "branch_status_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "partial",
        "insufficient_evidence",
        "failed",
        "cancelled",
        "skipped",
        "ignored_late",
        "superseded_by_scope_change",
        "superseded_by_adaptation"
      ],
      "properties": {
        "completed": { "const": "completed_units" },
        "partial": { "const": "completed_units" },
        "insufficient_evidence": { "const": "completed_units" },
        "failed": { "const": "failed_units" },
        "cancelled": { "const": "cancelled_units_existing" },
        "skipped": { "const": "skipped_units_existing" },
        "ignored_late": { "const": "ignored_late_artifact_refs" },
        "superseded_by_scope_change": { "const": "superseded_units_existing" },
        "superseded_by_adaptation": { "const": "superseded_units_existing" }
      }
    }
  }
}
