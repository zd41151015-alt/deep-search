{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v5/research-task.schema.json",
  "title": "Startup Opportunity Research Task Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "unit_id",
    "mode",
    "phase",
    "wave_id",
    "unit_type",
    "research_goal",
    "commercial_research_requirements",
    "target_subject_ref",
    "scope_frame_ref",
    "research_plan_ref",
    "assessment_plan_ref",
    "input_refs",
    "attempt",
    "supersedes_task_ref",
    "agent_role",
    "allowed_output_path",
    "required_artifact_schema",
    "required_stances",
    "tool_guidance",
    "stop_conditions",
    "completion_message_contract",
    "execution_contract",
    "dispatched_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.research_task.v1"
    },
    "task_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "mode": {
      "const": "concept_evidence_assessment"
    },
    "phase": {
      "const": "assessment"
    },
    "wave_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "unit_type": {
      "$ref": "../v1/definitions.schema.json#/$defs/unitType"
    },
    "research_goal": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "commercial_research_requirements": {
      "$ref": "https://startup-opportunity.local/schemas/current/commercial-research-requirements.schema.json#/$defs/requirements"
    },
    "target_subject_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "scope_frame_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/planRef"
    },
    "assessment_plan_ref": {
      "$ref": "definitions.schema.json#/$defs/assessmentPlanRef"
    },
    "input_refs": {
      "$ref": "definitions.schema.json#/$defs/artifactRefArray"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_task_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/researchTaskRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_role": {
      "const": "lane-researcher"
    },
    "allowed_output_path": {
      "$ref": "../v1/definitions.schema.json#/$defs/artifactPath"
    },
    "required_artifact_schema": {
      "const": "startup_opportunity.concept_evidence_assessment_branch_result.v1"
    },
    "required_stances": {
      "type": "array",
      "items": {
        "enum": ["support", "oppose"]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "support"
          }
        },
        {
          "contains": {
            "const": "oppose"
          }
        }
      ]
    },
    "tool_guidance": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "stop_conditions": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "completion_message_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_artifact_path",
        "include_validation_status",
        "include_limitations",
        "include_unresolved_questions",
        "formal_artifact_authority"
      ],
      "properties": {
        "include_artifact_path": {
          "const": true
        },
        "include_validation_status": {
          "const": true
        },
        "include_limitations": {
          "const": true
        },
        "include_unresolved_questions": {
          "const": true
        },
        "formal_artifact_authority": {
          "const": false
        }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_dispatches_agent", "hidden_llm_calls", "hidden_network_research"],
      "properties": {
        "harness_dispatches_agent": {
          "const": false
        },
        "hidden_llm_calls": {
          "const": false
        },
        "hidden_network_research": {
          "const": false
        }
      }
    },
    "dispatched_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "attempt": {
            "const": 1
          }
        },
        "required": ["attempt"]
      },
      "then": {
        "type": "object",
        "properties": {
          "supersedes_task_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "supersedes_task_ref": {
            "$ref": "definitions.schema.json#/$defs/researchTaskRef"
          }
        }
      }
    }
  ]
}
