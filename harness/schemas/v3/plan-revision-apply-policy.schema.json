{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v3/plan-revision-apply-policy.schema.json",
  "title": "Startup Opportunity Plan Revision Apply Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "base_policy_bindings",
    "operation_identity",
    "new_unit_placement",
    "non_revision_actions",
    "late_artifact_rule",
    "partial_retry"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.plan_revision_apply_policy.v1"
    },
    "policy_id": {
      "const": "startup_opportunity.closed_plan_revision_apply"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "base_policy_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_ref", "schema_version", "policy_version", "content_hash"],
        "properties": {
          "policy_ref": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "$ref": "../v1/definitions.schema.json#/$defs/schemaVersion"
          },
          "policy_version": {
            "const": "1.0.0"
          },
          "content_hash": {
            "$ref": "../v1/definitions.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "operation_identity": {
      "const": "canonical_parent_plan_hash_and_sorted_adaptation_refs.v1"
    },
    "new_unit_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add_unit", "retry_unit", "supersede_unit"],
      "properties": {
        "add_unit": {
          "const": "single_new_followup_wave_after_all_current_leaf_waves"
        },
        "retry_unit": {
          "const": "same_wave_as_target"
        },
        "supersede_unit": {
          "const": "same_wave_as_target"
        }
      }
    },
    "non_revision_actions": {
      "type": "array",
      "prefixItems": [
        {
          "const": "continue_existing_plan"
        },
        {
          "const": "request_clarification"
        },
        {
          "const": "stop_followup"
        },
        {
          "const": "record_runtime_failure"
        },
        {
          "const": "terminate_insufficient_evidence"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "late_artifact_rule": {
      "const": "persist_and_index_only_as_ignored_late"
    },
    "partial_retry": {
      "const": "fail_closed"
    }
  }
}
