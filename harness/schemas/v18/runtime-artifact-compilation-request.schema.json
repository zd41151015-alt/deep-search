{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v18/runtime-artifact-compilation-request.schema.json",
  "title": "Startup Opportunity Runtime Artifact Compilation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "operation", "created_at", "artifacts"],
  "properties": {
    "schema_version": { "const": "startup_opportunity.runtime_artifact_compilation_request.v1" },
    "request_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "operation": { "enum": ["validate_only", "publish"] },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "artifact_path", "producer_role", "document"],
        "properties": {
          "artifact_type": {
            "type": "string",
            "pattern": "^startup_opportunity\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"
          },
          "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
          "producer_role": { "enum": ["main_agent", "lane-researcher", "harness"] },
          "document": { "type": "object" }
        }
      }
    }
  }
}
