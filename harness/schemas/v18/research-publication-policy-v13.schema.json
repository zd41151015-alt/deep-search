{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v18/research-publication-policy-v13.schema.json",
  "title": "Startup Opportunity Declarative Runtime Publication Policy v13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "current_schema_bundle_version",
    "base_policy_binding",
    "adapter",
    "declarative_runtime_contract"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.research_publication_policy.v13" },
    "policy_id": { "const": "startup_opportunity.declarative_runtime_publication" },
    "policy_version": { "const": "13.0.0" },
    "current_schema_bundle_version": { "const": "17.0.0" },
    "base_policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "schema_version", "policy_version", "content_hash"],
      "properties": {
        "policy_ref": { "const": "harness/policies/research-publication.v12.json" },
        "schema_version": { "const": "startup_opportunity.research_publication_policy.v12" },
        "policy_version": { "const": "12.0.0" },
        "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_version",
        "document_bundle_version",
        "receipt_version",
        "manifest_schema_bundle_version",
        "checkpoint_preferred",
        "blocked_artifact_types"
      ],
      "properties": {
        "envelope_version": { "const": "startup_opportunity.artifact_envelope.v18" },
        "document_bundle_version": { "const": "startup_opportunity.document_bundle.v18" },
        "receipt_version": { "const": "startup_opportunity.artifact_store_operation.v16" },
        "manifest_schema_bundle_version": { "const": "17.0.0" },
        "checkpoint_preferred": { "const": true },
        "blocked_artifact_types": { "type": "array", "maxItems": 0 }
      }
    },
    "declarative_runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caller_supplied_research_semantics",
        "harness_compiled_envelopes",
        "minimal_validation_closure",
        "same_wave_batch_descriptor",
        "agent_dispatch_performed",
        "hidden_model_calls",
        "generic_workflow_runtime",
        "network_research",
        "external_validation"
      ],
      "properties": {
        "caller_supplied_research_semantics": { "const": true },
        "harness_compiled_envelopes": { "const": true },
        "minimal_validation_closure": { "const": true },
        "same_wave_batch_descriptor": { "const": true },
        "agent_dispatch_performed": { "const": false },
        "hidden_model_calls": { "const": false },
        "generic_workflow_runtime": { "const": false },
        "network_research": { "const": false },
        "external_validation": { "const": false }
      }
    }
  }
}
