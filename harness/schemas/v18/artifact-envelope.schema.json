{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v18/artifact-envelope.schema.json",
  "title": "Startup Opportunity Declarative Runtime Artifact Envelope v18",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v18" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.research_execution_plan.v1",
        "startup_opportunity.dispatch_batch.v1",
        "startup_opportunity.lane_lifecycle.v1",
        "startup_opportunity.candidate_neutral_evidence.v1",
        "startup_opportunity.discovery_generation_result.v1",
        "startup_opportunity.discovery_stage_readiness.v1",
        "startup_opportunity.source_manifest.v4",
        "startup_opportunity.gap_snapshot.v3",
        "startup_opportunity.adaptation_decision.v2",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["main_agent", "lane-researcher", "harness"] },
    "input_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.candidate_neutral_evidence.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "lane-researcher" },
          "artifact_path": {
            "type": "string",
            "pattern": "^evidence/discovery/generation/.+\\.json$"
          },
          "document": { "$ref": "candidate-neutral-evidence.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.research_execution_plan.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "artifact_path": {
            "type": "string",
            "pattern": "^plans/research-execution\\.r[1-9][0-9]*\\.json$"
          },
          "document": { "$ref": "research-execution-plan.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.dispatch_batch.v1" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "artifact_path": {
            "type": "string",
            "pattern": "^tasks/dispatch/[A-Za-z0-9][A-Za-z0-9._-]*\\.r1\\.json$"
          },
          "document": { "$ref": "dispatch-batch.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.lane_lifecycle.v1" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "artifact_path": {
            "type": "string",
            "pattern": "^artifacts/runtime/lane-lifecycle/.+\\.r[1-9][0-9]*\\.json$"
          },
          "document": { "$ref": "lane-lifecycle.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.discovery_generation_result.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "lane-researcher" },
          "artifact_path": {
            "type": "string",
            "pattern": "^artifacts/discovery/generation/.+\\.json$"
          },
          "document": { "$ref": "discovery-generation-result.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.discovery_stage_readiness.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "artifact_path": {
            "type": "string",
            "pattern": "^artifacts/discovery/readiness/.+\\.r[1-9][0-9]*\\.json$"
          },
          "document": { "$ref": "discovery-stage-readiness.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.source_manifest.v4" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "lane-researcher" },
          "artifact_path": {
            "type": "string",
            "pattern": "^evidence/source-manifests/discovery/.+\\.json$"
          },
          "document": { "$ref": "source-manifest-v4.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.gap_snapshot.v3" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "artifact_path": { "type": "string", "pattern": "^adaptations/gap-snapshots/.+\\.json$" },
          "document": { "$ref": "gap-snapshot-v3.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.adaptation_decision.v2" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "artifact_path": { "type": "string", "pattern": "^adaptations/decisions/.+\\.json$" },
          "document": { "$ref": "../v2/adaptation-decision.schema.json" }
        }
      }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "startup_opportunity.checkpoint.v1" } } },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v1/checkpoint.schema.json" }
        }
      }
    }
  ]
}
