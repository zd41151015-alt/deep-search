{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v14/artifact-envelope.schema.json",
  "title": "Startup Opportunity G3.1 Artifact Envelope v14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v14" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.capability_evidence.v1",
        "startup_opportunity.ai_capability_benchmark.v1",
        "startup_opportunity.ai_evaluation_reliability.v1",
        "startup_opportunity.ai_data_dependency.v1",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["lane_researcher", "harness"] },
    "input_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "startup_opportunity.capability_evidence.v1",
              "startup_opportunity.ai_capability_benchmark.v1",
              "startup_opportunity.ai_evaluation_reliability.v1",
              "startup_opportunity.ai_data_dependency.v1"
            ]
          }
        }
      },
      "then": { "properties": { "producer_role": { "const": "lane_researcher" } } }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.capability_evidence.v1" } }
      },
      "then": { "properties": { "document": { "$ref": "capability-evidence.schema.json" } } }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.ai_capability_benchmark.v1" }
        }
      },
      "then": { "properties": { "document": { "$ref": "ai-capability-benchmark.schema.json" } } }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.ai_evaluation_reliability.v1" }
        }
      },
      "then": { "properties": { "document": { "$ref": "ai-evaluation-reliability.schema.json" } } }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.ai_data_dependency.v1" } }
      },
      "then": { "properties": { "document": { "$ref": "ai-data-dependency.schema.json" } } }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "startup_opportunity.checkpoint.v1" } } },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v1/checkpoint.schema.json" }
        }
      }
    }
  ]
}
