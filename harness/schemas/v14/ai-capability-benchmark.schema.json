{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v14/ai-capability-benchmark.schema.json",
  "title": "Startup Opportunity AI Capability Benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "lineage",
    "research_mode",
    "evaluation_design",
    "baseline_results",
    "product_candidate_result",
    "representativeness",
    "freshness",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.ai_capability_benchmark.v1" },
    "benchmark_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "lineage": { "$ref": "ai-contract-definitions.schema.json#/$defs/lineage" },
    "research_mode": { "$ref": "ai-contract-definitions.schema.json#/$defs/researchMode" },
    "evaluation_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_tasks", "quality_measures", "latency_measure", "cost_measure"],
      "properties": {
        "target_tasks": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "quality_measures": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "latency_measure": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "cost_measure": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" }
      }
    },
    "baseline_results": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/genericModelBaseline" },
        { "$ref": "#/$defs/platformNativeBaseline" },
        { "$ref": "#/$defs/openSourceBaseline" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "product_candidate_result": { "$ref": "#/$defs/productCandidate" },
    "representativeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "covered_user_states", "known_gaps"],
      "properties": {
        "status": { "enum": ["representative", "limited", "not_established"] },
        "covered_user_states": {
          "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "known_gaps": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
      }
    },
    "freshness": { "$ref": "ai-contract-definitions.schema.json#/$defs/freshness" },
    "source_boundary": { "$ref": "ai-contract-definitions.schema.json#/$defs/sourceBoundary" },
    "limitations": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach_summary",
        "quality_boundary",
        "latency_boundary",
        "cost_boundary",
        "failure_modes",
        "evidence_refs",
        "judgment_assessment_refs"
      ],
      "properties": {
        "baseline_type": { "enum": ["generic_model", "platform_native", "open_source"] },
        "result_type": { "const": "product_candidate" },
        "incremental_value_status": {
          "enum": ["demonstrated", "partial", "not_demonstrated", "unknown"]
        },
        "approach_summary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "quality_boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "latency_boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "cost_boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "failure_modes": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "evidence_refs": { "$ref": "ai-contract-definitions.schema.json#/$defs/evidenceRefs" },
        "judgment_assessment_refs": {
          "$ref": "ai-contract-definitions.schema.json#/$defs/assessmentRefs"
        }
      }
    },
    "genericModelBaseline": {
      "allOf": [
        { "$ref": "#/$defs/result" },
        {
          "type": "object",
          "required": ["baseline_type"],
          "properties": { "baseline_type": { "const": "generic_model" } }
        }
      ]
    },
    "platformNativeBaseline": {
      "allOf": [
        { "$ref": "#/$defs/result" },
        {
          "type": "object",
          "required": ["baseline_type"],
          "properties": { "baseline_type": { "const": "platform_native" } }
        }
      ]
    },
    "openSourceBaseline": {
      "allOf": [
        { "$ref": "#/$defs/result" },
        {
          "type": "object",
          "required": ["baseline_type"],
          "properties": { "baseline_type": { "const": "open_source" } }
        }
      ]
    },
    "productCandidate": {
      "allOf": [
        { "$ref": "#/$defs/result" },
        {
          "type": "object",
          "required": ["result_type", "incremental_value_status"],
          "properties": {
            "result_type": { "const": "product_candidate" },
            "incremental_value_status": {
              "enum": ["demonstrated", "partial", "not_demonstrated", "unknown"]
            }
          }
        }
      ]
    }
  }
}
