{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v15/ai-inference-unit-economics.schema.json",
  "title": "Startup Opportunity AI Inference Unit Economics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "economics_id",
    "run_id",
    "lineage",
    "research_mode",
    "capability_evidence_ref",
    "benchmark_ref",
    "scope_boundary",
    "volume_scenarios",
    "unit_cost_model",
    "latency_and_deployment",
    "product_economics",
    "kill_boundary",
    "conclusion_ceiling",
    "ceiling_reasons",
    "evidence_refs",
    "judgment_assessment_refs",
    "freshness",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.ai_inference_unit_economics.v1"
    },
    "economics_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/runId"
    },
    "lineage": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/lineage"
    },
    "research_mode": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/researchMode"
    },
    "capability_evidence_ref": {
      "$ref": "../v12/definitions.schema.json#/$defs/artifactRef"
    },
    "benchmark_ref": {
      "$ref": "../v12/definitions.schema.json#/$defs/artifactRef"
    },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_scope",
        "harness_execution_cost_included",
        "agent_execution_cost_included"
      ],
      "properties": {
        "cost_scope": {
          "const": "product_inference_only"
        },
        "harness_execution_cost_included": {
          "const": false
        },
        "agent_execution_cost_included": {
          "const": false
        }
      }
    },
    "volume_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "monthly_product_units", "peak_concurrency", "assumption"],
        "properties": {
          "scenario_id": {
            "$ref": "../v12/definitions.schema.json#/$defs/identifier"
          },
          "monthly_product_units": {
            "type": "integer",
            "minimum": 0
          },
          "peak_concurrency": {
            "type": "integer",
            "minimum": 0
          },
          "assumption": {
            "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "unit_cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "estimate_status",
        "provider_cost_per_unit",
        "infrastructure_cost_per_unit",
        "human_review_cost_per_unit",
        "total_cost_per_unit",
        "measurement_basis"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimate_status": {
          "enum": ["measured", "bounded_estimate", "desk_estimate", "unknown"]
        },
        "provider_cost_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "infrastructure_cost_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "human_review_cost_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "total_cost_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "measurement_basis": {
          "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "latency_and_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p95_latency_ms",
        "latency_status",
        "deployment_modes",
        "deployment_constraints"
      ],
      "properties": {
        "p95_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "latency_status": {
          "enum": ["within_boundary", "marginal", "outside_boundary", "unknown"]
        },
        "deployment_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["provider_cloud", "private_cloud", "on_device", "self_hosted_open_source"]
          }
        },
        "deployment_constraints": {
          "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "product_economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revenue_basis", "gross_margin_status", "sensitivity_drivers", "service_burden"],
      "properties": {
        "revenue_basis": {
          "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
        },
        "gross_margin_status": {
          "enum": ["viable", "marginal", "unviable", "unknown"]
        },
        "sensitivity_drivers": {
          "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "service_burden": {
          "enum": ["low", "medium", "high", "unknown"]
        }
      }
    },
    "kill_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conditions"],
      "properties": {
        "status": {
          "enum": ["not_triggered", "triggered", "unknown"]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "conclusion_ceiling": {
      "enum": ["prioritize_allowed", "investigate_further_only", "insufficient_evidence", "reject"]
    },
    "ceiling_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
      }
    },
    "evidence_refs": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/evidenceRefs"
    },
    "judgment_assessment_refs": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/assessmentRefs"
    },
    "freshness": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/freshness"
    },
    "source_boundary": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/sourceBoundary"
    },
    "limitations": {
      "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
