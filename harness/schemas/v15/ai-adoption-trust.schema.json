{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v15/ai-adoption-trust.schema.json",
  "title": "Startup Opportunity AI Adoption and Trust v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_id",
    "run_id",
    "lineage",
    "research_mode",
    "capability_evidence_ref",
    "reliability_ref",
    "data_dependency_ref",
    "adoption_friction",
    "consumer_trust",
    "explainability",
    "accountability",
    "safety_and_privacy",
    "regulated_ai_boundary",
    "workflow_entry_status",
    "conclusion_ceiling",
    "ceiling_reasons",
    "evidence_refs",
    "judgment_assessment_refs",
    "freshness",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.ai_adoption_trust.v1" },
    "trust_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "lineage": { "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/lineage" },
    "research_mode": { "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/researchMode" },
    "capability_evidence_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
    "reliability_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
    "data_dependency_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
    "adoption_friction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "drivers", "mitigations"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "unknown"] },
        "drivers": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "mitigations": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
      }
    },
    "consumer_trust": { "$ref": "#/$defs/trustBoundary" },
    "explainability": { "$ref": "#/$defs/trustBoundary" },
    "accountability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "escalation_boundary"],
      "properties": {
        "status": { "enum": ["assigned", "partial", "unassigned", "unknown"] },
        "owner": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
        "escalation_boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" }
      }
    },
    "safety_and_privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "controls_status", "residual_risks"],
      "properties": {
        "risk_level": { "enum": ["low", "medium", "high", "regulated", "unknown"] },
        "controls_status": { "enum": ["adequate", "partial", "inadequate", "unknown"] },
        "residual_risks": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
      }
    },
    "regulated_ai_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "jurisdictions",
        "obligations",
        "human_oversight_required",
        "boundary"
      ],
      "properties": {
        "applicability": { "enum": ["regulated", "not_regulated", "unclear"] },
        "jurisdictions": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "obligations": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" },
        "human_oversight_required": { "type": "boolean" },
        "boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" }
      }
    },
    "workflow_entry_status": { "enum": ["allowed", "conditional", "blocked", "unknown"] },
    "conclusion_ceiling": {
      "enum": ["prioritize_allowed", "investigate_further_only", "insufficient_evidence", "reject"]
    },
    "ceiling_reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" }
    },
    "evidence_refs": { "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/evidenceRefs" },
    "judgment_assessment_refs": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/assessmentRefs"
    },
    "freshness": { "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/freshness" },
    "source_boundary": {
      "$ref": "../v14/ai-contract-definitions.schema.json#/$defs/sourceBoundary"
    },
    "limitations": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
  },
  "$defs": {
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "boundary"],
      "properties": {
        "status": { "enum": ["acceptable", "conditional", "unacceptable", "unknown"] },
        "boundary": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" }
      }
    }
  }
}
