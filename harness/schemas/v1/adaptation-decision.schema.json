{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v1/adaptation-decision.schema.json",
  "title": "Startup Opportunity Adaptation Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adaptation_id",
    "run_id",
    "based_on_plan_ref",
    "trigger_gap_refs",
    "action",
    "reason",
    "expected_decision_impact",
    "requested_by",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.adaptation_decision.v1" },
    "adaptation_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "based_on_plan_ref": { "$ref": "definitions.schema.json#/$defs/planRef" },
    "trigger_gap_refs": {
      "type": "array",
      "items": { "$ref": "definitions.schema.json#/$defs/gapRef" },
      "minItems": 1,
      "uniqueItems": true
    },
    "action": {
      "enum": [
        "add_unit",
        "cancel_unit",
        "skip_unit",
        "reprioritize_unit",
        "retry_unit",
        "supersede_unit",
        "continue_existing_plan",
        "request_clarification",
        "stop_followup",
        "terminate_insufficient_evidence"
      ]
    },
    "target_unit": { "$ref": "definitions.schema.json#/$defs/researchUnit" },
    "target_unit_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "priority_band": { "enum": ["low", "normal", "high", "blocking"] },
    "clarification_question": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "reason": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "expected_decision_impact": {
      "$ref": "definitions.schema.json#/$defs/decisionImpactArray"
    },
    "success_condition": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "stop_condition": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "requested_by": { "enum": ["main_agent", "user"] },
    "user_decision_ref": { "$ref": "definitions.schema.json#/$defs/decisionRef" },
    "created_at": { "$ref": "definitions.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": { "action": { "const": "add_unit" } },
          "required": ["target_unit", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit_ref"] },
              { "required": ["priority_band"] },
              { "required": ["clarification_question"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": { "action": { "enum": ["cancel_unit", "skip_unit"] } },
          "required": ["target_unit_ref", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit"] },
              { "required": ["priority_band"] },
              { "required": ["clarification_question"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": { "action": { "const": "reprioritize_unit" } },
          "required": ["target_unit_ref", "priority_band", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit"] },
              { "required": ["clarification_question"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": { "action": { "enum": ["retry_unit", "supersede_unit"] } },
          "required": ["target_unit_ref", "target_unit", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["priority_band"] },
              { "required": ["clarification_question"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": { "action": { "const": "continue_existing_plan" } },
          "required": ["target_unit_ref", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit"] },
              { "required": ["priority_band"] },
              { "required": ["clarification_question"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": { "action": { "const": "request_clarification" } },
          "required": ["clarification_question", "success_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit"] },
              { "required": ["target_unit_ref"] },
              { "required": ["priority_band"] },
              { "required": ["stop_condition"] }
            ]
          }
        },
        {
          "properties": {
            "action": { "enum": ["stop_followup", "terminate_insufficient_evidence"] }
          },
          "required": ["stop_condition"],
          "not": {
            "anyOf": [
              { "required": ["target_unit"] },
              { "required": ["target_unit_ref"] },
              { "required": ["priority_band"] },
              { "required": ["clarification_question"] },
              { "required": ["success_condition"] }
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": { "requested_by": { "const": "user" } },
        "required": ["requested_by"]
      },
      "then": { "required": ["user_decision_ref"] },
      "else": { "not": { "required": ["user_decision_ref"] } }
    }
  ]
}
