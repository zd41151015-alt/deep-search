{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v1/artifact-envelope.schema.json",
  "title": "Startup Opportunity Formal Artifact Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v1" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.run_manifest.v1",
        "startup_opportunity.research_plan.v1",
        "startup_opportunity.gap_snapshot.v1",
        "startup_opportunity.adaptation_decision.v1",
        "startup_opportunity.event.v1",
        "startup_opportunity.decision.v1",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "$ref": "definitions.schema.json#/$defs/producerRole" },
    "input_refs": { "$ref": "definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.run_manifest.v1" },
        "document": { "$ref": "run-manifest.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.research_plan.v1" },
        "document": { "$ref": "research-plan.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.gap_snapshot.v1" },
        "document": { "$ref": "gap-snapshot.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.adaptation_decision.v1" },
        "document": { "$ref": "adaptation-decision.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.event.v1" },
        "document": { "$ref": "event.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.decision.v1" },
        "document": { "$ref": "decision.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "document": { "$ref": "checkpoint.schema.json" }
      }
    }
  ]
}
