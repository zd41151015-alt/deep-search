{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v1/run-manifest.schema.json",
  "title": "Startup Opportunity Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "status",
    "status_before_clarification",
    "parent_run_id",
    "created_at",
    "updated_at",
    "current_phase",
    "current_plan_ref",
    "plan_revision",
    "followup_round",
    "latest_gap_snapshot_ref",
    "pending_adaptation_refs",
    "validated_adaptation_refs",
    "rejected_adaptation_refs",
    "applied_adaptation_refs",
    "completed_units",
    "active_units",
    "failed_units",
    "invalidated_units",
    "skipped_units",
    "cancelled_units",
    "superseded_units",
    "ignored_late_artifact_refs",
    "artifact_refs",
    "checkpoint_ref",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.run_manifest.v1"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "$ref": "definitions.schema.json#/$defs/mode"
    },
    "status": {
      "enum": [
        "created",
        "decision_framed",
        "scoped",
        "planned",
        "researching",
        "synthesizing",
        "reviewing",
        "reporting",
        "completed",
        "paused",
        "failed",
        "insufficient_evidence",
        "cancelled",
        "needs_clarification"
      ]
    },
    "status_before_clarification": {
      "anyOf": [
        {
          "enum": [
            "created",
            "decision_framed",
            "scoped",
            "planned",
            "researching",
            "synthesizing",
            "reviewing"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_run_id": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/runId"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    },
    "current_phase": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_plan_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/planRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "followup_round": {
      "type": "integer",
      "minimum": 0
    },
    "latest_gap_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/gapSnapshotRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_adaptation_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/adaptationRef"
      },
      "uniqueItems": true
    },
    "validated_adaptation_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/adaptationRef"
      },
      "uniqueItems": true
    },
    "rejected_adaptation_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/adaptationRef"
      },
      "uniqueItems": true
    },
    "applied_adaptation_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/adaptationRef"
      },
      "uniqueItems": true
    },
    "completed_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "active_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "failed_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "invalidated_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "skipped_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "cancelled_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "superseded_units": {
      "$ref": "definitions.schema.json#/$defs/identifierArray"
    },
    "ignored_late_artifact_refs": {
      "$ref": "definitions.schema.json#/$defs/artifactRefArray"
    },
    "artifact_refs": {
      "$ref": "definitions.schema.json#/$defs/artifactRefArray"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/checkpointRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/stringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "current_plan_ref": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "plan_revision": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "plan_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "status_before_clarification": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "else": {
        "properties": {
          "status_before_clarification": {
            "type": "null"
          }
        }
      }
    }
  ]
}
