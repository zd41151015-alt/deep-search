{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v7/artifact-envelope.schema.json",
  "title": "Startup Opportunity G1.4 Artifact Envelope v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v7" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.checkpoint.v1",
        "startup_opportunity.evidence_audit.v1",
        "startup_opportunity.adversarial_review.v1",
        "startup_opportunity.concept_evidence_assessment.v2",
        "startup_opportunity.traceability.v1",
        "startup_opportunity.concept_evidence_report.v1",
        "startup_opportunity.decision_brief.v1",
        "startup_opportunity.concept_evidence_report_view.v1",
        "startup_opportunity.report_consistency_evaluation.v1"
      ]
    },
    "artifact_path": { "$ref": "definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "definitions.schema.json#/$defs/timestamp" },
    "producer_role": {
      "enum": ["main_agent", "harness", "evidence_auditor", "adversarial_reviewer"]
    },
    "input_refs": { "$ref": "definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.evidence_audit.v1" },
        "producer_role": { "const": "evidence_auditor" },
        "document": { "$ref": "evidence-audit.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.adversarial_review.v1" },
        "producer_role": { "const": "adversarial_reviewer" },
        "document": { "$ref": "adversarial-review.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.concept_evidence_assessment.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "concept-evidence-assessment-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.traceability.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "traceability.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.concept_evidence_report.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "concept-evidence-report.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.decision_brief.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "decision-brief.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.concept_evidence_report_view.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "concept-evidence-report-view.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.report_consistency_evaluation.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "report-consistency-evaluation.schema.json" }
      }
    }
  ]
}
