{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v7/traceability.schema.json",
  "title": "Startup Opportunity Traceability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "traceability_id",
    "run_id",
    "producer_role",
    "owned_output_path",
    "lineage",
    "input_artifact_hashes",
    "assessment_ref",
    "hypothesis_evidence_matrix_ref",
    "business_engine_ref",
    "evidence_audit_ref",
    "adversarial_review_ref",
    "chains",
    "coverage",
    "evaluator_result",
    "evaluation_issues",
    "valid_as_of",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.traceability.v1" },
    "traceability_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "producer_role": { "const": "harness" },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/traceability/[A-Za-z0-9._-]+\\.json$"
    },
    "lineage": { "$ref": "definitions.schema.json#/$defs/lineage" },
    "input_artifact_hashes": { "$ref": "definitions.schema.json#/$defs/inputHashes" },
    "assessment_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "hypothesis_evidence_matrix_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "business_engine_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "evidence_audit_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "adversarial_review_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "report_statement_id",
          "decision_brief_section",
          "assessment_ref",
          "matrix_dimension_ref",
          "judgment_assessment_ref",
          "concept_subject_ref",
          "insight_ref",
          "finding_ref",
          "claim_ref",
          "evidence_ref",
          "stance"
        ],
        "properties": {
          "chain_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
          "report_statement_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
          "decision_brief_section": {
            "enum": [
              "current_recommendation",
              "decisive_support",
              "decisive_opposition",
              "alternatives_not_selected",
              "critical_unknowns",
              "what_would_change",
              "belief_update",
              "limitations"
            ]
          },
          "assessment_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "matrix_dimension_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "judgment_assessment_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "concept_subject_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "insight_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "finding_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "claim_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "evidence_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
          "stance": { "enum": ["support", "oppose"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisive_statement_count",
        "traced_decisive_statement_count",
        "untraced_statement_ids",
        "result"
      ],
      "properties": {
        "decisive_statement_count": { "type": "integer", "minimum": 1 },
        "traced_decisive_statement_count": { "type": "integer", "minimum": 0 },
        "untraced_statement_ids": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
        "result": { "enum": ["complete", "incomplete"] }
      }
    },
    "evaluator_result": { "$ref": "definitions.schema.json#/$defs/evaluatorResult" },
    "evaluation_issues": {
      "type": "array",
      "items": { "$ref": "definitions.schema.json#/$defs/evaluationIssue" },
      "uniqueItems": true
    },
    "valid_as_of": { "type": "string", "format": "date" },
    "limitations": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" }
  }
}
