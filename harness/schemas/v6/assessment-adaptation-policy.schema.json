{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v6/assessment-adaptation-policy.schema.json",
  "title": "Startup Opportunity Assessment Adaptation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "compatible_schema_bundle_versions",
    "contract_versions",
    "allowed_actions",
    "coverage_key_algorithm",
    "plan_revision_operation_identity",
    "add_unit_rules",
    "stop_followup_rules",
    "publication_contract"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.assessment_adaptation_policy.v1" },
    "policy_id": { "const": "startup_opportunity.g1_3_dynamic_buyer_gap" },
    "policy_version": { "const": "1.0.0" },
    "compatible_schema_bundle_versions": {
      "type": "array",
      "prefixItems": [{ "const": "5.0.0" }],
      "minItems": 1,
      "maxItems": 1,
      "items": false
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_snapshot", "adaptation_decision", "research_plan", "assessment_plan"],
      "properties": {
        "gap_snapshot": { "const": "startup_opportunity.gap_snapshot.v2" },
        "adaptation_decision": { "const": "startup_opportunity.adaptation_decision.v3" },
        "research_plan": { "const": "startup_opportunity.research_plan.v1" },
        "assessment_plan": {
          "const": "startup_opportunity.concept_evidence_assessment_plan.v1"
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "prefixItems": [{ "const": "add_unit" }, { "const": "stop_followup" }],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "coverage_key_algorithm": { "const": "canonical_assessment_coverage_identity_sha256.v1" },
    "plan_revision_operation_identity": {
      "const": "canonical_parent_plan_hash_and_sorted_adaptation_refs.v1"
    },
    "add_unit_rules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_type", "dimension_id", "unit_type"],
        "properties": {
          "gap_type": {
            "enum": ["buyer_evidence_insufficient", "acquisition_evidence_insufficient"]
          },
          "dimension_id": {
            "enum": ["buyer_language_and_willingness_to_pay", "acquisition_and_distribution"]
          },
          "unit_type": { "enum": ["buyer_language", "acquisition"] }
        }
      }
    },
    "stop_followup_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_types", "stop_signals", "creates_plan_revision"],
      "properties": {
        "gap_types": {
          "type": "array",
          "prefixItems": [
            { "const": "coverage_sufficient" },
            { "const": "no_material_new_evidence" },
            { "const": "no_executable_followup" }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "stop_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "coverage_sufficient",
              "no_material_new_evidence",
              "no_executable_followup",
              "source_repetition",
              "max_followup_rounds_reached",
              "limitation_accepted"
            ]
          },
          "uniqueItems": true
        },
        "creates_plan_revision": { "const": false }
      }
    },
    "publication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "atomic", "validated_receipt_recovery", "cas_required"],
      "properties": {
        "immutable": { "const": true },
        "atomic": { "const": true },
        "validated_receipt_recovery": { "const": true },
        "cas_required": { "const": true }
      }
    }
  }
}
