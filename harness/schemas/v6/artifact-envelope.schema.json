{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v6/artifact-envelope.schema.json",
  "title": "Startup Opportunity Assessment Adaptation Envelope v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v6" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.research_plan.v1",
        "startup_opportunity.gap_snapshot.v2",
        "startup_opportunity.adaptation_decision.v3",
        "startup_opportunity.checkpoint.v1",
        "startup_opportunity.planning_context.v2",
        "startup_opportunity.ai_trigger_source_attestation.v1",
        "startup_opportunity.concept_evidence_assessment_plan.v1"
      ]
    },
    "artifact_path": { "$ref": "../v1/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v1/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v1/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "$ref": "../v1/definitions.schema.json#/$defs/producerRole" },
    "input_refs": { "$ref": "../v1/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v1/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.research_plan.v1" },
        "document": { "$ref": "../v1/research-plan.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.gap_snapshot.v2" },
        "document": { "$ref": "gap-snapshot-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.adaptation_decision.v3" },
        "document": { "$ref": "adaptation-decision-v3.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.planning_context.v2" },
        "document": { "$ref": "../v2/planning-context-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.ai_trigger_source_attestation.v1" },
        "document": { "$ref": "../v2/ai-trigger-source-attestation.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": {
          "const": "startup_opportunity.concept_evidence_assessment_plan.v1"
        },
        "document": { "$ref": "../v4/concept-evidence-assessment-plan.schema.json" }
      }
    }
  ]
}
