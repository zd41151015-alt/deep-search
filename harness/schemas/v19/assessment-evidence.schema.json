{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v19/assessment-evidence.schema.json",
  "title": "Startup Opportunity Assessment Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "unit_id",
    "dispatch_batch_ref",
    "concept_hypothesis_ref",
    "research_plan_ref",
    "execution_plan_ref",
    "source_type",
    "source_name",
    "research_goal",
    "source_group_id",
    "mechanical_binding",
    "provenance",
    "source_assessment",
    "evidence_tier",
    "evidence_lifecycle_status",
    "evidence_role",
    "representativeness",
    "valid_as_of",
    "freshness_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.assessment_evidence.v1"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[a-f0-9]{64}$"
    },
    "run_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/identifier"
    },
    "dispatch_batch_ref": {
      "type": "string",
      "pattern": "^tasks/dispatch/[A-Za-z0-9][A-Za-z0-9._-]*\\.r1\\.json#[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "concept_hypothesis_ref": {
      "$ref": "../v12/definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/planRef"
    },
    "execution_plan_ref": {
      "type": "string",
      "pattern": "^plans/research-execution\\.r[1-9][0-9]*\\.json$"
    },
    "source_type": {
      "enum": [
        "web_page",
        "public_dataset",
        "public_report",
        "user_document",
        "user_existing_record"
      ]
    },
    "source_name": {
      "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
    },
    "research_goal": {
      "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
    },
    "source_group_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/identifier"
    },
    "mechanical_binding": {
      "$ref": "../v9/evidence-v2.schema.json#/properties/mechanical_binding"
    },
    "provenance": {
      "$ref": "../v9/evidence-v2.schema.json#/properties/provenance"
    },
    "source_assessment": {
      "$ref": "../v9/evidence-v2.schema.json#/properties/source_assessment"
    },
    "evidence_tier": {
      "$ref": "../v4/definitions.schema.json#/$defs/evidenceTier"
    },
    "evidence_lifecycle_status": {
      "enum": ["active", "superseded", "stale", "unverified"]
    },
    "evidence_role": {
      "enum": ["support", "oppose", "context"]
    },
    "representativeness": {
      "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "freshness_policy": {
      "enum": [
        "revalidate_on_product_or_market_change",
        "revalidate_on_price_or_policy_change",
        "revalidate_on_source_update",
        "immutable_historical_record"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString"
      }
    }
  }
}
