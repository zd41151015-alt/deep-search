{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v19/assessment-stage-gate.schema.json",
  "title": "Startup Opportunity Assessment Stage Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "run_id",
    "execution_plan_ref",
    "concept_hypothesis_ref",
    "stage_id",
    "gate_kind",
    "evaluated_lane_refs",
    "dimension_decisions",
    "outcome",
    "thesis_killing_opposition",
    "completed_stage_ids",
    "not_started_unit_ids",
    "allowed_next_actions",
    "basis_refs",
    "rationale",
    "created_at",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.assessment_stage_gate.v1" },
    "gate_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "execution_plan_ref": {
      "type": "string",
      "pattern": "^plans/research-execution\\.r[1-9][0-9]*\\.json$"
    },
    "concept_hypothesis_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
    "stage_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "gate_kind": { "enum": ["early_kill", "commercial", "delivery", "followup"] },
    "evaluated_lane_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "dimension_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "lane_result_ref",
          "decision",
          "decision_sufficiency",
          "decisive_refs"
        ],
        "properties": {
          "dimension_id": {
            "$ref": "../v4/definitions.schema.json#/$defs/assessmentDimension"
          },
          "lane_result_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
          "decision": {
            "enum": ["supports", "mixed", "opposes", "insufficient_evidence", "not_applicable"]
          },
          "decision_sufficiency": {
            "enum": ["sufficient", "insufficient", "blocked", "not_applicable"]
          },
          "decisive_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" }
        }
      }
    },
    "outcome": {
      "enum": ["continue", "deprioritize", "insufficient_evidence", "runtime_blocked"]
    },
    "thesis_killing_opposition": { "type": "boolean" },
    "completed_stage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" }
    },
    "not_started_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" }
    },
    "allowed_next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "continue_next_stage",
          "add_bounded_followup",
          "stop_followup",
          "terminate_deprioritized",
          "terminate_insufficient_evidence",
          "record_runtime_failure"
        ]
      }
    },
    "basis_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "rationale": { "$ref": "../v12/definitions.schema.json#/$defs/nonEmptyString" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "limitations": { "$ref": "../v12/definitions.schema.json#/$defs/uniqueStringArray" }
  }
}
