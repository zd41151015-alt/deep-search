{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v9/claim-v2.schema.json",
  "title": "Startup Opportunity Discovery Claim v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "run_id",
    "unit_id",
    "lineage",
    "claim_type",
    "statement",
    "stance",
    "evidence_refs",
    "confidence_band",
    "sample_bias",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.claim.v2"
    },
    "claim_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "definitions.schema.json#/$defs/discoveryLineage"
    },
    "claim_type": {
      "enum": [
        "pain_point",
        "behavior_signal",
        "alternative",
        "solution_failure",
        "buyer_signal",
        "migration_signal",
        "competitor_signal",
        "feasibility_signal",
        "counter_evidence",
        "source_limitation"
      ]
    },
    "statement": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "stance": {
      "enum": ["support", "oppose"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/evidenceRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence_band": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "sample_bias": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
