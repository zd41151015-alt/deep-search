{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v9/discovery-candidate.schema.json",
  "title": "Startup Opportunity Pre-thesis Discovery Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "revision",
    "parent_candidate_ref",
    "parent_content_hash",
    "run_id",
    "mode",
    "phase",
    "owner_slice",
    "discovery_profile",
    "market",
    "language",
    "scope_frame_ref",
    "research_plan_ref",
    "map_lineage",
    "subject",
    "evidence_lineage",
    "source_partition",
    "enrichment",
    "pre_thesis_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_candidate.v1"
    },
    "candidate_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "candidate_kind": {
      "$ref": "definitions.schema.json#/$defs/candidateKind"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_candidate_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/candidateRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "const": "opportunity_discovery"
    },
    "phase": {
      "const": "discovery"
    },
    "owner_slice": {
      "const": "G2.2"
    },
    "discovery_profile": {
      "$ref": "definitions.schema.json#/$defs/discoveryProfile"
    },
    "market": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "language": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "scope_frame_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/planRef"
    },
    "map_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_map_ref",
        "source_map_schema_version",
        "source_map_id",
        "source_map_revision",
        "source_map_content_hash",
        "fragment_ref",
        "fragment_pointer",
        "fragment_id",
        "fragment_content_hash",
        "fragment_status"
      ],
      "properties": {
        "source_map_ref": {
          "$ref": "definitions.schema.json#/$defs/artifactRef"
        },
        "source_map_schema_version": {
          "enum": [
            "startup_opportunity.opportunity_space_map.v1",
            "startup_opportunity.solution_space_map.v1"
          ]
        },
        "source_map_id": {
          "$ref": "definitions.schema.json#/$defs/identifier"
        },
        "source_map_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_map_content_hash": {
          "$ref": "definitions.schema.json#/$defs/sha256"
        },
        "fragment_ref": {
          "$ref": "definitions.schema.json#/$defs/artifactRef"
        },
        "fragment_pointer": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_-]+/[0-9]+$"
        },
        "fragment_id": {
          "$ref": "definitions.schema.json#/$defs/identifier"
        },
        "fragment_content_hash": {
          "$ref": "definitions.schema.json#/$defs/sha256"
        },
        "fragment_status": {
          "enum": ["unvalidated_question", "unvalidated_hypothesis", "unvalidated_option"]
        }
      }
    },
    "subject": {
      "type": "object"
    },
    "evidence_lineage": {
      "$ref": "definitions.schema.json#/$defs/candidateEvidenceRefs"
    },
    "source_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_source_manifest_refs",
        "evaluation_source_manifest_refs",
        "overlap_source_group_ids",
        "overlap_assessment"
      ],
      "properties": {
        "generation_source_manifest_refs": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/sourceManifestRef"
          },
          "uniqueItems": true
        },
        "evaluation_source_manifest_refs": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/sourceManifestRef"
          },
          "uniqueItems": true
        },
        "overlap_source_group_ids": {
          "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
        },
        "overlap_assessment": {
          "enum": ["none", "disclosed_low", "disclosed_high", "unknown"]
        }
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_kind", "changed_fields", "basis_refs"],
      "properties": {
        "revision_kind": {
          "enum": ["initial_materialization", "evidence_enrichment", "user_correction"]
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "enum": [
              "subject",
              "evidence_lineage.evidence_refs",
              "evidence_lineage.claim_refs",
              "evidence_lineage.finding_refs",
              "evidence_lineage.insight_refs",
              "evidence_lineage.judgment_assessment_refs",
              "evidence_lineage.source_manifest_refs",
              "evidence_lineage.audit_refs",
              "source_partition",
              "limitations"
            ]
          },
          "uniqueItems": true
        },
        "basis_refs": {
          "$ref": "definitions.schema.json#/$defs/artifactRefArray"
        }
      }
    },
    "pre_thesis_boundary": {
      "$ref": "definitions.schema.json#/$defs/preThesisBoundary"
    },
    "limitations": {
      "allOf": [
        {
          "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_candidate_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          },
          "enrichment": {
            "type": "object",
            "properties": {
              "revision_kind": {
                "const": "initial_materialization"
              },
              "changed_fields": {
                "type": "array",
                "maxItems": 0
              },
              "basis_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "parent_candidate_ref": {
            "$ref": "definitions.schema.json#/$defs/candidateRef"
          },
          "parent_content_hash": {
            "$ref": "definitions.schema.json#/$defs/sha256"
          },
          "enrichment": {
            "type": "object",
            "properties": {
              "revision_kind": {
                "enum": ["evidence_enrichment", "user_correction"]
              },
              "changed_fields": {
                "type": "array",
                "minItems": 1
              },
              "basis_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "candidate_kind": {
              "const": "demand_seed"
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "solution_neutral",
                "user_hypotheses",
                "job_to_be_done",
                "entry_scene",
                "current_alternatives",
                "failure_or_loss",
                "buyer_hypotheses",
                "desired_outcome"
              ],
              "properties": {
                "solution_neutral": {
                  "const": true
                },
                "user_hypotheses": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "job_to_be_done": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "entry_scene": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "current_alternatives": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "failure_or_loss": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "buyer_hypotheses": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "desired_outcome": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                }
              }
            }
          }
        },
        {
          "properties": {
            "candidate_kind": {
              "const": "baseline_seed"
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "demand_candidate_ref",
                "current_workflow",
                "current_cost_or_burden",
                "failure_modes",
                "switching_cost",
                "why_users_continue",
                "minimum_incremental_value_required"
              ],
              "properties": {
                "demand_candidate_ref": {
                  "$ref": "definitions.schema.json#/$defs/candidateRef"
                },
                "current_workflow": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "current_cost_or_burden": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "failure_modes": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "switching_cost": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "why_users_continue": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "minimum_incremental_value_required": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                }
              }
            }
          }
        },
        {
          "properties": {
            "candidate_kind": {
              "const": "solution_seed"
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "demand_candidate_ref",
                "baseline_candidate_ref",
                "solution_class",
                "description",
                "delivery_forms",
                "workflow_change",
                "incremental_value_hypothesis",
                "uses_ai",
                "kill_criteria"
              ],
              "properties": {
                "demand_candidate_ref": {
                  "$ref": "definitions.schema.json#/$defs/candidateRef"
                },
                "baseline_candidate_ref": {
                  "$ref": "definitions.schema.json#/$defs/candidateRef"
                },
                "solution_class": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "description": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "delivery_forms": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "workflow_change": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "incremental_value_hypothesis": {
                  "$ref": "definitions.schema.json#/$defs/nonEmptyString"
                },
                "uses_ai": {
                  "type": "boolean"
                },
                "kill_criteria": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
