{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v9/discovery-candidate-conversion.schema.json",
  "title": "Startup Opportunity Discovery Candidate Conversion Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversion_id",
    "revision",
    "parent_conversion_ref",
    "parent_content_hash",
    "run_id",
    "owner_slice",
    "source_candidate_ref",
    "source_candidate_schema_version",
    "source_candidate_kind",
    "source_candidate_revision",
    "source_candidate_content_hash",
    "discovery_fan_in_ref",
    "required_source_disposition",
    "target_schema_version",
    "target_artifact_ref",
    "target_revision",
    "conversion_status",
    "promotion_preconditions",
    "source_candidate_mutation",
    "conversion_is_evidence",
    "external_validation_success_claimed",
    "target_published",
    "target_content_hash",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.discovery_candidate_conversion.v1" },
    "conversion_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "parent_conversion_ref": {
      "anyOf": [
        { "$ref": "definitions.schema.json#/$defs/discoveryCandidateConversionRef" },
        { "type": "null" }
      ]
    },
    "parent_content_hash": {
      "anyOf": [{ "$ref": "definitions.schema.json#/$defs/sha256" }, { "type": "null" }]
    },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "owner_slice": { "const": "G2.3" },
    "source_candidate_ref": { "$ref": "definitions.schema.json#/$defs/candidateRef" },
    "source_candidate_schema_version": { "const": "startup_opportunity.discovery_candidate.v1" },
    "source_candidate_kind": { "$ref": "definitions.schema.json#/$defs/candidateKind" },
    "source_candidate_revision": { "type": "integer", "minimum": 1 },
    "source_candidate_content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" },
    "discovery_fan_in_ref": {
      "type": "string",
      "pattern": "^artifacts/discovery/fan-in\\.r[1-9][0-9]*\\.json$"
    },
    "required_source_disposition": { "const": "retained" },
    "target_schema_version": {
      "enum": [
        "startup_opportunity.demand_thesis.v1",
        "startup_opportunity.baseline_option.v1",
        "startup_opportunity.solution_hypothesis.v1"
      ]
    },
    "target_artifact_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "target_revision": { "const": 1 },
    "conversion_status": { "const": "contract_only_not_executable" },
    "promotion_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_candidate_is_current_revision",
        "source_candidate_is_retained",
        "typed_evidence_lineage_valid",
        "decision_sufficiency_satisfied",
        "g2_3_target_schema_installed",
        "g2_3_conversion_evaluator_installed",
        "promotion_authorized"
      ],
      "properties": {
        "source_candidate_is_current_revision": { "const": true },
        "source_candidate_is_retained": { "const": true },
        "typed_evidence_lineage_valid": { "const": true },
        "decision_sufficiency_satisfied": { "const": false },
        "g2_3_target_schema_installed": { "const": false },
        "g2_3_conversion_evaluator_installed": { "const": false },
        "promotion_authorized": { "const": false }
      }
    },
    "source_candidate_mutation": { "const": "forbidden" },
    "conversion_is_evidence": { "const": false },
    "external_validation_success_claimed": { "const": false },
    "target_published": { "const": false },
    "target_content_hash": { "type": "null" },
    "limitations": {
      "allOf": [
        { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
        { "type": "array", "minItems": 1 }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_conversion_ref": { "type": "null" },
          "parent_content_hash": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "parent_conversion_ref": {
            "$ref": "definitions.schema.json#/$defs/discoveryCandidateConversionRef"
          },
          "parent_content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" }
        }
      }
    }
  ]
}
