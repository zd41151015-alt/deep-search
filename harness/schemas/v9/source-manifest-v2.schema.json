{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v9/source-manifest-v2.schema.json",
  "title": "Startup Opportunity Discovery Source Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "unit_id",
    "lineage",
    "research_phase_role",
    "accepted_evidence_refs",
    "canonical_source_groups",
    "shared_dataset_groups",
    "duplicate_or_syndication_groups",
    "source_type_coverage",
    "geo_language_coverage",
    "time_coverage",
    "stance_coverage",
    "known_source_blind_spots",
    "freshness_summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.source_manifest.v2"
    },
    "manifest_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "definitions.schema.json#/$defs/discoveryLineage"
    },
    "research_phase_role": {
      "enum": ["candidate_generation", "candidate_evaluation", "adversarial_challenger"]
    },
    "accepted_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/evidenceRef"
      },
      "uniqueItems": true
    },
    "canonical_source_groups": {
      "$ref": "#/$defs/evidenceGroups"
    },
    "shared_dataset_groups": {
      "$ref": "#/$defs/evidenceGroups"
    },
    "duplicate_or_syndication_groups": {
      "$ref": "#/$defs/evidenceGroups"
    },
    "source_type_coverage": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "geo_language_coverage": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "time_coverage": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "stance_coverage": {
      "type": "array",
      "items": {
        "enum": ["support", "oppose", "context"]
      },
      "uniqueItems": true
    },
    "known_source_blind_spots": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "freshness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "stale", "unverified", "superseded"],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "allOf": [
        {
          "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    }
  },
  "$defs": {
    "evidenceGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "evidence_refs"],
        "properties": {
          "group_id": {
            "$ref": "definitions.schema.json#/$defs/identifier"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "definitions.schema.json#/$defs/evidenceRef"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
