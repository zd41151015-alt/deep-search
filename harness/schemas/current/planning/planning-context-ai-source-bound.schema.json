{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/planning/planning-context-ai-source-bound.schema.json",
  "title": "Startup Opportunity AI Source-bound Planning Context",
  "$defs": {
    "aiDimensions": {
      "type": "array",
      "prefixItems": [
        {
          "const": "capability_frontier"
        },
        {
          "const": "cost_and_deployment"
        },
        {
          "const": "workflow_and_human_boundary"
        },
        {
          "const": "ecosystem_and_platform"
        },
        {
          "const": "data_and_evaluation"
        },
        {
          "const": "adoption_and_trust"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "requiredAiCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trigger_version", "basis", "required_dimensions"],
      "properties": {
        "status": {
          "const": "required"
        },
        "trigger_version": {
          "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
        },
        "basis": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signal",
                "declared_value",
                "subject_ref",
                "source_ref",
                "source_schema_version",
                "source_content_hash"
              ],
              "properties": {
                "signal": {
                  "const": "uses_ai"
                },
                "declared_value": {
                  "const": "true"
                },
                "subject_ref": {
                  "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
                },
                "source_ref": {
                  "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
                },
                "source_schema_version": {
                  "const": "startup_opportunity.ai_trigger_source_attestation.v1"
                },
                "source_content_hash": {
                  "$ref": "../core/definitions.schema.json#/$defs/sha256"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signal",
                "declared_value",
                "subject_ref",
                "source_ref",
                "source_schema_version",
                "source_content_hash"
              ],
              "properties": {
                "signal": {
                  "const": "assessment_profile"
                },
                "declared_value": {
                  "enum": ["ai", "regulated_ai"]
                },
                "subject_ref": {
                  "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
                },
                "source_ref": {
                  "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
                },
                "source_schema_version": {
                  "const": "startup_opportunity.ai_trigger_source_attestation.v1"
                },
                "source_content_hash": {
                  "$ref": "../core/definitions.schema.json#/$defs/sha256"
                }
              }
            }
          ]
        },
        "required_dimensions": {
          "$ref": "#/$defs/aiDimensions"
        }
      }
    },
    "notRequiredAiCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trigger_version", "basis", "required_dimensions"],
      "properties": {
        "status": {
          "const": "not_required"
        },
        "trigger_version": {
          "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal",
            "declared_value",
            "subject_ref",
            "source_ref",
            "source_schema_version",
            "source_content_hash"
          ],
          "properties": {
            "signal": {
              "const": "none"
            },
            "declared_value": {
              "const": "not_applicable"
            },
            "subject_ref": {
              "type": "null"
            },
            "source_ref": {
              "type": "null"
            },
            "source_schema_version": {
              "type": "null"
            },
            "source_content_hash": {
              "type": "null"
            }
          }
        },
        "required_dimensions": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "revision",
    "parent_context_ref",
    "run_id",
    "mode",
    "phase",
    "validation_stage",
    "manifest_binding",
    "target_plan_binding",
    "ai_mandatory_coverage",
    "producer_role",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.planning_context.ai_source_bound.current"
    },
    "context_id": {
      "$ref": "../core/definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_context_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^plans/planning-context\\.r[1-9][0-9]*\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "../core/definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "$ref": "../core/definitions.schema.json#/$defs/mode"
    },
    "phase": {
      "enum": ["discovery", "enrichment", "assessment", "review"]
    },
    "validation_stage": {
      "enum": ["initial_plan", "current_plan", "candidate_revision"]
    },
    "manifest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_ref",
        "manifest_schema_version",
        "run_id",
        "mode",
        "current_plan_ref",
        "current_plan_revision",
        "run_state_hash"
      ],
      "properties": {
        "manifest_ref": {
          "const": "manifest.json"
        },
        "manifest_schema_version": {
          "const": "startup_opportunity.run_manifest.v1"
        },
        "run_id": {
          "$ref": "../core/definitions.schema.json#/$defs/runId"
        },
        "mode": {
          "$ref": "../core/definitions.schema.json#/$defs/mode"
        },
        "current_plan_ref": {
          "anyOf": [
            {
              "$ref": "../core/definitions.schema.json#/$defs/planRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "run_state_hash": {
          "$ref": "../core/definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "target_plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_ref",
        "plan_schema_version",
        "plan_id",
        "plan_revision",
        "plan_content_hash"
      ],
      "properties": {
        "plan_ref": {
          "$ref": "../core/definitions.schema.json#/$defs/planRef"
        },
        "plan_schema_version": {
          "const": "startup_opportunity.research_plan.v1"
        },
        "plan_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "plan_content_hash": {
          "$ref": "../core/definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "ai_mandatory_coverage": {
      "oneOf": [
        {
          "$ref": "#/$defs/requiredAiCoverage"
        },
        {
          "$ref": "#/$defs/notRequiredAiCoverage"
        }
      ]
    },
    "producer_role": {
      "const": "main_agent"
    },
    "created_at": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_context_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_context_ref": {
            "type": "string",
            "pattern": "^plans/planning-context\\.r[1-9][0-9]*\\.json$"
          }
        }
      }
    }
  ]
}
