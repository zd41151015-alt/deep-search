{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/planning/adaptation-author-request.schema.json",
  "title": "Startup Opportunity Adaptation Author Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "operation",
    "gap",
    "decisions",
    "apply_created_at",
    "checkpoint_created_at",
    "next_phase",
    "next_step",
    "belief_summary",
    "top_level_formal_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.adaptation_author_request.current"
    },
    "request_id": {
      "$ref": "../core/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../core/definitions.schema.json#/$defs/runId"
    },
    "operation": {
      "enum": ["validate_only", "publish", "apply"]
    },
    "publication_plan": {
      "$ref": "./adaptation-author-result.schema.json#/$defs/publicationPlan"
    },
    "top_level_formal_refs": {
      "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
    },
    "gap": {
      "$ref": "#/$defs/gapInput"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decisionInput"
      }
    },
    "apply_created_at": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    },
    "checkpoint_created_at": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    },
    "next_phase": {
      "enum": ["discovery", "enrichment", "review"]
    },
    "next_step": {
      "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "belief_summary": {
      "$ref": "../core/checkpoint.schema.json#/properties/belief_summary"
    },
    "terminal_report_envelope": {
      "$ref": "../store/artifact-envelope.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "validate_only" } },
        "required": ["operation"]
      },
      "then": { "not": { "required": ["publication_plan"] } }
    },
    {
      "if": {
        "properties": { "operation": { "enum": ["publish", "apply"] } },
        "required": ["operation"]
      },
      "then": { "required": ["publication_plan"] }
    }
  ],
  "$defs": {
    "gapInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "created_at",
        "trigger_kind",
        "trigger_event_ref",
        "phase",
        "wave_id",
        "observed_artifact_refs",
        "material_new_evidence_observed",
        "repeated_source_refs",
        "machine_checks",
        "semantic_gaps"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "created_at": {
          "$ref": "../core/definitions.schema.json#/$defs/timestamp"
        },
        "trigger_kind": {
          "enum": [
            "wave_completed",
            "user_decision",
            "artifact_validation_failed",
            "adversarial_review_completed",
            "resume_reconciliation"
          ]
        },
        "trigger_event_ref": {
          "anyOf": [
            { "$ref": "../core/definitions.schema.json#/$defs/eventRef" },
            { "type": "null" }
          ]
        },
        "phase": {
          "enum": ["discovery", "enrichment", "review"]
        },
        "wave_id": {
          "anyOf": [
            { "$ref": "../core/definitions.schema.json#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "observed_artifact_refs": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
        },
        "material_new_evidence_observed": {
          "type": "boolean"
        },
        "repeated_source_refs": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
        },
        "machine_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/machineCheck"
          }
        },
        "semantic_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticGap"
          }
        }
      }
    },
    "machineCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "gap_type",
        "subject_ref",
        "basis_refs",
        "evidence_refs",
        "decision_impact",
        "severity",
        "recommended_unit_types",
        "detail"
      ],
      "properties": {
        "check_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "gap_type": {
          "enum": [
            "mandatory_dimension_missing",
            "freshness_failed",
            "runtime_blocked",
            "scope_invalidated",
            "user_plan_change_requested"
          ]
        },
        "subject_ref": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
        },
        "basis_refs": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
        },
        "evidence_refs": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
        },
        "decision_impact": {
          "$ref": "../core/definitions.schema.json#/$defs/decisionImpactArray"
        },
        "severity": {
          "enum": ["blocking", "material", "advisory"]
        },
        "recommended_unit_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../core/definitions.schema.json#/$defs/unitType"
          }
        },
        "detail": {
          "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "semanticGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_type",
        "subject_ref",
        "triggered_by",
        "basis_refs",
        "evidence_refs",
        "decision_impact",
        "severity",
        "recommended_unit_types"
      ],
      "properties": {
        "gap_type": {
          "enum": [
            "evidence_insufficient",
            "evidence_conflict",
            "baseline_unclear",
            "buyer_evidence_insufficient",
            "acquisition_evidence_insufficient",
            "reviewer_challenge",
            "candidate_pre_killed"
          ]
        },
        "subject_ref": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
        },
        "triggered_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["judgment_ref", "decision_sufficiency", "independent_source_count"],
          "properties": {
            "judgment_ref": {
              "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
            },
            "decision_sufficiency": {
              "enum": ["sufficient", "insufficient", "blocked", "not_applicable"]
            },
            "independent_source_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
          }
        },
        "evidence_refs": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRefArray"
        },
        "decision_impact": {
          "$ref": "../core/definitions.schema.json#/$defs/decisionImpactArray"
        },
        "severity": {
          "enum": ["blocking", "material", "advisory"]
        },
        "recommended_unit_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../core/definitions.schema.json#/$defs/unitType"
          }
        }
      }
    },
    "decisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptation_id",
        "action",
        "reason",
        "expected_decision_impact",
        "requested_by",
        "created_at"
      ],
      "properties": {
        "adaptation_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "trigger_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../core/definitions.schema.json#/$defs/identifier"
          }
        },
        "cover_all_generated_gaps": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "add_unit",
            "cancel_unit",
            "skip_unit",
            "reprioritize_unit",
            "retry_unit",
            "supersede_unit",
            "reconcile_scope",
            "continue_existing_plan",
            "request_clarification",
            "stop_followup",
            "record_runtime_failure",
            "terminate_insufficient_evidence",
            "complete_research",
            "cancel_research"
          ]
        },
        "target_unit": {
          "$ref": "../core/definitions.schema.json#/$defs/researchUnit"
        },
        "target_unit_ref": {
          "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
        },
        "coverage_attestation_ref": {
          "type": "string",
          "pattern": "^adaptations/coverage/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "retry_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "manifest_ref", "unit_id", "manifest_state"],
          "properties": {
            "kind": { "const": "manifest_failed_unit" },
            "manifest_ref": { "const": "manifest.json" },
            "unit_id": {
              "$ref": "../core/definitions.schema.json#/$defs/identifier"
            },
            "manifest_state": { "const": "failed" }
          }
        },
        "priority_band": {
          "enum": ["low", "normal", "high", "blocking"]
        },
        "clarification_question": {
          "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
        },
        "expected_decision_impact": {
          "$ref": "../core/definitions.schema.json#/$defs/decisionImpactArray"
        },
        "success_condition": {
          "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
        },
        "stop_condition": {
          "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
        },
        "requested_by": {
          "enum": ["main_agent", "user"]
        },
        "user_decision_ref": {
          "$ref": "../core/definitions.schema.json#/$defs/decisionRef"
        },
        "created_at": {
          "$ref": "../core/definitions.schema.json#/$defs/timestamp"
        }
      },
      "oneOf": [
        {
          "required": ["trigger_gap_ids"],
          "not": { "required": ["cover_all_generated_gaps"] }
        },
        {
          "required": ["cover_all_generated_gaps"],
          "properties": { "cover_all_generated_gaps": { "const": true } },
          "not": { "required": ["trigger_gap_ids"] }
        }
      ]
    }
  }
}
