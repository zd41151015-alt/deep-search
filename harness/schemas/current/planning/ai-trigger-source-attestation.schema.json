{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/planning/ai-trigger-source-attestation.schema.json",
  "title": "Startup Opportunity AI Trigger Source Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "run_id",
    "mode",
    "planning_context_binding",
    "subject_ref",
    "trigger",
    "producer_role",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.ai_trigger_source_attestation.v1"
    },
    "attestation_id": {
      "$ref": "../core/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../core/definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "$ref": "../core/definitions.schema.json#/$defs/mode"
    },
    "planning_context_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "context_revision"],
      "properties": {
        "context_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject_ref": {
      "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_version", "signal", "declared_value"],
          "properties": {
            "trigger_version": {
              "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
            },
            "signal": {
              "const": "uses_ai"
            },
            "declared_value": {
              "const": "true"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger_version", "signal", "declared_value"],
          "properties": {
            "trigger_version": {
              "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
            },
            "signal": {
              "const": "assessment_profile"
            },
            "declared_value": {
              "enum": ["ai", "regulated_ai"]
            }
          }
        }
      ]
    },
    "producer_role": {
      "const": "main_agent"
    },
    "created_at": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    }
  }
}
