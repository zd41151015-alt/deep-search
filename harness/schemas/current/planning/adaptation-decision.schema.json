{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/planning/adaptation-decision.schema.json",
  "title": "Startup Opportunity Discovery Adaptation Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adaptation_id",
    "run_id",
    "based_on_plan_ref",
    "trigger_gap_refs",
    "action",
    "reason",
    "expected_decision_impact",
    "requested_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.adaptation_decision.discovery.current"
    },
    "adaptation_id": {
      "$ref": "../core/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../core/definitions.schema.json#/$defs/runId"
    },
    "based_on_plan_ref": {
      "$ref": "../core/definitions.schema.json#/$defs/planRef"
    },
    "trigger_gap_refs": {
      "type": "array",
      "items": {
        "$ref": "../core/definitions.schema.json#/$defs/gapRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "action": {
      "enum": [
        "add_unit",
        "cancel_unit",
        "skip_unit",
        "reprioritize_unit",
        "retry_unit",
        "supersede_unit",
        "continue_existing_plan",
        "request_clarification",
        "stop_followup",
        "record_runtime_failure",
        "terminate_insufficient_evidence",
        "complete_research",
        "cancel_research"
      ]
    },
    "target_unit": {
      "$ref": "../core/definitions.schema.json#/$defs/researchUnit"
    },
    "target_unit_ref": {
      "$ref": "../core/definitions.schema.json#/$defs/artifactRef"
    },
    "coverage_attestation_ref": {
      "type": "string",
      "pattern": "^adaptations/coverage/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "retry_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest_ref", "unit_id", "manifest_state"],
      "properties": {
        "kind": {
          "const": "manifest_failed_unit"
        },
        "manifest_ref": {
          "const": "manifest.json"
        },
        "unit_id": {
          "$ref": "../core/definitions.schema.json#/$defs/identifier"
        },
        "manifest_state": {
          "const": "failed"
        }
      }
    },
    "priority_band": {
      "enum": ["low", "normal", "high", "blocking"]
    },
    "clarification_question": {
      "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "reason": {
      "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "expected_decision_impact": {
      "$ref": "../core/definitions.schema.json#/$defs/decisionImpactArray"
    },
    "success_condition": {
      "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "stop_condition": {
      "$ref": "../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "requested_by": {
      "enum": ["main_agent", "user"]
    },
    "user_decision_ref": {
      "$ref": "../core/definitions.schema.json#/$defs/decisionRef"
    },
    "created_at": {
      "$ref": "../core/definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "add_unit"
            }
          },
          "required": ["target_unit", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit_ref"]
              },
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "enum": ["cancel_unit", "skip_unit"]
            }
          },
          "required": ["target_unit_ref", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit"]
              },
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "const": "reprioritize_unit"
            }
          },
          "required": ["target_unit_ref", "priority_band", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit"]
              },
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "const": "retry_unit"
            }
          },
          "required": ["target_unit_ref", "target_unit", "retry_basis", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "const": "supersede_unit"
            }
          },
          "required": ["target_unit_ref", "target_unit", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "const": "continue_existing_plan"
            }
          },
          "required": ["target_unit_ref", "coverage_attestation_ref", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "const": "request_clarification"
            }
          },
          "required": ["clarification_question", "success_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit"]
              },
              {
                "required": ["target_unit_ref"]
              },
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["stop_condition"]
              }
            ]
          }
        },
        {
          "properties": {
            "action": {
              "enum": [
                "stop_followup",
                "record_runtime_failure",
                "terminate_insufficient_evidence",
                "complete_research",
                "cancel_research"
              ]
            }
          },
          "required": ["stop_condition"],
          "not": {
            "anyOf": [
              {
                "required": ["target_unit"]
              },
              {
                "required": ["target_unit_ref"]
              },
              {
                "required": ["coverage_attestation_ref"]
              },
              {
                "required": ["retry_basis"]
              },
              {
                "required": ["priority_band"]
              },
              {
                "required": ["clarification_question"]
              },
              {
                "required": ["success_condition"]
              }
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "action": { "enum": ["complete_research", "cancel_research"] }
        },
        "required": ["action"]
      },
      "then": {
        "properties": { "trigger_gap_refs": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "trigger_gap_refs": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "complete_research" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "requested_by": { "const": "main_agent" } }
      }
    },
    {
      "if": {
        "properties": { "action": { "const": "cancel_research" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "requested_by": { "const": "user" } },
        "required": ["user_decision_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "requested_by": {
            "const": "user"
          }
        },
        "required": ["requested_by"]
      },
      "then": {
        "required": ["user_decision_ref"]
      },
      "else": {
        "not": {
          "required": ["user_decision_ref"]
        }
      }
    }
  ]
}
