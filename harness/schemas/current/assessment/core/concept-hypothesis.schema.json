{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/core/concept-hypothesis.schema.json",
  "title": "Startup Opportunity Assessment Concept Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "concept_hypothesis_id",
    "scope_frame_ref",
    "product_thesis",
    "target_user",
    "buyer",
    "entry_scene",
    "claimed_value",
    "current_alternative",
    "delivery_form",
    "business_model",
    "acquisition_hypothesis",
    "uses_ai",
    "assumptions",
    "unknowns",
    "kill_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concept_hypothesis.assessment.current"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "concept_hypothesis_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "parent_concept_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "parent_content_hash": {
      "$ref": "../../core/definitions.schema.json#/$defs/sha256"
    },
    "formation_input_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "content_hash"],
        "properties": {
          "ref": {
            "$ref": "./definitions.schema.json#/$defs/artifactRef"
          },
          "content_hash": {
            "$ref": "../../core/definitions.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "product_thesis": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "target_user": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "buyer": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "entry_scene": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "claimed_value": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "current_alternative": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "delivery_form": {
      "$ref": "./definitions.schema.json#/$defs/deliveryForm"
    },
    "business_model": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "acquisition_hypothesis": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "uses_ai": {
      "type": "boolean"
    },
    "assumptions": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "unknowns": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "kill_criteria": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "dependentRequired": {
    "revision": ["parent_concept_ref", "parent_content_hash", "formation_input_hashes"],
    "parent_concept_ref": ["revision", "parent_content_hash", "formation_input_hashes"],
    "parent_content_hash": ["revision", "parent_concept_ref", "formation_input_hashes"],
    "formation_input_hashes": ["revision", "parent_concept_ref", "parent_content_hash"]
  }
}
