{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/core/concept-evidence-assessment-branch-result.schema.json",
  "title": "Startup Opportunity Concept Evidence Assessment Branch Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "branch_id",
    "run_id",
    "unit_id",
    "concept_hypothesis_ref",
    "assessment_plan_ref",
    "dimension_id",
    "branch_status",
    "research_questions",
    "evidence_refs",
    "supporting_claim_refs",
    "opposing_claim_refs",
    "judgment_assessment_refs",
    "finding_refs",
    "coverage_disposition",
    "dimension_decision",
    "decision_sufficiency",
    "insufficiency_reasons",
    "evidence_quality",
    "uncertainty",
    "what_would_change_decision",
    "open_questions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concept_evidence_assessment_branch_result.v1"
    },
    "branch_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "concept_hypothesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "assessment_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/assessmentPlanRef"
    },
    "dimension_id": {
      "$ref": "./definitions.schema.json#/$defs/assessmentDimension"
    },
    "branch_status": {
      "$ref": "./definitions.schema.json#/$defs/branchStatus"
    },
    "research_questions": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "evidence_refs": {
      "$ref": "./definitions.schema.json#/$defs/evidenceOrClaimRefArray"
    },
    "supporting_claim_refs": {
      "$ref": "./definitions.schema.json#/$defs/evidenceOrClaimRefArray"
    },
    "opposing_claim_refs": {
      "$ref": "./definitions.schema.json#/$defs/evidenceOrClaimRefArray"
    },
    "judgment_assessment_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "finding_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "coverage_disposition": {
      "$ref": "./definitions.schema.json#/$defs/coverageDisposition"
    },
    "dimension_decision": {
      "$ref": "./definitions.schema.json#/$defs/dimensionDecision"
    },
    "decision_sufficiency": {
      "$ref": "./definitions.schema.json#/$defs/decisionSufficiency"
    },
    "insufficiency_reasons": {
      "$ref": "./definitions.schema.json#/$defs/insufficiencyReasons"
    },
    "evidence_quality": {
      "$ref": "./definitions.schema.json#/$defs/evidenceQuality"
    },
    "uncertainty": {
      "$ref": "./definitions.schema.json#/$defs/uncertainty"
    },
    "what_would_change_decision": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "open_questions": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    { "$ref": "./definitions.schema.json#/$defs/assessmentCoverageDecisionSemantics" },
    {
      "if": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient", "blocked"]
          }
        },
        "required": ["decision_sufficiency"]
      },
      "then": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimension_decision": {
            "const": "not_applicable"
          }
        },
        "required": ["dimension_decision"]
      },
      "then": {
        "properties": {
          "decision_sufficiency": {
            "const": "not_applicable"
          },
          "limitations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
