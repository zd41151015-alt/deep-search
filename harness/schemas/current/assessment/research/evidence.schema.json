{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/research/evidence.schema.json",
  "title": "Startup Opportunity Assessment Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "unit_id",
    "lineage",
    "source_type",
    "evidence_origin",
    "source_name",
    "published_at",
    "retrieved_at",
    "research_goal",
    "research_phase_role",
    "geo",
    "language",
    "sample_size",
    "mechanical_binding",
    "provenance",
    "source_assessment",
    "evidence_tier",
    "evidence_lifecycle_status",
    "evidence_role",
    "representativeness",
    "valid_as_of",
    "freshness_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.evidence.assessment.current"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[a-f0-9]{64}$"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "./definitions.schema.json#/$defs/lineage"
    },
    "source_type": {
      "enum": [
        "web_page",
        "app_store_review",
        "forum_post",
        "public_dataset",
        "public_report",
        "user_document",
        "user_existing_interview_record",
        "user_existing_behavior_record",
        "user_existing_transaction_record",
        "synthetic_contract_fixture"
      ]
    },
    "evidence_origin": {
      "enum": ["public_source", "user_provided_existing_material"]
    },
    "source_name": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "research_goal": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "research_phase_role": {
      "enum": [
        "candidate_generation",
        "candidate_evaluation",
        "adversarial_challenger",
        "shared_context"
      ]
    },
    "geo": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "language": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "sample_size": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "mechanical_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substrate_record_ref",
        "source",
        "source_hash",
        "content_hash",
        "raw_content_ref",
        "operation_key",
        "recorded_at"
      ],
      "properties": {
        "substrate_record_ref": {
          "$ref": "./definitions.schema.json#/$defs/evidenceSubstrateRef"
        },
        "source": {
          "$ref": "./definitions.schema.json#/$defs/canonicalSource"
        },
        "source_hash": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "content_hash": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "raw_content_ref": {
          "type": "string",
          "pattern": "^evidence/raw/sha256-[a-f0-9]{64}\\.bin$"
        },
        "operation_key": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "recorded_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_method",
        "source_owner",
        "original_creator",
        "method_notes",
        "user_provided_at"
      ],
      "properties": {
        "acquisition_method": {
          "enum": ["public_web_retrieval", "user_provided_import"]
        },
        "source_owner": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "original_creator": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "method_notes": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "user_provided_at": {
          "anyOf": [
            {
              "$ref": "./definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence",
        "canonical_source_group",
        "shared_dataset_group",
        "syndication_group",
        "biases",
        "bias_notes"
      ],
      "properties": {
        "independence": {
          "enum": [
            "primary",
            "independent_secondary",
            "dependent_secondary",
            "shared_underlying_dataset",
            "unknown"
          ]
        },
        "canonical_source_group": {
          "$ref": "./definitions.schema.json#/$defs/identifier"
        },
        "shared_dataset_group": {
          "anyOf": [
            {
              "$ref": "./definitions.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "syndication_group": {
          "anyOf": [
            {
              "$ref": "./definitions.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "biases": {
          "type": "array",
          "items": {
            "enum": [
              "self_selection",
              "vendor_interest",
              "negative_review_heavy",
              "positive_review_heavy",
              "survivorship",
              "geographic",
              "language",
              "sampling_method_unknown",
              "none_identified"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bias_notes": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "evidence_tier": {
      "$ref": "./definitions.schema.json#/$defs/evidenceTier"
    },
    "evidence_lifecycle_status": {
      "enum": ["active", "superseded", "stale", "unverified"]
    },
    "evidence_role": {
      "enum": ["support", "oppose", "context"]
    },
    "representativeness": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "freshness_policy": {
      "enum": [
        "revalidate_on_product_or_market_change",
        "revalidate_on_price_or_policy_change",
        "revalidate_on_source_update",
        "immutable_historical_record",
        "user_material_valid_as_provided"
      ]
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "evidence_origin": {
            "const": "public_source"
          }
        },
        "required": ["evidence_origin"]
      },
      "then": {
        "type": "object",
        "properties": {
          "mechanical_binding": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "public_url"
                  }
                },
                "required": ["kind"]
              }
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "acquisition_method": {
                "const": "public_web_retrieval"
              },
              "user_provided_at": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "evidence_origin": {
            "const": "user_provided_existing_material"
          }
        },
        "required": ["evidence_origin"]
      },
      "then": {
        "type": "object",
        "properties": {
          "mechanical_binding": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "user_provided"
                  }
                },
                "required": ["kind"]
              }
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "acquisition_method": {
                "const": "user_provided_import"
              },
              "user_provided_at": {
                "$ref": "./definitions.schema.json#/$defs/timestamp"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "source_type": {
            "const": "synthetic_contract_fixture"
          }
        },
        "required": ["source_type"]
      },
      "then": {
        "type": "object",
        "properties": {
          "evidence_tier": {
            "const": "model_inference_only"
          },
          "evidence_lifecycle_status": {
            "const": "unverified"
          },
          "limitations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
