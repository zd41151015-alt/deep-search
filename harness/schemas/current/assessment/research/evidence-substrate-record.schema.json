{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/research/evidence-substrate-record.schema.json",
  "title": "Startup Opportunity Evidence Substrate Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "unit_id",
    "unit_attempt",
    "source",
    "source_hash",
    "content_hash",
    "acquisition_goal",
    "raw_content_ref",
    "operation_key",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.evidence_store_record.v2"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[a-f0-9]{64}$"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "unit_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "$ref": "./definitions.schema.json#/$defs/canonicalSource"
    },
    "source_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "acquisition_goal": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "raw_content_ref": {
      "type": "string",
      "pattern": "^evidence/raw/sha256-[a-f0-9]{64}\\.bin$"
    },
    "operation_key": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "recorded_at": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "handoff_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_ref",
        "handoff_item_id",
        "source_run_id",
        "source_evidence_path",
        "source_record_hash",
        "source_raw_content_hash",
        "source_recorded_at",
        "freshness_disposition",
        "applicability_disposition",
        "revalidation_status"
      ],
      "properties": {
        "handoff_ref": {
          "type": "string",
          "pattern": "^artifacts/research-handoffs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\.json$"
        },
        "handoff_item_id": {
          "$ref": "./definitions.schema.json#/$defs/identifier"
        },
        "source_run_id": {
          "$ref": "./definitions.schema.json#/$defs/runId"
        },
        "source_evidence_path": {
          "type": "string",
          "pattern": "^evidence/manifest\\.jsonl#ev_[a-f0-9]{64}$"
        },
        "source_record_hash": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "source_raw_content_hash": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "source_recorded_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        },
        "freshness_disposition": {
          "enum": ["current", "historical", "unknown"]
        },
        "applicability_disposition": {
          "enum": ["applicable", "partially_applicable", "unknown"]
        },
        "revalidation_status": {
          "enum": ["not_required", "required"]
        }
      }
    }
  }
}
