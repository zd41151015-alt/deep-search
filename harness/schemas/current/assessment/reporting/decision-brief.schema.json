{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/reporting/decision-brief.schema.json",
  "title": "Startup Opportunity Assessment Decision Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "run_id",
    "research_language",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_ref",
    "report_content_hash",
    "assessment_ref",
    "decision_question",
    "assessment_result",
    "current_recommendation",
    "recommendation_meaning",
    "decisive_supporting_refs",
    "decisive_opposing_refs",
    "alternatives_not_selected",
    "critical_unknowns",
    "what_would_change_the_decision",
    "belief_update_summary",
    "valid_as_of",
    "scope_summary",
    "limitations",
    "external_action_boundary",
    "markdown",
    "markdown_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.decision_brief.assessment.current"
    },
    "brief_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "research_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "producer_role": {
      "const": "harness"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/decision-brief\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "decision-brief.md"
    },
    "report_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "report_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "assessment_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "decision_question": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "assessment_result": {
      "$ref": "./definitions.schema.json#/$defs/assessmentResult"
    },
    "current_recommendation": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "recommendation_meaning": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "decisive_supporting_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "decisive_opposing_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "alternatives_not_selected": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "critical_unknowns": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "what_would_change_the_decision": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "belief_update_summary": {
      "$ref": "./definitions.schema.json#/$defs/beliefUpdate"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "scope_summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "external_action_boundary": {
      "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
    },
    "markdown": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "markdown_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    }
  }
}
