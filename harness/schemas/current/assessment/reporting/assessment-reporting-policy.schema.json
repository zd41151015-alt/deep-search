{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/reporting/assessment-reporting-policy.schema.json",
  "title": "Startup Opportunity Assessment Reporting Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "assessment_results",
    "evaluator_results",
    "decisive_hard_gates",
    "low_tier_ceiling",
    "mandatory_absence_rule",
    "generation_order",
    "forbidden_report_expressions",
    "external_action_boundary",
    "producer_ownership"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.assessment_reporting_policy.current"
    },
    "policy_id": {
      "const": "startup_opportunity.g1_4_assessment_reporting"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "assessment_results": {
      "type": "array",
      "prefixItems": [
        {
          "const": "prioritize"
        },
        {
          "const": "investigate_further"
        },
        {
          "const": "deprioritize"
        },
        {
          "const": "insufficient_evidence"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "evaluator_results": {
      "type": "array",
      "prefixItems": [
        {
          "const": "passed"
        },
        {
          "const": "needs_revision"
        },
        {
          "const": "insufficient_evidence"
        },
        {
          "const": "failed"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "decisive_hard_gates": {
      "type": "array",
      "items": {
        "enum": [
          "target_user_and_jtbd",
          "baseline_delta",
          "buyer",
          "acquisition",
          "business_engine",
          "delivery_feasibility",
          "compliance_boundary",
          "counter_evidence",
          "evidence_quality",
          "source_independence",
          "freshness",
          "ai_mandatory_bundle"
        ]
      },
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    },
    "low_tier_ceiling": {
      "const": "insufficient_evidence_when_decisive"
    },
    "mandatory_absence_rule": {
      "const": "missing_external_behavior_commitment_or_transaction_is_ceiling_not_opposition"
    },
    "generation_order": {
      "type": "array",
      "prefixItems": [
        {
          "const": "validated_artifacts"
        },
        {
          "const": "report.json"
        },
        {
          "const": "decision-brief.md"
        },
        {
          "const": "report.md"
        },
        {
          "const": "consistency_evaluation"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "forbidden_report_expressions": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "external_action_boundary": {
      "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
    },
    "producer_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_audit",
        "adversarial_review",
        "assessment",
        "traceability",
        "report_views"
      ],
      "properties": {
        "evidence_audit": {
          "const": "evidence_auditor"
        },
        "adversarial_review": {
          "const": "adversarial_reviewer"
        },
        "assessment": {
          "const": "main_agent"
        },
        "traceability": {
          "const": "harness"
        },
        "report_views": {
          "const": "harness"
        }
      }
    }
  }
}
