{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/reporting/concept-evidence-report.schema.json",
  "title": "Startup Opportunity Concept Evidence Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_metadata",
    "decision_context_ref",
    "concept_frame_ref",
    "concept_hypothesis_ref",
    "evidence_assessment_plan_ref",
    "research_plan_ref",
    "plan_lineage_refs",
    "applied_adaptation_refs",
    "hypothesis_evidence_matrix_ref",
    "adversarial_review_ref",
    "evidence_audit_ref",
    "concept_evidence_assessment_ref",
    "business_engine_ref",
    "judgment_assessment_refs",
    "source_manifest_refs",
    "commercial_research_audit_refs",
    "quantitative_signal_rows",
    "competitive_substitute_rows",
    "incumbent_response_risk_rows",
    "research_coverage_gaps",
    "gate_warnings",
    "traceability_ref",
    "curated_judgment_context",
    "report_sections",
    "statements",
    "freshness_summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concept_evidence_report.v1"
    },
    "report_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "producer_role": {
      "const": "main_agent"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/report-json\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "report.json"
    },
    "report_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generated_at",
        "valid_as_of",
        "input_artifact_hashes",
        "external_validation_claimed"
      ],
      "properties": {
        "mode": {
          "const": "concept_evidence_assessment"
        },
        "generated_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        },
        "valid_as_of": {
          "type": "string",
          "format": "date"
        },
        "input_artifact_hashes": {
          "$ref": "./definitions.schema.json#/$defs/inputHashes"
        },
        "external_validation_claimed": {
          "const": false
        }
      }
    },
    "decision_context_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "concept_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "concept_hypothesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "evidence_assessment_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "plan_lineage_refs": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/artifactRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applied_adaptation_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "hypothesis_evidence_matrix_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "adversarial_review_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "evidence_audit_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "concept_evidence_assessment_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "business_engine_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "judgment_assessment_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "source_manifest_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "commercial_research_audit_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
      }
    },
    "quantitative_signal_rows": {
      "type": "array",
      "items": {
        "$ref": "../commercial/quantitative-competitive-research.schema.json#/$defs/quantitativeSignalRow"
      }
    },
    "competitive_substitute_rows": {
      "type": "array",
      "items": {
        "$ref": "../commercial/quantitative-competitive-research.schema.json#/$defs/competitiveMatrixRow"
      }
    },
    "incumbent_response_risk_rows": {
      "type": "array",
      "items": {
        "$ref": "../commercial/incumbent-response-risk.schema.json#/$defs/reportRow"
      }
    },
    "research_coverage_gaps": {
      "type": "array",
      "items": {
        "$ref": "../commercial/quantitative-competitive-research.schema.json#/$defs/coverageGapRow"
      }
    },
    "gate_warnings": {
      "type": "array",
      "items": {
        "$ref": "../commercial/quantitative-competitive-research.schema.json#/$defs/gateWarning"
      }
    },
    "traceability_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "curated_judgment_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_question",
        "assessment_result",
        "recommendation_meaning",
        "current_recommendation",
        "decisive_support",
        "decisive_opposition",
        "alternatives_not_selected",
        "critical_unknowns",
        "what_would_change_the_decision",
        "belief_update_summary",
        "scope_summary",
        "valid_as_of",
        "external_action_boundary",
        "limitations"
      ],
      "properties": {
        "decision_question": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "assessment_result": {
          "$ref": "./definitions.schema.json#/$defs/assessmentResult"
        },
        "recommendation_meaning": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "current_recommendation": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "decisive_support": {
          "type": "array",
          "items": {
            "$ref": "./definitions.schema.json#/$defs/summaryWithRefs"
          },
          "uniqueItems": true
        },
        "decisive_opposition": {
          "type": "array",
          "items": {
            "$ref": "./definitions.schema.json#/$defs/summaryWithRefs"
          },
          "uniqueItems": true
        },
        "alternatives_not_selected": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "critical_unknowns": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "what_would_change_the_decision": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "belief_update_summary": {
          "$ref": "./definitions.schema.json#/$defs/beliefUpdate"
        },
        "scope_summary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "valid_as_of": {
          "type": "string",
          "format": "date"
        },
        "external_action_boundary": {
          "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
        },
        "limitations": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "report_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_result_and_evidence_strength",
        "concept_hypothesis",
        "decisive_support_and_opposition",
        "demand_alternatives_solution_failure",
        "competition_and_differentiation",
        "buyer_acquisition_business_engine",
        "feasibility_compliance_ai_bundle",
        "critical_unknowns_and_kill_criteria",
        "decision_recommendation",
        "optional_validation_suggestions",
        "limitations_and_sources"
      ],
      "properties": {
        "assessment_result_and_evidence_strength": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "concept_hypothesis": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "decisive_support_and_opposition": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "demand_alternatives_solution_failure": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "competition_and_differentiation": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "buyer_acquisition_business_engine": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "feasibility_compliance_ai_bundle": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "critical_unknowns_and_kill_criteria": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "decision_recommendation": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "optional_validation_suggestions": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "limitations_and_sources": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement_id", "text", "kind", "decisive", "traceability_chain_refs"],
        "properties": {
          "statement_id": {
            "$ref": "./definitions.schema.json#/$defs/identifier"
          },
          "text": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "kind": {
            "enum": ["fact", "inference", "assumption", "recommendation", "limitation"]
          },
          "decisive": {
            "type": "boolean"
          },
          "traceability_chain_refs": {
            "type": "array",
            "items": {
              "$ref": "./definitions.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "freshness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_as_of",
        "current_decisive_evidence_count",
        "stale_decisive_evidence_count",
        "unknown_freshness_count"
      ],
      "properties": {
        "valid_as_of": {
          "type": "string",
          "format": "date"
        },
        "current_decisive_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_decisive_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_freshness_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
