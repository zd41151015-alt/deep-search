{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/reporting/concept-evidence-assessment.schema.json",
  "title": "Startup Opportunity Concept Evidence Assessment Reporting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "run_id",
    "producer_role",
    "owned_output_path",
    "lineage",
    "input_artifact_hashes",
    "fan_in_ref",
    "hypothesis_evidence_matrix_ref",
    "business_engine_ref",
    "evidence_audit_ref",
    "adversarial_review_ref",
    "assessment_profile",
    "ai_mandatory_bundle_status",
    "assessment_result",
    "recommendation_meaning",
    "market_validation_claimed",
    "evidence_strength_band",
    "conclusion_ceiling",
    "dimension_decisions",
    "hard_gate_results",
    "decisive_evidence_refs",
    "decisive_opposing_refs",
    "critical_gaps",
    "what_would_change_the_decision",
    "conditions",
    "kill_criteria",
    "belief_update_summary",
    "valid_as_of",
    "external_evidence_absence_effect",
    "external_action_boundary",
    "limitations",
    "evaluator_result",
    "evaluation_issues"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concept_evidence_assessment.reporting.current"
    },
    "assessment_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "producer_role": {
      "const": "main_agent"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/assessment/[A-Za-z0-9._-]+\\.json$"
    },
    "lineage": {
      "$ref": "./definitions.schema.json#/$defs/lineage"
    },
    "input_artifact_hashes": {
      "$ref": "./definitions.schema.json#/$defs/inputHashes"
    },
    "fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "hypothesis_evidence_matrix_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "business_engine_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "evidence_audit_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "adversarial_review_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "assessment_profile": {
      "enum": ["general", "ai", "regulated_ai"]
    },
    "ai_mandatory_bundle_status": {
      "enum": ["complete", "incomplete", "not_applicable"]
    },
    "assessment_result": {
      "$ref": "./definitions.schema.json#/$defs/assessmentResult"
    },
    "recommendation_meaning": {
      "enum": [
        "current_evidence_supports_priority_attention_not_market_validation",
        "current_evidence_supports_further_desk_research",
        "current_evidence_supports_deprioritization",
        "current_evidence_cannot_support_a_directional_conclusion"
      ]
    },
    "market_validation_claimed": {
      "const": false
    },
    "evidence_strength_band": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "conclusion_ceiling": {
      "$ref": "./definitions.schema.json#/$defs/conclusionCeiling"
    },
    "dimension_decisions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "matrix_dimension_ref",
          "decision",
          "decision_sufficiency",
          "decisive",
          "judgment_assessment_refs",
          "limitations"
        ],
        "properties": {
          "dimension_id": {
            "$ref": "./definitions.schema.json#/$defs/assessmentDimension"
          },
          "matrix_dimension_ref": {
            "$ref": "./definitions.schema.json#/$defs/artifactRef"
          },
          "decision": {
            "enum": ["supports", "mixed", "opposes", "insufficient_evidence", "not_applicable"]
          },
          "decision_sufficiency": {
            "enum": ["sufficient", "insufficient", "blocked", "not_applicable"]
          },
          "decisive": {
            "type": "boolean"
          },
          "judgment_assessment_refs": {
            "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
          },
          "limitations": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "hard_gate_results": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "decisive",
          "reason",
          "supporting_refs",
          "opposing_refs",
          "limitations"
        ],
        "properties": {
          "gate_id": {
            "enum": [
              "target_user_and_jtbd",
              "baseline_delta",
              "buyer",
              "acquisition",
              "business_engine",
              "delivery_feasibility",
              "compliance_boundary",
              "counter_evidence",
              "evidence_quality",
              "source_independence",
              "freshness",
              "ai_mandatory_bundle"
            ]
          },
          "status": {
            "enum": ["passed", "failed", "insufficient_evidence", "not_applicable"]
          },
          "decisive": {
            "type": "boolean"
          },
          "reason": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "supporting_refs": {
            "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
          },
          "opposing_refs": {
            "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
          },
          "limitations": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "decisive_evidence_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "decisive_opposing_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "critical_gaps": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "what_would_change_the_decision": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "conditions": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "kill_criteria": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "belief_update_summary": {
      "$ref": "./definitions.schema.json#/$defs/beliefUpdate"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "external_evidence_absence_effect": {
      "enum": ["conclusion_ceiling_or_limitation_only", "not_applicable"]
    },
    "external_action_boundary": {
      "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "evaluator_result": {
      "$ref": "./definitions.schema.json#/$defs/evaluatorResult"
    },
    "evaluation_issues": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/evaluationIssue"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment_result": {
            "const": "prioritize"
          }
        },
        "required": ["assessment_result"]
      },
      "then": {
        "properties": {
          "recommendation_meaning": {
            "const": "current_evidence_supports_priority_attention_not_market_validation"
          },
          "conclusion_ceiling": {
            "const": "prioritize_allowed"
          },
          "evaluator_result": {
            "const": "passed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_result": {
            "const": "investigate_further"
          }
        },
        "required": ["assessment_result"]
      },
      "then": {
        "properties": {
          "recommendation_meaning": {
            "const": "current_evidence_supports_further_desk_research"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_result": {
            "const": "deprioritize"
          }
        },
        "required": ["assessment_result"]
      },
      "then": {
        "properties": {
          "recommendation_meaning": {
            "const": "current_evidence_supports_deprioritization"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assessment_result": {
            "const": "insufficient_evidence"
          }
        },
        "required": ["assessment_result"]
      },
      "then": {
        "properties": {
          "recommendation_meaning": {
            "const": "current_evidence_cannot_support_a_directional_conclusion"
          },
          "conclusion_ceiling": {
            "const": "insufficient_evidence_required"
          },
          "evaluator_result": {
            "const": "insufficient_evidence"
          }
        }
      }
    }
  ]
}
