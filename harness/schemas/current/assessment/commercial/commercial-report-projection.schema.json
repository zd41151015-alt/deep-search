{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/commercial/commercial-report-projection.schema.json",
  "title": "Startup Opportunity Commercial Report Projection Definitions",
  "$defs": {
    "reportCitation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_ref", "label", "source_access", "url"],
          "properties": {
            "evidence_ref": {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
            },
            "label": {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            "source_access": { "const": "public" },
            "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_ref", "label", "source_access", "canonical_uri"],
          "properties": {
            "evidence_ref": {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
            },
            "label": {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            "source_access": { "const": "user_provided_non_public" },
            "canonical_uri": {
              "type": "string",
              "pattern": "^urn:startup-opportunity:user-provided:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        }
      ]
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content_hash"],
      "properties": {
        "ref": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef" },
        "content_hash": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "reportEvidenceDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "evidence_content_hash",
        "disposition",
        "reasons",
        "authority_bindings"
      ],
      "properties": {
        "evidence_ref": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
        },
        "evidence_content_hash": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256"
        },
        "disposition": { "enum": ["included", "limited", "excluded"] },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          }
        },
        "authority_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityBinding" }
        }
      }
    },
    "reportSourceDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reasons", "authority_bindings"],
      "properties": {
        "source": { "$ref": "../research/definitions.schema.json#/$defs/canonicalSource" },
        "source_label": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "disposition": { "enum": ["excluded", "unavailable"] },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          }
        },
        "authority_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/authorityBinding" }
        }
      },
      "oneOf": [{ "required": ["source"] }, { "required": ["source_label"] }]
    },
    "reportSubjectLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "label"],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "label": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "reportStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readable_source_count",
        "quantitative_signal_count",
        "decision_grade_quantitative_signal_count",
        "directional_or_context_quantitative_signal_count",
        "competitive_object_count",
        "full_gap_row_count",
        "critical_gap_group_count",
        "excluded_evidence_count"
      ],
      "properties": {
        "readable_source_count": { "type": "integer", "minimum": 0 },
        "quantitative_signal_count": { "type": "integer", "minimum": 0 },
        "decision_grade_quantitative_signal_count": { "type": "integer", "minimum": 0 },
        "directional_or_context_quantitative_signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "competitive_object_count": { "type": "integer", "minimum": 0 },
        "full_gap_row_count": { "type": "integer", "minimum": 0 },
        "critical_gap_group_count": { "type": "integer", "minimum": 0 },
        "excluded_evidence_count": { "type": "integer", "minimum": 0 }
      }
    },
    "fullCommercialProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercial_research_audit_refs",
        "quantitative_signal_rows",
        "competitive_substitute_rows",
        "incumbent_response_risk_rows",
        "research_coverage_gaps",
        "commercial_subject_aggregates",
        "commercial_background_material",
        "commercial_research_status"
      ],
      "properties": {
        "commercial_research_audit_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          }
        },
        "quantitative_signal_rows": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/quantitativeSignalRow"
          }
        },
        "competitive_substitute_rows": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/competitiveMatrixRow"
          }
        },
        "incumbent_response_risk_rows": {
          "type": "array",
          "items": { "$ref": "./incumbent-response-risk.schema.json#/$defs/reportRow" }
        },
        "research_coverage_gaps": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "./quantitative-competitive-research.schema.json#/$defs/coverageGapRow" },
              { "$ref": "./incumbent-response-risk.schema.json#/$defs/coverageGapRow" }
            ]
          }
        },
        "commercial_subject_aggregates": {
          "type": "array",
          "items": { "$ref": "#/$defs/commercialSubjectAggregate" }
        },
        "commercial_background_material": {
          "type": "array",
          "items": { "$ref": "#/$defs/commercialBackgroundMaterial" }
        },
        "commercial_research_status": { "$ref": "#/$defs/commercialResearchStatus" }
      }
    },
    "subjectAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "evidence_refs",
        "coverage",
        "uncovered_business_dimensions",
        "quantitative_coverage",
        "competitive_coverage",
        "wave1_signals",
        "ranking_eligibility",
        "recommendation_ceiling",
        "market_research_priority",
        "commercial_validation_readiness",
        "conflict_evidence_refs",
        "limitations"
      ],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "coverage": {
          "$ref": "./commercial-research-audit.schema.json#/properties/coverage"
        },
        "uncovered_business_dimensions": {
          "$ref": "./commercial-research-audit.schema.json#/properties/uncovered_business_dimensions"
        },
        "quantitative_coverage": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/quantitativeCoverage"
          }
        },
        "competitive_coverage": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/competitiveCoverage"
          }
        },
        "wave1_signals": {
          "$ref": "./commercial-research-audit.schema.json#/properties/wave1_signals"
        },
        "ranking_eligibility": {
          "$ref": "./commercial-research-audit.schema.json#/properties/ranking_eligibility"
        },
        "recommendation_ceiling": {
          "$ref": "./commercial-research-audit.schema.json#/$defs/recommendationCeiling"
        },
        "market_research_priority": { "$ref": "#/$defs/marketResearchPriority" },
        "commercial_validation_readiness": {
          "$ref": "#/$defs/commercialValidationReadiness"
        },
        "conflict_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "limitations": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "commercialSubjectAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "audit_refs",
        "task_refs",
        "evidence_refs",
        "coverage",
        "uncovered_business_dimensions",
        "quantitative_coverage",
        "competitive_coverage",
        "wave1_signals",
        "ranking_eligibility",
        "recommendation_ceiling",
        "market_research_priority",
        "commercial_validation_readiness",
        "conflict_evidence_refs",
        "limitations",
        "research_status",
        "execution_warning_task_refs"
      ],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "audit_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          }
        },
        "task_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "coverage": {
          "$ref": "./commercial-research-audit.schema.json#/properties/coverage"
        },
        "uncovered_business_dimensions": {
          "$ref": "./commercial-research-audit.schema.json#/properties/uncovered_business_dimensions"
        },
        "quantitative_coverage": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/quantitativeCoverage"
          }
        },
        "competitive_coverage": {
          "type": "array",
          "items": {
            "$ref": "./quantitative-competitive-research.schema.json#/$defs/competitiveCoverage"
          }
        },
        "wave1_signals": {
          "$ref": "./commercial-research-audit.schema.json#/properties/wave1_signals"
        },
        "ranking_eligibility": {
          "$ref": "./commercial-research-audit.schema.json#/properties/ranking_eligibility"
        },
        "recommendation_ceiling": {
          "$ref": "./commercial-research-audit.schema.json#/$defs/recommendationCeiling"
        },
        "market_research_priority": { "$ref": "#/$defs/marketResearchPriority" },
        "commercial_validation_readiness": {
          "$ref": "#/$defs/commercialValidationReadiness"
        },
        "conflict_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "limitations": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "research_status": {
          "enum": ["complete", "planned_with_gaps", "planned_but_missing", "not_planned"]
        },
        "execution_warning_task_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        }
      }
    },
    "marketResearchPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis_codes"],
      "properties": {
        "level": { "enum": ["high", "medium", "low"] },
        "basis_codes": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "commercialValidationReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "satisfied_dimensions", "missing_dimensions"],
      "properties": {
        "level": { "enum": ["ready", "partial", "not_ready"] },
        "satisfied_dimensions": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "missing_dimensions": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "commercialBackgroundMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_ref", "evidence_ref", "subject_binding_basis"],
      "properties": {
        "audit_ref": {
          "type": "string",
          "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "evidence_ref": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
        },
        "subject_binding_basis": { "const": "unbound" }
      }
    },
    "commercialResearchStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "planned_task_refs", "missing_task_refs", "submitted_audit_refs"],
      "properties": {
        "state": {
          "enum": ["complete", "planned_with_gaps", "planned_but_missing", "not_planned"]
        },
        "planned_task_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "missing_task_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "submitted_audit_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          }
        }
      }
    }
  }
}
