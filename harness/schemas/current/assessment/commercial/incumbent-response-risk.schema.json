{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/assessment/commercial/incumbent-response-risk.schema.json",
  "title": "Startup Opportunity Incumbent Absorption And Response Risk",
  "$defs": {
    "analysisDepth": {
      "enum": ["not_assigned", "lightweight_scan", "targeted_deep_dive"]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_depth", "assignment_role", "subject_refs", "rationale"],
      "properties": {
        "analysis_depth": { "$ref": "#/$defs/analysisDepth" },
        "assignment_role": { "enum": ["none", "owner", "independent_review"] },
        "subject_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "analysis_depth": { "const": "not_assigned" } },
            "required": ["analysis_depth"]
          },
          "then": {
            "properties": {
              "assignment_role": { "const": "none" },
              "subject_refs": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "assignment_role": { "enum": ["owner", "independent_review"] },
              "subject_refs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "assessmentLevel": {
      "enum": ["high", "medium", "low", "unknown", "not_applicable"]
    },
    "gradedAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": { "$ref": "#/$defs/assessmentLevel" },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "responseCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "operational", "compliance", "data", "distribution"],
      "properties": {
        "implementation": { "$ref": "#/$defs/gradedAssessment" },
        "operational": { "$ref": "#/$defs/gradedAssessment" },
        "compliance": { "$ref": "#/$defs/gradedAssessment" },
        "data": { "$ref": "#/$defs/gradedAssessment" },
        "distribution": { "$ref": "#/$defs/gradedAssessment" }
      }
    },
    "incentive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "drivers", "disincentives", "cannibalization", "rationale"],
      "properties": {
        "level": { "$ref": "#/$defs/assessmentLevel" },
        "drivers": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "disincentives": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "cannibalization": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "responseHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "rationale"],
      "properties": {
        "band": {
          "enum": [
            "immediate",
            "near_term",
            "medium_term",
            "long_term",
            "unknown",
            "not_applicable"
          ]
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "distributionLeverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "control_points", "rationale"],
      "properties": {
        "level": { "$ref": "#/$defs/assessmentLevel" },
        "control_points": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "thesisCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "covered_elements", "uncovered_elements", "rationale"],
      "properties": {
        "scope": {
          "enum": [
            "single_feature",
            "partial_workflow",
            "full_value_proposition",
            "unknown",
            "not_applicable"
          ]
        },
        "covered_elements": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "uncovered_elements": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "residualDifferentiation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_strength", "dimensions", "rationale"],
      "properties": {
        "overall_strength": { "$ref": "#/$defs/assessmentLevel" },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "strength", "rationale"],
            "properties": {
              "kind": {
                "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
              },
              "strength": { "$ref": "#/$defs/assessmentLevel" },
              "rationale": {
                "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "assessmentInput": {
      "oneOf": [
        { "$ref": "#/$defs/assessedInput" },
        { "$ref": "#/$defs/unknownInput" },
        { "$ref": "#/$defs/notApplicableInput" }
      ]
    },
    "assessedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "analysis_state",
        "responder_identity",
        "responder_category",
        "control_point",
        "response_modes",
        "capability_adjacency",
        "response_cost",
        "incentive",
        "plausible_response_horizon",
        "distribution_leverage",
        "thesis_coverage",
        "residual_differentiation",
        "supporting_evidence_refs",
        "opposing_evidence_refs",
        "background_evidence_refs",
        "inference_boundary",
        "confidence",
        "uncertainty",
        "unknowns",
        "data_gaps"
      ],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_state": { "const": "assessed" },
        "responder_identity": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "responder_category": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "control_point": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "response_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          }
        },
        "capability_adjacency": { "$ref": "#/$defs/gradedAssessment" },
        "response_cost": { "$ref": "#/$defs/responseCost" },
        "incentive": { "$ref": "#/$defs/incentive" },
        "plausible_response_horizon": { "$ref": "#/$defs/responseHorizon" },
        "distribution_leverage": { "$ref": "#/$defs/distributionLeverage" },
        "thesis_coverage": { "$ref": "#/$defs/thesisCoverage" },
        "residual_differentiation": { "$ref": "#/$defs/residualDifferentiation" },
        "supporting_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "opposing_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "background_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "inference_boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "uncertainty": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "unknowns": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "data_gaps": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        }
      },
      "anyOf": [
        { "properties": { "supporting_evidence_refs": { "type": "array", "minItems": 1 } } },
        { "properties": { "opposing_evidence_refs": { "type": "array", "minItems": 1 } } },
        { "properties": { "background_evidence_refs": { "type": "array", "minItems": 1 } } }
      ]
    },
    "unknownInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "analysis_state", "uncertainty", "unknowns", "data_gaps"],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_state": { "const": "unknown" },
        "uncertainty": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "unknowns": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "data_gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          }
        },
        "supporting_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "opposing_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "background_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        }
      }
    },
    "notApplicableInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "analysis_state", "rationale"],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_state": { "const": "not_applicable" },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "background_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        }
      }
    },
    "formalAssessmentSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "analysis_state",
        "responder_identity",
        "responder_category",
        "control_point",
        "response_modes",
        "capability_adjacency",
        "response_cost",
        "incentive",
        "plausible_response_horizon",
        "distribution_leverage",
        "thesis_coverage",
        "residual_differentiation",
        "supporting_evidence_refs",
        "opposing_evidence_refs",
        "background_evidence_refs",
        "inference_boundary",
        "confidence",
        "uncertainty",
        "unknowns",
        "data_gaps",
        "strategic_implication"
      ],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_state": { "enum": ["assessed", "unknown", "not_applicable"] },
        "responder_identity": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            { "type": "null" }
          ]
        },
        "responder_category": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            { "type": "null" }
          ]
        },
        "control_point": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            { "type": "null" }
          ]
        },
        "response_modes": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "capability_adjacency": { "$ref": "#/$defs/gradedAssessment" },
        "response_cost": { "$ref": "#/$defs/responseCost" },
        "incentive": { "$ref": "#/$defs/incentive" },
        "plausible_response_horizon": { "$ref": "#/$defs/responseHorizon" },
        "distribution_leverage": { "$ref": "#/$defs/distributionLeverage" },
        "thesis_coverage": { "$ref": "#/$defs/thesisCoverage" },
        "residual_differentiation": { "$ref": "#/$defs/residualDifferentiation" },
        "supporting_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "opposing_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "background_evidence_refs": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
        },
        "inference_boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "confidence": { "enum": ["high", "medium", "low", "unknown", "not_applicable"] },
        "uncertainty": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "unknowns": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "data_gaps": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "strategic_implication": {
          "const": "Reference only: use this response assessment as judgment context alongside the subject's other Evidence and synthesis; it does not prescribe pass/fail, elimination, ranking, Claim confidence, a recommendation ceiling, or publication action."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "analysis_state": { "const": "assessed" } },
            "required": ["analysis_state"]
          },
          "then": {
            "properties": {
              "responder_identity": { "type": "string", "minLength": 1 },
              "responder_category": { "type": "string", "minLength": 1 },
              "control_point": { "type": "string", "minLength": 1 },
              "response_modes": { "type": "array", "minItems": 1 },
              "confidence": { "enum": ["high", "medium", "low"] }
            },
            "anyOf": [
              { "properties": { "supporting_evidence_refs": { "type": "array", "minItems": 1 } } },
              { "properties": { "opposing_evidence_refs": { "type": "array", "minItems": 1 } } },
              { "properties": { "background_evidence_refs": { "type": "array", "minItems": 1 } } }
            ]
          }
        },
        {
          "if": {
            "properties": { "analysis_state": { "const": "unknown" } },
            "required": ["analysis_state"]
          },
          "then": {
            "properties": {
              "responder_identity": { "type": "null" },
              "responder_category": { "type": "null" },
              "control_point": { "type": "null" },
              "response_modes": { "type": "array", "maxItems": 0 },
              "capability_adjacency": {
                "type": "object",
                "properties": { "level": { "const": "unknown" } }
              },
              "response_cost": {
                "type": "object",
                "properties": {
                  "implementation": {
                    "type": "object",
                    "properties": { "level": { "const": "unknown" } }
                  },
                  "operational": {
                    "type": "object",
                    "properties": { "level": { "const": "unknown" } }
                  },
                  "compliance": {
                    "type": "object",
                    "properties": { "level": { "const": "unknown" } }
                  },
                  "data": {
                    "type": "object",
                    "properties": { "level": { "const": "unknown" } }
                  },
                  "distribution": {
                    "type": "object",
                    "properties": { "level": { "const": "unknown" } }
                  }
                }
              },
              "incentive": {
                "type": "object",
                "properties": { "level": { "const": "unknown" } }
              },
              "plausible_response_horizon": {
                "type": "object",
                "properties": { "band": { "const": "unknown" } }
              },
              "distribution_leverage": {
                "type": "object",
                "properties": { "level": { "const": "unknown" } }
              },
              "thesis_coverage": {
                "type": "object",
                "properties": { "scope": { "const": "unknown" } }
              },
              "residual_differentiation": {
                "type": "object",
                "properties": { "overall_strength": { "const": "unknown" } }
              },
              "confidence": { "const": "unknown" }
            }
          }
        },
        {
          "if": {
            "properties": { "analysis_state": { "const": "not_applicable" } },
            "required": ["analysis_state"]
          },
          "then": {
            "properties": {
              "response_modes": { "type": "array", "maxItems": 0 },
              "responder_identity": { "type": "null" },
              "responder_category": { "type": "null" },
              "control_point": { "type": "null" },
              "capability_adjacency": {
                "type": "object",
                "properties": { "level": { "const": "not_applicable" } }
              },
              "response_cost": {
                "type": "object",
                "properties": {
                  "implementation": {
                    "type": "object",
                    "properties": { "level": { "const": "not_applicable" } }
                  },
                  "operational": {
                    "type": "object",
                    "properties": { "level": { "const": "not_applicable" } }
                  },
                  "compliance": {
                    "type": "object",
                    "properties": { "level": { "const": "not_applicable" } }
                  },
                  "data": {
                    "type": "object",
                    "properties": { "level": { "const": "not_applicable" } }
                  },
                  "distribution": {
                    "type": "object",
                    "properties": { "level": { "const": "not_applicable" } }
                  }
                }
              },
              "incentive": {
                "type": "object",
                "properties": { "level": { "const": "not_applicable" } }
              },
              "plausible_response_horizon": {
                "type": "object",
                "properties": { "band": { "const": "not_applicable" } }
              },
              "distribution_leverage": {
                "type": "object",
                "properties": { "level": { "const": "not_applicable" } }
              },
              "thesis_coverage": {
                "type": "object",
                "properties": { "scope": { "const": "not_applicable" } }
              },
              "residual_differentiation": {
                "type": "object",
                "properties": { "overall_strength": { "const": "not_applicable" } }
              },
              "supporting_evidence_refs": { "type": "array", "maxItems": 0 },
              "opposing_evidence_refs": { "type": "array", "maxItems": 0 },
              "confidence": { "const": "not_applicable" }
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "analysis_depth", "semantic"],
      "properties": {
        "assessment_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_depth": {
          "enum": ["lightweight_scan", "targeted_deep_dive"]
        },
        "semantic": { "$ref": "#/$defs/formalAssessmentSemantic" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "analysis_depth",
        "assignment_role",
        "state",
        "assessment_ids",
        "reason",
        "data_gaps",
        "decision_impact",
        "automatic_effects"
      ],
      "properties": {
        "subject_id": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        "analysis_depth": { "enum": ["lightweight_scan", "targeted_deep_dive"] },
        "assignment_role": { "enum": ["owner", "independent_review"] },
        "state": { "enum": ["assessed", "unknown", "not_applicable"] },
        "assessment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
          }
        },
        "reason": {
          "anyOf": [
            { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "data_gaps": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
        },
        "decision_impact": { "const": "Context only; no automatic decision effect." },
        "automatic_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ranking_eligibility",
            "claim_confidence",
            "recommendation_ceiling",
            "artifact_publication"
          ],
          "properties": {
            "ranking_eligibility": { "const": false },
            "claim_confidence": { "const": false },
            "recommendation_ceiling": { "const": false },
            "artifact_publication": { "const": false }
          }
        }
      }
    },
    "coverageGapRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_ref", "coverage_kind", "coverage", "decision_relevance"],
      "properties": {
        "audit_ref": {
          "type": "string",
          "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "coverage_kind": { "const": "incumbent_response" },
        "decision_relevance": { "const": "context_only" },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "reportRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_ref", "assessment"],
      "properties": {
        "audit_ref": {
          "type": "string",
          "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    }
  }
}
