{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/enrichment-fan-in.schema.json",
  "title": "Startup Opportunity Enrichment Fan-in v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fan_in_id",
    "revision",
    "parent_fan_in_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "source_snapshot_ref",
    "source_merge_ref",
    "opportunity_refs",
    "branch_result_classification",
    "eligible_branch_refs",
    "evidence_refs",
    "claim_refs",
    "finding_refs",
    "insight_refs",
    "judgment_assessment_refs",
    "source_manifest_refs",
    "hard_gate_inputs",
    "opportunity_conclusion_ceilings",
    "source_group_overlap_disclosures",
    "reference_only",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.enrichment_fan_in.v1"
    },
    "fan_in_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_fan_in_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/enrichmentFanInRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "source_snapshot_ref": {
      "$ref": "./definitions.schema.json#/$defs/snapshotRef"
    },
    "source_merge_ref": {
      "$ref": "./definitions.schema.json#/$defs/mergeRef"
    },
    "opportunity_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "branch_result_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_refs",
        "partial_refs",
        "insufficient_evidence_refs",
        "failed_refs",
        "ignored_late_refs",
        "superseded_refs",
        "cancelled_unit_ids",
        "skipped_unit_ids",
        "missing_unit_ids",
        "decision_impact_of_gaps"
      ],
      "properties": {
        "completed_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "partial_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "insufficient_evidence_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "failed_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "ignored_late_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "superseded_refs": {
          "$ref": "#/$defs/branchRefs"
        },
        "cancelled_unit_ids": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "skipped_unit_ids": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "missing_unit_ids": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "decision_impact_of_gaps": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "eligible_branch_refs": {
      "$ref": "#/$defs/branchRefs"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentEvidenceRef"
      }
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentClaimRef"
      }
    },
    "finding_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentFindingRef"
      }
    },
    "insight_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentInsightRef"
      }
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentJudgmentRef"
      }
    },
    "source_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentSourceManifestRef"
      }
    },
    "hard_gate_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_ref",
          "gate_id",
          "status",
          "source_branch_refs",
          "judgment_assessment_refs",
          "limitations"
        ],
        "properties": {
          "opportunity_ref": {
            "$ref": "./definitions.schema.json#/$defs/opportunityRef"
          },
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "failed", "insufficient_evidence", "not_applicable"]
          },
          "source_branch_refs": {
            "$ref": "#/$defs/branchRefs"
          },
          "judgment_assessment_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "./definitions.schema.json#/$defs/enrichmentJudgmentRef"
            }
          },
          "limitations": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "opportunity_conclusion_ceilings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_ref",
          "decision_sufficiency",
          "conclusion_ceiling",
          "basis_branch_refs",
          "limitations"
        ],
        "properties": {
          "opportunity_ref": {
            "$ref": "./definitions.schema.json#/$defs/opportunityRef"
          },
          "decision_sufficiency": {
            "enum": ["sufficient", "partial", "insufficient"]
          },
          "conclusion_ceiling": {
            "enum": [
              "strong_candidate",
              "investigate_further",
              "watchlist",
              "reject",
              "insufficient_evidence"
            ]
          },
          "basis_branch_refs": {
            "$ref": "#/$defs/branchRefs"
          },
          "limitations": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "source_group_overlap_disclosures": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "reference_only": {
      "const": true
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/executionBoundary"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "branchRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentBranchRef"
      }
    }
  }
}
