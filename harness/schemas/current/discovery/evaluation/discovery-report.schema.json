{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/discovery-report.schema.json",
  "title": "Startup Opportunity Discovery Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_metadata",
    "decision_context_ref",
    "scope_frame_ref",
    "research_plan_ref",
    "plan_lineage_refs",
    "applied_adaptation_refs",
    "decision_recommendation_ref",
    "portfolio_view_ref",
    "comparison_refs",
    "business_engine_refs",
    "top_opportunity_refs",
    "watchlist_refs",
    "rejected_opportunity_refs",
    "capability_only_signals",
    "trend_only_signals",
    "sensitivity_ref",
    "judgment_assessment_refs",
    "source_manifest_refs",
    "commercial_research_audit_refs",
    "quantitative_signal_rows",
    "competitive_substitute_rows",
    "incumbent_response_risk_rows",
    "research_coverage_gaps",
    "commercial_subject_aggregates",
    "commercial_background_material",
    "commercial_research_status",
    "gate_warnings",
    "traceability_ref",
    "curated_judgment_context",
    "report_sections",
    "freshness_summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.report.v1"
    },
    "report_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "producer_role": {
      "const": "main_agent"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/report-json\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "report.json"
    },
    "report_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generated_at",
        "valid_as_of",
        "input_artifact_hashes",
        "external_validation_claimed",
        "global_score_used"
      ],
      "properties": {
        "mode": {
          "const": "opportunity_discovery"
        },
        "generated_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        },
        "valid_as_of": {
          "type": "string",
          "format": "date"
        },
        "input_artifact_hashes": {
          "$ref": "./definitions.schema.json#/$defs/inputHashes"
        },
        "external_validation_claimed": {
          "const": false
        },
        "global_score_used": {
          "const": false
        }
      }
    },
    "decision_context_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "plan_lineage_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/artifactRef"
      }
    },
    "applied_adaptation_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "decision_recommendation_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "portfolio_view_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "comparison_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/comparisonRef"
      }
    },
    "business_engine_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "top_opportunity_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "watchlist_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "rejected_opportunity_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "capability_only_signals": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "trend_only_signals": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "sensitivity_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentJudgmentRef"
      }
    },
    "source_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentSourceManifestRef"
      }
    },
    "commercial_research_audit_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifacts/research-audits/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
      }
    },
    "quantitative_signal_rows": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/quantitative-competitive-research.schema.json#/$defs/quantitativeSignalRow"
      }
    },
    "competitive_substitute_rows": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/quantitative-competitive-research.schema.json#/$defs/competitiveMatrixRow"
      }
    },
    "incumbent_response_risk_rows": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/incumbent-response-risk.schema.json#/$defs/reportRow"
      }
    },
    "research_coverage_gaps": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/quantitative-competitive-research.schema.json#/$defs/coverageGapRow"
      }
    },
    "commercial_subject_aggregates": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/commercial-report-projection.schema.json#/$defs/commercialSubjectAggregate"
      }
    },
    "commercial_background_material": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/commercial-report-projection.schema.json#/$defs/commercialBackgroundMaterial"
      }
    },
    "commercial_research_status": {
      "$ref": "../../assessment/commercial/commercial-report-projection.schema.json#/$defs/commercialResearchStatus"
    },
    "gate_warnings": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/commercial/quantitative-competitive-research.schema.json#/$defs/gateWarning"
      }
    },
    "traceability_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "curated_judgment_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_question",
        "current_recommendation",
        "decision_tier",
        "recommendation_meaning",
        "recommended_first_bet",
        "alternative_bets",
        "partial_order_summary",
        "decisive_support",
        "decisive_opposition",
        "critical_unknowns",
        "what_would_change_the_decision",
        "belief_update_summary",
        "valid_as_of",
        "scope_summary",
        "limitations",
        "external_action_boundary"
      ],
      "properties": {
        "decision_question": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "current_recommendation": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "decision_tier": {
          "enum": ["prioritize", "investigate_further", "watch", "reject", "insufficient_evidence"]
        },
        "recommendation_meaning": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "recommended_first_bet": {
          "anyOf": [
            {
              "$ref": "./definitions.schema.json#/$defs/opportunityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternative_bets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./definitions.schema.json#/$defs/opportunityRef"
          }
        },
        "partial_order_summary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "decisive_support": {
          "$ref": "./definitions.schema.json#/$defs/summaryRefs"
        },
        "decisive_opposition": {
          "$ref": "./definitions.schema.json#/$defs/summaryRefs"
        },
        "critical_unknowns": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "what_would_change_the_decision": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "belief_update_summary": {
          "$ref": "./definitions.schema.json#/$defs/beliefUpdate"
        },
        "valid_as_of": {
          "type": "string",
          "format": "date"
        },
        "scope_summary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "limitations": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "external_action_boundary": {
          "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
        }
      }
    },
    "report_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_summary",
        "scope_and_profile",
        "decision_recommendation",
        "portfolio",
        "comparison_and_partial_order",
        "method_and_limitations",
        "top_opportunities",
        "watchlist_and_reject",
        "sensitivity",
        "traceability_and_sources"
      ],
      "properties": {
        "conclusion_summary": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "scope_and_profile": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "decision_recommendation": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "portfolio": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "comparison_and_partial_order": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "method_and_limitations": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "top_opportunities": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "watchlist_and_reject": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "sensitivity": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "traceability_and_sources": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "freshness_summary": {
      "$ref": "./traceability.schema.json#/properties/freshness_summary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
