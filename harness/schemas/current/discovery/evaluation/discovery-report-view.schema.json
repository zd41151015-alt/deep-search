{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/discovery-report-view.schema.json",
  "title": "Startup Opportunity Discovery Report View v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_id",
    "run_id",
    "research_language",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "audit_appendix_path",
    "report_ref",
    "report_content_hash",
    "decision_recommendation_ref",
    "decision_tier",
    "recommendation_meaning",
    "recommended_first_bet",
    "alternative_bets",
    "solution_evaluations",
    "partial_order_summary",
    "decisive_supporting_refs",
    "decisive_opposing_refs",
    "valid_as_of",
    "limitations",
    "external_action_boundary",
    "section_ids",
    "markdown",
    "markdown_content_hash",
    "audit_appendix_markdown",
    "audit_appendix_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_report_view.v1"
    },
    "view_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "research_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "producer_role": {
      "const": "harness"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/report-markdown\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "report.md"
    },
    "audit_appendix_path": { "const": "audit-appendix.md" },
    "report_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "report_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "decision_recommendation_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "decision_tier": {
      "enum": ["prioritize", "investigate_further", "watch", "reject", "insufficient_evidence"]
    },
    "recommendation_meaning": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "recommended_first_bet": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/opportunityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "alternative_bets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "solution_evaluations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunitySolutionEvaluation"
      }
    },
    "partial_order_summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "decisive_supporting_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "decisive_opposing_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "external_action_boundary": {
      "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
    },
    "section_ids": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "conclusion_summary",
          "scope_and_profile",
          "decision_recommendation",
          "portfolio",
          "comparison_and_partial_order",
          "method_and_limitations",
          "quantitative_signals",
          "competitive_substitute_matrix",
          "incumbent_absorption_and_response_risk",
          "top_opportunities",
          "watchlist_and_reject",
          "sensitivity",
          "research_coverage_gaps",
          "traceability_and_sources"
        ]
      }
    },
    "markdown": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "markdown_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "audit_appendix_markdown": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "audit_appendix_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    }
  }
}
