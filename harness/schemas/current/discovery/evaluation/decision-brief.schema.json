{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/decision-brief.schema.json",
  "title": "Startup Opportunity Discovery Decision Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "run_id",
    "research_language",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_ref",
    "report_content_hash",
    "decision_recommendation_ref",
    "opportunity_family_projection",
    "decision_question",
    "decision_tier",
    "current_recommendation",
    "recommendation_meaning",
    "recommended_first_bet",
    "alternative_bets",
    "partial_order_summary",
    "decisive_supporting_refs",
    "decisive_opposing_refs",
    "critical_unknowns",
    "what_would_change_the_decision",
    "belief_update_summary",
    "valid_as_of",
    "scope_summary",
    "limitations",
    "external_action_boundary",
    "markdown",
    "markdown_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.decision_brief.discovery.current"
    },
    "brief_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "research_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "producer_role": {
      "const": "harness"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/decision-brief\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "decision-brief.md"
    },
    "report_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "report_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "decision_recommendation_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "opportunity_family_projection": {
      "$ref": "../synthesis/definitions.schema.json#/$defs/opportunityFamilyProjection"
    },
    "decision_question": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "decision_tier": {
      "enum": ["prioritize", "investigate_further", "watch", "reject", "insufficient_evidence"]
    },
    "current_recommendation": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "recommendation_meaning": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "recommended_first_bet": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/opportunityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "alternative_bets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "partial_order_summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "decisive_supporting_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "decisive_opposing_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "critical_unknowns": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "what_would_change_the_decision": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "belief_update_summary": {
      "$ref": "./definitions.schema.json#/$defs/beliefUpdate"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "scope_summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "external_action_boundary": {
      "$ref": "./definitions.schema.json#/$defs/externalActionBoundary"
    },
    "markdown": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "markdown_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    }
  }
}
