{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/insight.schema.json",
  "title": "Startup Opportunity Discovery Evaluation Insight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "insight_id",
    "run_id",
    "unit_id",
    "lineage",
    "summary",
    "finding_refs",
    "decision_impact",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.insight.discovery_evaluation.current"
    },
    "insight_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "./definitions.schema.json#/$defs/enrichmentLineage"
    },
    "summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "finding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentFindingRef"
      }
    },
    "decision_impact": {
      "enum": ["hard_gate", "comparison_panel", "sensitivity", "portfolio", "limitation"]
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
