{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/definitions.schema.json",
  "$defs": {
    "nonEmptyString": {
      "$ref": "../../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "identifier": {
      "$ref": "../../core/definitions.schema.json#/$defs/identifier"
    },
    "runId": {
      "$ref": "../../core/definitions.schema.json#/$defs/runId"
    },
    "timestamp": {
      "$ref": "../../core/definitions.schema.json#/$defs/timestamp"
    },
    "sha256": {
      "$ref": "../../core/definitions.schema.json#/$defs/sha256"
    },
    "artifactPath": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactPath"
    },
    "artifactRef": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRef"
    },
    "artifactRefArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRefArray"
    },
    "uniqueStringArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/uniqueStringArray"
    },
    "inputHashes": {
      "$ref": "../../assessment/reporting/definitions.schema.json#/$defs/inputHashes"
    },
    "beliefUpdate": {
      "$ref": "../../assessment/reporting/definitions.schema.json#/$defs/beliefUpdate"
    },
    "externalActionBoundary": {
      "$ref": "../../assessment/reporting/definitions.schema.json#/$defs/externalActionBoundary"
    },
    "evaluatorResult": {
      "$ref": "../../assessment/reporting/definitions.schema.json#/$defs/evaluatorResult"
    },
    "evaluationIssue": {
      "$ref": "../../assessment/reporting/definitions.schema.json#/$defs/evaluationIssue"
    },
    "candidateRef": {
      "$ref": "../candidates/definitions.schema.json#/$defs/candidateRef"
    },
    "opportunityRef": {
      "$ref": "../synthesis/definitions.schema.json#/$defs/opportunityRef"
    },
    "snapshotRef": {
      "$ref": "../synthesis/definitions.schema.json#/$defs/snapshotRef"
    },
    "mergeRef": {
      "$ref": "../synthesis/definitions.schema.json#/$defs/mergeRef"
    },
    "enrichmentTaskRef": {
      "type": "string",
      "pattern": "^tasks/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
    },
    "enrichmentBranchRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/enrichment/branches/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
    },
    "enrichmentFanInRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/enrichment/fan-in\\.r[1-9][0-9]*\\.json$"
    },
    "enrichmentEvidenceRef": {
      "type": "string",
      "pattern": "^evidence/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentClaimRef": {
      "type": "string",
      "pattern": "^claims/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentFindingRef": {
      "type": "string",
      "pattern": "^findings/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentInsightRef": {
      "type": "string",
      "pattern": "^insights/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentJudgmentRef": {
      "type": "string",
      "pattern": "^judgments/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentSourceManifestRef": {
      "type": "string",
      "pattern": "^evidence/discovery/enrichment/source-manifests/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "comparisonRef": {
      "type": "string",
      "pattern": "^artifacts/comparison/opportunities/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "revisionBase": {
      "$ref": "../synthesis/definitions.schema.json#/$defs/revisionBase"
    },
    "enrichmentLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ref",
        "unit_id",
        "attempt",
        "opportunity_refs",
        "source_snapshot_ref",
        "source_merge_ref",
        "scope_frame_ref",
        "research_plan_ref"
      ],
      "properties": {
        "task_ref": {
          "$ref": "#/$defs/enrichmentTaskRef"
        },
        "unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "opportunity_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opportunityRef"
          }
        },
        "source_snapshot_ref": {
          "$ref": "#/$defs/snapshotRef"
        },
        "source_merge_ref": {
          "$ref": "#/$defs/mergeRef"
        },
        "scope_frame_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "research_plan_ref": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_artifacts_explicit",
        "harness_generated_research",
        "harness_generated_judgment",
        "agent_dispatch",
        "hidden_llm_calls",
        "network_research",
        "external_validation",
        "publication_implies_validation"
      ],
      "properties": {
        "formal_artifacts_explicit": {
          "const": true
        },
        "harness_generated_research": {
          "const": false
        },
        "harness_generated_judgment": {
          "const": false
        },
        "agent_dispatch": {
          "const": false
        },
        "hidden_llm_calls": {
          "const": false
        },
        "network_research": {
          "const": false
        },
        "external_validation": {
          "const": false
        },
        "publication_implies_validation": {
          "const": false
        }
      }
    },
    "decisionSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "conclusion_ceiling",
        "insufficiency_reasons",
        "what_would_change_the_decision"
      ],
      "properties": {
        "status": {
          "enum": ["sufficient", "partial", "insufficient"]
        },
        "conclusion_ceiling": {
          "enum": [
            "strong_candidate",
            "investigate_further",
            "watchlist",
            "reject",
            "insufficient_evidence"
          ]
        },
        "insufficiency_reasons": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "what_would_change_the_decision": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "teamStartupBurdenDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "status",
        "assessment",
        "supporting_refs",
        "opposing_refs",
        "limitations"
      ],
      "properties": {
        "dimension_id": {
          "enum": [
            "startup_capital_and_build_complexity",
            "ongoing_human_delivery",
            "acquisition_and_channel_dependency",
            "compliance_data_and_professional_liability",
            "time_to_first_meaningful_validation_or_revenue"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "unavailable",
            "unknown",
            "inferred",
            "not_applicable",
            "no_evidence_found",
            "insufficient_evidence"
          ]
        },
        "assessment": { "$ref": "#/$defs/nonEmptyString" },
        "supporting_refs": { "$ref": "#/$defs/artifactRefArray" },
        "opposing_refs": { "$ref": "#/$defs/artifactRefArray" },
        "limitations": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "teamStartupBurden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_ref", "dimensions", "overall_limitations"],
      "properties": {
        "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
        "dimensions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/teamStartupBurdenDimension" }
        },
        "overall_limitations": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "teamMatchAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_ref",
        "scope_frame_ref",
        "conclusion",
        "assessment",
        "basis_condition_ids",
        "burden_dimension_ids",
        "unknown_assumptions",
        "conditions_that_would_change_conclusion",
        "limitations"
      ],
      "properties": {
        "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
        "scope_frame_ref": { "$ref": "#/$defs/artifactRef" },
        "conclusion": { "enum": ["match", "conditional", "mismatch", "unknown"] },
        "assessment": { "$ref": "#/$defs/nonEmptyString" },
        "basis_condition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "burden_dimension_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "startup_capital_and_build_complexity",
              "ongoing_human_delivery",
              "acquisition_and_channel_dependency",
              "compliance_data_and_professional_liability",
              "time_to_first_meaningful_validation_or_revenue"
            ]
          }
        },
        "unknown_assumptions": { "$ref": "#/$defs/uniqueStringArray" },
        "conditions_that_would_change_conclusion": { "$ref": "#/$defs/uniqueStringArray" },
        "limitations": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "opportunityRankingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "opportunity_ref",
        "comparison_ref",
        "team_fit_contribution",
        "rationale",
        "other_decision_factors",
        "hard_constraint_effect",
        "limitations"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
        "comparison_ref": { "$ref": "#/$defs/comparisonRef" },
        "team_fit_contribution": {
          "enum": ["supporting", "constraining", "neutral", "unknown"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "other_decision_factors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "hard_constraint_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "condition_ids", "rationale"],
          "properties": {
            "status": { "enum": ["not_applied", "applied"] },
            "condition_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "rationale": { "$ref": "#/$defs/nonEmptyString" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "applied" } },
                "required": ["status"]
              },
              "then": { "properties": { "condition_ids": { "type": "array", "minItems": 1 } } },
              "else": { "properties": { "condition_ids": { "type": "array", "maxItems": 0 } } }
            }
          ]
        },
        "limitations": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "teamDecisionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_context", "opportunity_analyses", "opportunity_ranking"],
      "properties": {
        "team_context": {
          "$ref": "../../core/team-context.schema.json#/$defs/teamContext"
        },
        "opportunity_analyses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opportunity_ref",
              "comparison_ref",
              "team_startup_burden",
              "team_match_analysis"
            ],
            "properties": {
              "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
              "comparison_ref": { "$ref": "#/$defs/comparisonRef" },
              "team_startup_burden": { "$ref": "#/$defs/teamStartupBurden" },
              "team_match_analysis": { "$ref": "#/$defs/teamMatchAnalysis" }
            }
          }
        },
        "opportunity_ranking": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opportunityRankingEntry" }
        }
      }
    },
    "summaryRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "refs"],
        "properties": {
          "summary": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "refs": {
            "$ref": "#/$defs/artifactRefArray"
          }
        }
      }
    }
  }
}
