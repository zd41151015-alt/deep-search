{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/discovery-evaluation-policy.schema.json",
  "title": "Startup Opportunity Discovery Evaluation Policy v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "eligible_branch_statuses",
    "excluded_branch_statuses",
    "required_hard_gates",
    "required_comparison_panels",
    "recommendation_ceiling",
    "ai_solution_gate_contract",
    "ai_mandatory_bundle_contract",
    "decision_tier_ceiling",
    "solution_exploration_projection_contract",
    "publication_order",
    "reporting_contract",
    "execution_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_evaluation_policy.current"
    },
    "policy_id": {
      "const": "startup_opportunity.g2_4_evaluation"
    },
    "policy_version": {
      "const": "3.0.0"
    },
    "eligible_branch_statuses": {
      "type": "array",
      "prefixItems": [
        {
          "const": "completed"
        },
        {
          "const": "partial"
        },
        {
          "const": "insufficient_evidence"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "excluded_branch_statuses": {
      "type": "array",
      "prefixItems": [
        {
          "const": "failed"
        },
        {
          "const": "ignored_late"
        },
        {
          "const": "superseded"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "required_hard_gates": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_comparison_panels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation_ceiling": {
      "type": "object"
    },
    "ai_solution_gate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_solution_field",
        "ai_usage_field",
        "mandatory_gate_id",
        "missing_bundle_status",
        "missing_bundle_decision_tier_ceiling",
        "g3_bundle_generated_by_g2"
      ],
      "properties": {
        "selected_solution_field": {
          "const": "selected_solution_ref"
        },
        "ai_usage_field": {
          "const": "uses_ai"
        },
        "mandatory_gate_id": {
          "const": "ai_mandatory_bundle"
        },
        "missing_bundle_status": {
          "const": "insufficient_evidence"
        },
        "missing_bundle_decision_tier_ceiling": {
          "const": "investigate_further"
        },
        "g3_bundle_generated_by_g2": {
          "const": false
        }
      }
    },
    "ai_mandatory_bundle_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_version",
        "required_dimensions",
        "coverage_statuses",
        "source_unavailable_status",
        "consumer_binding_statuses",
        "non_ai_binding_status",
        "degraded_bundle_states",
        "degraded_decision_tier_ceiling",
        "caller_supplied_only",
        "harness_generated_bundle"
      ],
      "properties": {
        "trigger_version": {
          "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
        },
        "required_dimensions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "capability_frontier"
            },
            {
              "const": "cost_and_deployment"
            },
            {
              "const": "workflow_and_human_boundary"
            },
            {
              "const": "ecosystem_and_platform"
            },
            {
              "const": "data_and_evaluation"
            },
            {
              "const": "adoption_and_trust"
            }
          ],
          "minItems": 6,
          "maxItems": 6,
          "items": false
        },
        "coverage_statuses": {
          "type": "array",
          "prefixItems": [
            {
              "const": "covered"
            },
            {
              "const": "insufficient_evidence"
            },
            {
              "const": "not_applicable"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "source_unavailable_status": {
          "const": "insufficient_evidence"
        },
        "consumer_binding_statuses": {
          "type": "array",
          "prefixItems": [
            {
              "const": "bound"
            },
            {
              "const": "missing"
            },
            {
              "const": "not_required"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "non_ai_binding_status": {
          "const": "not_required"
        },
        "degraded_bundle_states": {
          "type": "array",
          "prefixItems": [
            {
              "const": "missing"
            },
            {
              "const": "incomplete"
            },
            {
              "const": "desk_research_only"
            },
            {
              "const": "stale"
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        "degraded_decision_tier_ceiling": {
          "const": "investigate_further"
        },
        "caller_supplied_only": {
          "const": true
        },
        "harness_generated_bundle": {
          "const": false
        }
      }
    },
    "decision_tier_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_order",
        "first_bet_subject_scope",
        "alternative_bet_effect",
        "candidate_commercial_ceiling_required",
        "no_first_bet_strategy",
        "no_first_bet_tiers",
        "first_bet_ready_requirements",
        "mixed_inputs_use_strictest_ceiling"
      ],
      "properties": {
        "tier_order": {
          "type": "array",
          "prefixItems": [
            {
              "const": "reject"
            },
            {
              "const": "insufficient_evidence"
            },
            {
              "const": "watch"
            },
            {
              "const": "investigate_further"
            },
            {
              "const": "prioritize"
            }
          ],
          "minItems": 5,
          "maxItems": 5,
          "items": false
        },
        "first_bet_subject_scope": {
          "const": "selected_subject_only"
        },
        "alternative_bet_effect": {
          "const": "candidate_only"
        },
        "candidate_commercial_ceiling_required": {
          "const": true
        },
        "no_first_bet_strategy": {
          "const": "best_candidate_readiness"
        },
        "no_first_bet_tiers": {
          "type": "array",
          "prefixItems": [
            { "const": "investigate_further" },
            { "const": "watch" },
            { "const": "insufficient_evidence" }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "first_bet_ready_requirements": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "portfolio_first_bet_exact",
              "comparison_strong_candidate",
              "hard_gates_eligible",
              "fan_in_strong_candidate",
              "panels_sufficient",
              "ai_bundle_complete_or_not_required",
              "commercial_subject_prioritize"
            ]
          }
        },
        "mixed_inputs_use_strictest_ceiling": {
          "const": true
        }
      }
    },
    "solution_exploration_projection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_reads_exact_opportunity_summary",
        "report_projects_all_formal_solutions",
        "non_compared_selection_posture",
        "changes_demand_gate_or_ranking",
        "harness_selects_or_generates_solutions"
      ],
      "properties": {
        "comparison_reads_exact_opportunity_summary": {
          "const": true
        },
        "report_projects_all_formal_solutions": {
          "const": true
        },
        "non_compared_selection_posture": {
          "const": "provisional_implementation"
        },
        "changes_demand_gate_or_ranking": {
          "const": false
        },
        "harness_selects_or_generates_solutions": {
          "const": false
        }
      }
    },
    "publication_order": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reporting_contract": {
      "type": "object",
      "required": [
        "structured_source",
        "materialized_views",
        "consistency_required",
        "consistency_dimensions",
        "global_score_forbidden",
        "market_validation_claim_forbidden",
        "scan_contract_version",
        "scan_surfaces",
        "forbidden_rule_ids"
      ]
    },
    "execution_boundary": {
      "type": "object"
    }
  }
}
