{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/evaluation/finding.schema.json",
  "title": "Startup Opportunity Discovery Evaluation Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "unit_id",
    "lineage",
    "summary",
    "claim_refs",
    "opposing_claim_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.finding.discovery_evaluation.current"
    },
    "finding_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "./definitions.schema.json#/$defs/enrichmentLineage"
    },
    "summary": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "claim_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentClaimRef"
      }
    },
    "opposing_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/enrichmentClaimRef"
      }
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
