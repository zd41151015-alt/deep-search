{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/maps/definitions.schema.json",
  "$defs": {
    "nonEmptyString": {
      "$ref": "../../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "identifier": {
      "$ref": "../../core/definitions.schema.json#/$defs/identifier"
    },
    "runId": {
      "$ref": "../../core/definitions.schema.json#/$defs/runId"
    },
    "timestamp": {
      "$ref": "../../core/definitions.schema.json#/$defs/timestamp"
    },
    "sha256": {
      "$ref": "../../core/definitions.schema.json#/$defs/sha256"
    },
    "artifactPath": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactPath"
    },
    "artifactRef": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRef"
    },
    "artifactRefArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRefArray"
    },
    "uniqueStringArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/uniqueStringArray"
    },
    "discoveryProfile": {
      "enum": ["general", "industry_first", "ai_first", "hybrid"]
    },
    "deliveryForm": {
      "enum": [
        "native_app",
        "mini_program",
        "mobile_web",
        "PWA",
        "hybrid_app",
        "platform_native",
        "service_assisted",
        "status_quo",
        "not_applicable"
      ]
    },
    "inputHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content_hash"],
      "properties": {
        "ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/inputHash"
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "policy_schema_version", "policy_version", "content_hash"],
      "properties": {
        "policy_ref": {
          "const": "harness/policies/discovery-maps.current.json"
        },
        "policy_schema_version": {
          "const": "startup_opportunity.discovery_maps_policy.current"
        },
        "policy_version": {
          "const": "1.0.0"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_performed",
        "network_accessed",
        "seeds_are_evidence",
        "chat_is_artifact",
        "task_completion_is_artifact",
        "external_validation_claimed"
      ],
      "properties": {
        "research_performed": {
          "const": false
        },
        "network_accessed": {
          "const": false
        },
        "seeds_are_evidence": {
          "const": false
        },
        "chat_is_artifact": {
          "const": false
        },
        "task_completion_is_artifact": {
          "const": false
        },
        "external_validation_claimed": {
          "const": false
        }
      }
    },
    "seedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_id", "seed_kind", "value", "use", "evidence_use"],
      "properties": {
        "seed_id": {
          "$ref": "#/$defs/identifier"
        },
        "seed_kind": {
          "enum": [
            "direction",
            "audience",
            "scenario",
            "problem",
            "keyword",
            "product",
            "source",
            "capability",
            "model_ecosystem"
          ]
        },
        "value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "use": {
          "const": "search_entry_only"
        },
        "evidence_use": {
          "const": "forbidden"
        }
      }
    },
    "seedArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seedEntry"
      }
    },
    "researchQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_kind",
        "question",
        "decision_impact",
        "uncertainty",
        "expected_information_gain",
        "stop_condition",
        "hypothesis_status"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/identifier"
        },
        "question_kind": {
          "enum": [
            "demand",
            "workflow",
            "alternative",
            "buyer",
            "counterfactual",
            "solution",
            "ai_boundary"
          ]
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decision_impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "uncertainty": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "expected_information_gain": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "stop_condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "hypothesis_status": {
          "const": "unvalidated_question"
        }
      }
    },
    "preResearchHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "label", "status", "evidence_refs"],
      "properties": {
        "hypothesis_id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "const": "unvalidated_hypothesis"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "hypothesisArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/preResearchHypothesis"
      }
    }
  }
}
