{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/maps/opportunity-space-map.schema.json",
  "title": "Startup Opportunity Opportunity Space Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_id",
    "revision",
    "parent_map_ref",
    "run_id",
    "mode",
    "discovery_profile",
    "market",
    "language",
    "scope_frame_ref",
    "seed_probe_ref",
    "research_plan_ref",
    "demand_boundary_id",
    "solution_neutral",
    "formal_opportunity_thesis_created",
    "user_roles",
    "buyer_roles",
    "payer_roles",
    "decision_makers",
    "jobs_to_be_done",
    "workflow_maps",
    "task_operating_profiles",
    "current_alternatives",
    "baseline_options",
    "workaround_patterns",
    "workflow_friction_points",
    "non_consumption",
    "software_leverage_points",
    "state_context_opportunities",
    "buyer_purchase_language_hypotheses",
    "initial_demand_hypotheses",
    "disconfirming_questions",
    "input_artifact_hashes",
    "content_provenance",
    "policy_binding",
    "evidence_refs",
    "audit_refs",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.opportunity_space_map.v1"
    },
    "map_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "const": 1
    },
    "parent_map_ref": {
      "type": "null"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "const": "opportunity_discovery"
    },
    "discovery_profile": {
      "$ref": "./definitions.schema.json#/$defs/discoveryProfile"
    },
    "market": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "language": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "seed_probe_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "demand_boundary_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "solution_neutral": {
      "const": true
    },
    "formal_opportunity_thesis_created": {
      "const": false
    },
    "user_roles": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "buyer_roles": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "payer_roles": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "decision_makers": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "jobs_to_be_done": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "workflow_maps": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "task_operating_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "frequency",
          "volume",
          "input_modalities",
          "output_modalities",
          "variability",
          "exception_rate",
          "context_fragmentation",
          "judgment_intensity",
          "latency_tolerance",
          "error_cost",
          "human_review_tolerance",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "profile_id": {
            "$ref": "./definitions.schema.json#/$defs/identifier"
          },
          "frequency": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "volume": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "input_modalities": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          },
          "output_modalities": {
            "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
          },
          "variability": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "exception_rate": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "context_fragmentation": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "judgment_intensity": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "latency_tolerance": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "error_cost": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "human_review_tolerance": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "status": {
            "const": "unvalidated_hypothesis"
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "current_alternatives": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "baseline_options": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "workaround_patterns": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "workflow_friction_points": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "non_consumption": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "software_leverage_points": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "state_context_opportunities": {
      "$ref": "./definitions.schema.json#/$defs/hypothesisArray"
    },
    "buyer_purchase_language_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/researchQuestion"
      }
    },
    "initial_demand_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "question",
          "seed_dependency",
          "status",
          "formal_demand_thesis",
          "evidence_refs"
        ],
        "properties": {
          "hypothesis_id": {
            "$ref": "./definitions.schema.json#/$defs/identifier"
          },
          "question": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "seed_dependency": {
            "enum": ["seed_independent", "seed_expanded"]
          },
          "status": {
            "const": "unvalidated_question"
          },
          "formal_demand_thesis": {
            "const": false
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "disconfirming_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/researchQuestion"
      }
    },
    "input_artifact_hashes": {
      "$ref": "./definitions.schema.json#/$defs/inputHashes"
    },
    "research_handoff_input_hashes": {
      "$ref": "../../core/research-handoff.schema.json#/$defs/handoffBindings"
    },
    "content_provenance": {
      "$ref": "./definitions.schema.json#/$defs/contentProvenance"
    },
    "policy_binding": {
      "$ref": "./definitions.schema.json#/$defs/policyBinding"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 0
    },
    "audit_refs": {
      "type": "array",
      "maxItems": 0
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/sourceBoundary"
    },
    "limitations": {
      "allOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    }
  }
}
