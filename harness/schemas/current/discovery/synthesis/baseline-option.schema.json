{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/baseline-option.schema.json",
  "title": "Startup Opportunity Baseline Option v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "revision",
    "parent_baseline_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "discovery_fan_in_ref",
    "source_conversion_ref",
    "source_candidate_ref",
    "demand_thesis_ref",
    "current_workflow",
    "current_cost",
    "current_failure_modes",
    "switching_cost",
    "why_users_continue",
    "minimum_incremental_value_required",
    "judgment_assessment_refs",
    "audit_refs",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.baseline_option.v1"
    },
    "baseline_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_baseline_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/baselineRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/nullableHash"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "discovery_fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/fanInRef"
    },
    "source_conversion_ref": {
      "$ref": "./definitions.schema.json#/$defs/conversionRef"
    },
    "source_candidate_ref": {
      "$ref": "./definitions.schema.json#/$defs/candidateRef"
    },
    "demand_thesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/demandRef"
    },
    "current_workflow": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "current_cost": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "current_failure_modes": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "switching_cost": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "why_users_continue": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "minimum_incremental_value_required": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "judgment_assessment_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/judgmentRef"
      },
      "uniqueItems": true
    },
    "audit_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/synthesisBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_baseline_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_baseline_ref": {
            "$ref": "./definitions.schema.json#/$defs/baselineRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
