{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/discovery-synthesis-policy.schema.json",
  "title": "Startup Opportunity Discovery Synthesis Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "artifact_paths",
    "kind_target_map",
    "publication_order",
    "source_separation",
    "solution_exploration_contract",
    "concrete_pre_candidate_boundary",
    "freeze_contract",
    "merge_contract",
    "execution_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_synthesis_policy.current"
    },
    "policy_id": {
      "const": "startup_opportunity.g2_3_synthesis"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind_target_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand_seed", "baseline_seed", "solution_seed"],
      "properties": {
        "demand_seed": {
          "const": "startup_opportunity.demand_thesis.v1"
        },
        "baseline_seed": {
          "const": "startup_opportunity.baseline_option.v1"
        },
        "solution_seed": {
          "const": "startup_opportunity.solution_hypothesis.v1"
        }
      }
    },
    "publication_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_and_evaluation_distinct", "overlap_requires_disclosure"],
      "properties": {
        "generation_and_evaluation_distinct": {
          "const": true
        },
        "overlap_requires_disclosure": {
          "const": true
        }
      }
    },
    "solution_exploration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "status_is_agent_declared",
        "harness_infers_status_from_solution_count",
        "compared_requires_multiple_and_closed_baselines",
        "non_compared_selection_posture",
        "automatic_gap_or_unit_creation"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "prefixItems": [
            { "const": "compared_multiple_formal_solutions" },
            { "const": "explored_no_other_formal_solution" },
            { "const": "not_yet_explored" },
            { "const": "insufficient_evidence" },
            { "const": "not_applicable" }
          ],
          "minItems": 5,
          "maxItems": 5,
          "items": false
        },
        "status_is_agent_declared": {
          "const": true
        },
        "harness_infers_status_from_solution_count": {
          "const": false
        },
        "compared_requires_multiple_and_closed_baselines": {
          "const": true
        },
        "non_compared_selection_posture": {
          "const": "provisional_implementation"
        },
        "automatic_gap_or_unit_creation": {
          "const": false
        }
      }
    },
    "concrete_pre_candidate_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact",
        "source_disposition_required",
        "conversion_bijection",
        "formal_targets_bind_source_pre_candidate_ref",
        "source_pre_candidate_hash_required_on_conversion",
        "unretained_pre_candidates_forbidden",
        "implicit_split_merge_forbidden_in_g2_3"
      ],
      "properties": {
        "source_artifact": {
          "const": "startup_opportunity.concrete_pre_candidate.v1"
        },
        "source_disposition_required": {
          "const": "retained"
        },
        "conversion_bijection": {
          "const": true
        },
        "formal_targets_bind_source_pre_candidate_ref": {
          "const": true
        },
        "source_pre_candidate_hash_required_on_conversion": {
          "const": true
        },
        "unretained_pre_candidates_forbidden": {
          "const": true
        },
        "implicit_split_merge_forbidden_in_g2_3": {
          "const": true
        }
      }
    },
    "freeze_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_enrichment", "immutable", "revision_policy"],
      "properties": {
        "before_enrichment": {
          "const": true
        },
        "immutable": {
          "const": true
        },
        "revision_policy": {
          "const": "new_immutable_snapshot_revision_required"
        }
      }
    },
    "merge_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_frozen_theses_classified_once",
        "title_similarity_only_forbidden",
        "semantic_dimensions",
        "preserve_diversity"
      ],
      "properties": {
        "all_frozen_theses_classified_once": {
          "const": true
        },
        "title_similarity_only_forbidden": {
          "const": true
        },
        "semantic_dimensions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preserve_diversity": {
          "const": true
        }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_artifacts_only",
        "harness_synthesizes_semantics",
        "harness_dispatches_agent",
        "hidden_llm_calls",
        "network_research",
        "external_validation",
        "publication_implies_validation"
      ],
      "properties": {
        "explicit_artifacts_only": {
          "const": true
        },
        "harness_synthesizes_semantics": {
          "const": false
        },
        "harness_dispatches_agent": {
          "const": false
        },
        "hidden_llm_calls": {
          "const": false
        },
        "network_research": {
          "const": false
        },
        "external_validation": {
          "const": false
        },
        "publication_implies_validation": {
          "const": false
        }
      }
    }
  }
}
