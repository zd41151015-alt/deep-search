{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/definitions.schema.json",
  "$defs": {
    "nonEmptyString": {
      "$ref": "../../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "identifier": {
      "$ref": "../../core/definitions.schema.json#/$defs/identifier"
    },
    "runId": {
      "$ref": "../../core/definitions.schema.json#/$defs/runId"
    },
    "timestamp": {
      "$ref": "../../core/definitions.schema.json#/$defs/timestamp"
    },
    "sha256": {
      "$ref": "../../core/definitions.schema.json#/$defs/sha256"
    },
    "artifactPath": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactPath"
    },
    "artifactRef": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRef"
    },
    "artifactRefArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRefArray"
    },
    "uniqueStringArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/uniqueStringArray"
    },
    "discoveryProfile": {
      "$ref": "../maps/definitions.schema.json#/$defs/discoveryProfile"
    },
    "deliveryForm": {
      "$ref": "../maps/definitions.schema.json#/$defs/deliveryForm"
    },
    "candidateRef": {
      "$ref": "../candidates/definitions.schema.json#/$defs/candidateRef"
    },
    "fanInRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/fan-in\\.r[1-9][0-9]*\\.json$"
    },
    "conversionRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/conversions/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "demandRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/demands/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "baselineRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/baselines/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "solutionRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/solutions/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "solutionEvaluationRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/solution-evaluations/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "opportunityRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/opportunities/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/thesis-snapshots/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "mergeRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/merges/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "opportunityFamilyKnowledgeState": {
      "enum": [
        "declared",
        "partial",
        "unavailable",
        "unknown",
        "inferred",
        "not_applicable",
        "no_evidence_found"
      ]
    },
    "opportunityFamilyEvidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supporting_refs",
        "opposing_refs",
        "background_refs",
        "unknown_refs",
        "limitations",
        "unresolved_questions"
      ],
      "properties": {
        "supporting_refs": { "$ref": "#/$defs/artifactRefArray" },
        "opposing_refs": { "$ref": "#/$defs/artifactRefArray" },
        "background_refs": { "$ref": "#/$defs/artifactRefArray" },
        "unknown_refs": { "$ref": "#/$defs/artifactRefArray" },
        "limitations": { "$ref": "#/$defs/uniqueStringArray" },
        "unresolved_questions": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "opportunityFamilyMemberDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunity_ref", "dimensions"],
      "properties": {
        "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "state", "description"],
            "properties": {
              "dimension": {
                "enum": [
                  "user",
                  "job_to_be_done",
                  "entry_scene",
                  "buyer",
                  "acquisition",
                  "compliance",
                  "delivery_boundary",
                  "other"
                ]
              },
              "state": { "$ref": "#/$defs/opportunityFamilyKnowledgeState" },
              "description": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "opportunityFamilyDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "title",
        "family_relation",
        "members",
        "shared_value_or_solution_mechanism",
        "shared_assumptions",
        "shared_failure_risks",
        "member_specific_differences",
        "evidence_basis"
      ],
      "properties": {
        "family_id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "family_relation": {
          "enum": ["independent_opportunity", "shared_opportunity_family", "unknown"]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["opportunity_ref", "relation_to_family"],
            "properties": {
              "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
              "relation_to_family": {
                "enum": [
                  "independent_opportunity",
                  "segment_variant",
                  "delivery_or_implementation_variant",
                  "unknown"
                ]
              }
            }
          }
        },
        "shared_value_or_solution_mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "description"],
          "properties": {
            "state": { "$ref": "#/$defs/opportunityFamilyKnowledgeState" },
            "description": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "shared_assumptions": { "$ref": "#/$defs/uniqueStringArray" },
        "shared_failure_risks": { "$ref": "#/$defs/uniqueStringArray" },
        "member_specific_differences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/opportunityFamilyMemberDifference" }
        },
        "evidence_basis": { "$ref": "#/$defs/opportunityFamilyEvidenceBasis" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "family_relation": { "const": "independent_opportunity" } },
            "required": ["family_relation"]
          },
          "then": {
            "properties": {
              "members": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "relation_to_family": { "const": "independent_opportunity" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "family_relation": { "const": "shared_opportunity_family" } },
            "required": ["family_relation"]
          },
          "then": {
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "relation_to_family": {
                      "enum": ["segment_variant", "delivery_or_implementation_variant"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "family_relation": { "const": "unknown" } },
            "required": ["family_relation"]
          },
          "then": {
            "properties": {
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "relation_to_family": { "const": "unknown" } }
                }
              }
            }
          }
        }
      ]
    },
    "opportunityFamilyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_merge_ref",
        "source_merge_content_hash",
        "independent_opportunity_family_count",
        "concrete_direction_count",
        "unknown_family_relation_count",
        "families"
      ],
      "properties": {
        "source_merge_ref": { "$ref": "#/$defs/mergeRef" },
        "source_merge_content_hash": { "$ref": "#/$defs/sha256" },
        "independent_opportunity_family_count": { "type": "integer", "minimum": 0 },
        "concrete_direction_count": { "type": "integer", "minimum": 1 },
        "unknown_family_relation_count": { "type": "integer", "minimum": 0 },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family_id",
              "title",
              "family_relation",
              "shared_value_or_solution_mechanism",
              "shared_assumptions",
              "shared_failure_risks",
              "member_specific_differences",
              "evidence_basis",
              "members"
            ],
            "properties": {
              "family_id": { "$ref": "#/$defs/identifier" },
              "title": { "$ref": "#/$defs/nonEmptyString" },
              "family_relation": {
                "enum": ["independent_opportunity", "shared_opportunity_family", "unknown"]
              },
              "shared_value_or_solution_mechanism": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "description"],
                "properties": {
                  "state": { "$ref": "#/$defs/opportunityFamilyKnowledgeState" },
                  "description": { "$ref": "#/$defs/nonEmptyString" }
                }
              },
              "shared_assumptions": { "$ref": "#/$defs/uniqueStringArray" },
              "shared_failure_risks": { "$ref": "#/$defs/uniqueStringArray" },
              "member_specific_differences": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/opportunityFamilyMemberDifference" }
              },
              "evidence_basis": { "$ref": "#/$defs/opportunityFamilyEvidenceBasis" },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "opportunity_ref",
                    "opportunity_content_hash",
                    "opportunity_title",
                    "relation_to_family",
                    "selected_solution_ref",
                    "selected_solution_content_hash",
                    "uses_ai",
                    "solution_type",
                    "delivery_form"
                  ],
                  "properties": {
                    "opportunity_ref": { "$ref": "#/$defs/opportunityRef" },
                    "opportunity_content_hash": { "$ref": "#/$defs/sha256" },
                    "opportunity_title": { "$ref": "#/$defs/nonEmptyString" },
                    "relation_to_family": {
                      "enum": [
                        "independent_opportunity",
                        "segment_variant",
                        "delivery_or_implementation_variant",
                        "unknown"
                      ]
                    },
                    "selected_solution_ref": { "$ref": "#/$defs/solutionRef" },
                    "selected_solution_content_hash": { "$ref": "#/$defs/sha256" },
                    "uses_ai": { "type": "boolean" },
                    "solution_type": { "$ref": "#/$defs/nonEmptyString" },
                    "delivery_form": { "$ref": "#/$defs/deliveryForm" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "nullableParent": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_source_manifest_refs",
        "evaluation_source_manifest_refs",
        "overlap_disclosures"
      ],
      "properties": {
        "generation_source_manifest_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/sourceManifestRef"
          }
        },
        "evaluation_source_manifest_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/sourceManifestRef"
          }
        },
        "overlap_disclosures": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "synthesisBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_candidate_mutated",
        "conversion_is_evidence",
        "publication_implies_validation",
        "external_validation_success_claimed",
        "harness_generated_research",
        "hidden_llm_calls"
      ],
      "properties": {
        "source_candidate_mutated": {
          "const": false
        },
        "conversion_is_evidence": {
          "const": false
        },
        "publication_implies_validation": {
          "const": false
        },
        "external_validation_success_claimed": {
          "const": false
        },
        "harness_generated_research": {
          "const": false
        },
        "hidden_llm_calls": {
          "const": false
        }
      }
    },
    "revisionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "parent_ref", "parent_content_hash"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parent_ref": {
          "$ref": "#/$defs/nullableParent"
        },
        "parent_content_hash": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    }
  }
}
