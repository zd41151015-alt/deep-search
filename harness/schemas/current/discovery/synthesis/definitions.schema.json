{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/definitions.schema.json",
  "$defs": {
    "nonEmptyString": {
      "$ref": "../../core/definitions.schema.json#/$defs/nonEmptyString"
    },
    "identifier": {
      "$ref": "../../core/definitions.schema.json#/$defs/identifier"
    },
    "runId": {
      "$ref": "../../core/definitions.schema.json#/$defs/runId"
    },
    "timestamp": {
      "$ref": "../../core/definitions.schema.json#/$defs/timestamp"
    },
    "sha256": {
      "$ref": "../../core/definitions.schema.json#/$defs/sha256"
    },
    "artifactPath": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactPath"
    },
    "artifactRef": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRef"
    },
    "artifactRefArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/artifactRefArray"
    },
    "uniqueStringArray": {
      "$ref": "../../core/definitions.schema.json#/$defs/uniqueStringArray"
    },
    "discoveryProfile": {
      "$ref": "../maps/definitions.schema.json#/$defs/discoveryProfile"
    },
    "deliveryForm": {
      "$ref": "../maps/definitions.schema.json#/$defs/deliveryForm"
    },
    "candidateRef": {
      "$ref": "../candidates/definitions.schema.json#/$defs/candidateRef"
    },
    "fanInRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/fan-in\\.r[1-9][0-9]*\\.json$"
    },
    "conversionRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/conversions/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "demandRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/demands/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "baselineRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/baselines/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "solutionRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/solutions/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "solutionEvaluationRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/solution-evaluations/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "opportunityRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/opportunities/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/thesis-snapshots/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "mergeRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/merges/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "solutionExplorationStatus": {
      "enum": [
        "compared_multiple_formal_solutions",
        "explored_no_other_formal_solution",
        "not_yet_explored",
        "insufficient_evidence",
        "not_applicable"
      ]
    },
    "solutionSelectionPosture": {
      "enum": ["compared_selection", "provisional_implementation"]
    },
    "formalMaterialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "content_hash"],
      "properties": {
        "ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "consideredApproach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach_id",
        "implementation_direction",
        "disposition",
        "disposition_reasons",
        "material_bindings",
        "unknowns",
        "limitations"
      ],
      "properties": {
        "approach_id": {
          "$ref": "#/$defs/identifier"
        },
        "implementation_direction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "disposition": {
          "enum": ["not_formalized", "not_retained_as_formal_solution"]
        },
        "disposition_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "material_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/formalMaterialBinding"
          }
        },
        "unknowns": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "limitations": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "rejectedSolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_ref", "reasons", "judgment_assessment_refs"],
      "properties": {
        "solution_ref": {
          "$ref": "#/$defs/solutionRef"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "judgment_assessment_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/judgmentRef"
          }
        }
      }
    },
    "formalSolutionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_ref",
        "solution_content_hash",
        "disposition",
        "solution_id",
        "solution_type",
        "solution_behavior",
        "delivery_form",
        "uses_ai"
      ],
      "properties": {
        "solution_ref": { "$ref": "#/$defs/solutionRef" },
        "solution_content_hash": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["selected", "alternative", "rejected"] },
        "solution_id": { "$ref": "#/$defs/identifier" },
        "solution_type": { "$ref": "#/$defs/nonEmptyString" },
        "solution_behavior": { "$ref": "#/$defs/nonEmptyString" },
        "delivery_form": { "$ref": "#/$defs/deliveryForm" },
        "uses_ai": { "type": "boolean" }
      }
    },
    "solutionEvaluationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_evaluation_ref",
        "solution_evaluation_content_hash",
        "exploration_status",
        "selection_posture",
        "status_rationale",
        "formal_solution_refs",
        "formal_solutions",
        "selected_solution_ref",
        "alternative_solution_refs",
        "rejected_solutions",
        "considered_approaches",
        "critical_unknowns",
        "limitations"
      ],
      "properties": {
        "solution_evaluation_ref": {
          "$ref": "#/$defs/solutionEvaluationRef"
        },
        "solution_evaluation_content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "exploration_status": {
          "$ref": "#/$defs/solutionExplorationStatus"
        },
        "selection_posture": {
          "$ref": "#/$defs/solutionSelectionPosture"
        },
        "status_rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "formal_solution_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/solutionRef"
          }
        },
        "formal_solutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/formalSolutionProjection" }
        },
        "selected_solution_ref": {
          "$ref": "#/$defs/solutionRef"
        },
        "alternative_solution_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/solutionRef"
          }
        },
        "rejected_solutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejectedSolution"
          }
        },
        "considered_approaches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consideredApproach"
          }
        },
        "critical_unknowns": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "limitations": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "nullableParent": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_source_manifest_refs",
        "evaluation_source_manifest_refs",
        "overlap_disclosures"
      ],
      "properties": {
        "generation_source_manifest_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/sourceManifestRef"
          }
        },
        "evaluation_source_manifest_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/sourceManifestRef"
          }
        },
        "overlap_disclosures": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    },
    "synthesisBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_candidate_mutated",
        "conversion_is_evidence",
        "publication_implies_validation",
        "external_validation_success_claimed",
        "harness_generated_research",
        "hidden_llm_calls"
      ],
      "properties": {
        "source_candidate_mutated": {
          "const": false
        },
        "conversion_is_evidence": {
          "const": false
        },
        "publication_implies_validation": {
          "const": false
        },
        "external_validation_success_claimed": {
          "const": false
        },
        "harness_generated_research": {
          "const": false
        },
        "hidden_llm_calls": {
          "const": false
        }
      }
    },
    "revisionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "parent_ref", "parent_content_hash"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parent_ref": {
          "$ref": "#/$defs/nullableParent"
        },
        "parent_content_hash": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    }
  }
}
