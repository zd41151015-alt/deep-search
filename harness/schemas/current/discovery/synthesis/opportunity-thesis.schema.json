{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/opportunity-thesis.schema.json",
  "title": "Startup Opportunity Opportunity Thesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "opportunity_id",
    "revision",
    "parent_opportunity_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "discovery_fan_in_ref",
    "title",
    "description",
    "opportunity_thesis",
    "discovery_profile",
    "research_axes",
    "demand_thesis_ref",
    "selected_solution_ref",
    "alternative_solution_refs",
    "baseline_option_ref",
    "solution_evaluation_ref",
    "solution_evaluation_summary",
    "selected_delivery_form",
    "incremental_value_over_baseline",
    "mental_positioning",
    "mental_position_occupation",
    "trigger_phrase",
    "entry_scene",
    "job_to_be_done",
    "buyer",
    "payer",
    "decision_maker",
    "buyer_purchase_language",
    "marketing_bridge",
    "beachhead_segment",
    "entry_wedge",
    "why_now",
    "initial_distribution_channels",
    "value_layer",
    "user_state_context_model",
    "natural_restatement_test",
    "source_lanes",
    "supporting_insight_refs",
    "opposing_claim_refs",
    "judgment_assessment_refs",
    "audit_refs",
    "risks",
    "kill_criteria",
    "comparison_ref",
    "decision_recommendation_ref",
    "lifecycle_status",
    "valid_as_of",
    "freshness_policy",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.opportunity_thesis.v1"
    },
    "opportunity_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_opportunity_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/opportunityRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/nullableHash"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "research_handoff_input_hashes": {
      "$ref": "../../core/research-handoff.schema.json#/$defs/handoffBindings"
    },
    "discovery_fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/fanInRef"
    },
    "title": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "description": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "opportunity_thesis": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "discovery_profile": {
      "$ref": "./definitions.schema.json#/$defs/discoveryProfile"
    },
    "research_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "demand_thesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/demandRef"
    },
    "selected_solution_ref": {
      "$ref": "./definitions.schema.json#/$defs/solutionRef"
    },
    "alternative_solution_refs": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/solutionRef"
      },
      "uniqueItems": true
    },
    "baseline_option_ref": {
      "$ref": "./definitions.schema.json#/$defs/baselineRef"
    },
    "solution_evaluation_ref": {
      "$ref": "./definitions.schema.json#/$defs/solutionEvaluationRef"
    },
    "solution_evaluation_summary": {
      "$ref": "./definitions.schema.json#/$defs/solutionEvaluationSummary"
    },
    "selected_delivery_form": {
      "$ref": "./definitions.schema.json#/$defs/deliveryForm"
    },
    "incremental_value_over_baseline": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "mental_positioning": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "mental_position_occupation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "occupied_by", "white_space", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["unoccupied", "partially_occupied", "occupied", "unknown"]
        },
        "occupied_by": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "white_space": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "../candidates/definitions.schema.json#/$defs/evidenceRef"
          },
          "uniqueItems": true
        }
      }
    },
    "trigger_phrase": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "entry_scene": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "job_to_be_done": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "buyer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "payer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "decision_maker": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "buyer_purchase_language": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "marketing_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_trigger_phrase", "buyer_purchase_phrase", "decision_criteria"],
      "properties": {
        "user_trigger_phrase": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "buyer_purchase_phrase": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "decision_criteria": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "beachhead_segment": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "entry_wedge": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "why_now": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "initial_distribution_channels": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "value_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "output_value", "workflow_value", "outcome_metrics"],
      "properties": {
        "primary": {
          "enum": ["output", "workflow", "workflow_outcome", "unknown"]
        },
        "output_value": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "workflow_value": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "outcome_metrics": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "user_state_context_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_variables",
        "context_sources",
        "state_update_triggers",
        "feedback_or_ground_truth",
        "retention_boundary",
        "privacy_permission_boundary",
        "deletion_export_boundary"
      ],
      "properties": {
        "state_variables": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "context_sources": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "state_update_triggers": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "feedback_or_ground_truth": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "retention_boundary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "privacy_permission_boundary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "deletion_export_boundary": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "natural_restatement_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "test_prompt",
        "target_user",
        "expected_restatement",
        "success_signal",
        "failure_signal",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "status": {
          "const": "not_tested"
        },
        "test_prompt": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "target_user": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "expected_restatement": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "success_signal": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "failure_signal": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 0
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "source_lanes": {
      "$ref": "../candidates/definitions.schema.json#/$defs/discoveryLaneResultRefArray"
    },
    "supporting_insight_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/insightRef"
      },
      "uniqueItems": true
    },
    "opposing_claim_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/claimRef"
      },
      "uniqueItems": true
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/judgmentRef"
      },
      "uniqueItems": true
    },
    "audit_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "risks": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "kill_criteria": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "comparison_ref": {
      "type": "null"
    },
    "decision_recommendation_ref": {
      "type": "null"
    },
    "lifecycle_status": {
      "const": "proposed"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "freshness_policy": {
      "const": "revalidate_when_decisive_evidence_expires"
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/synthesisBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_opportunity_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_opportunity_ref": {
            "$ref": "./definitions.schema.json#/$defs/opportunityRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
