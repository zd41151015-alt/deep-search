{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/solution-evaluation.schema.json",
  "title": "Startup Opportunity Solution Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "revision",
    "parent_evaluation_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "discovery_fan_in_ref",
    "demand_thesis_ref",
    "baseline_option_ref",
    "solution_hypothesis_refs",
    "selected_solution_ref",
    "alternative_solution_refs",
    "rejected_solutions",
    "solution_exploration",
    "baseline_comparisons",
    "solution_rationale",
    "critical_unknowns",
    "capability_only_signals",
    "source_groups",
    "decision_sufficiency",
    "judgment_assessment_refs",
    "audit_refs",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.solution_evaluation.v1"
    },
    "evaluation_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_evaluation_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/solutionEvaluationRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/nullableHash"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "discovery_fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/fanInRef"
    },
    "demand_thesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/demandRef"
    },
    "baseline_option_ref": {
      "$ref": "./definitions.schema.json#/$defs/baselineRef"
    },
    "solution_hypothesis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/solutionRef"
      }
    },
    "selected_solution_ref": {
      "$ref": "./definitions.schema.json#/$defs/solutionRef"
    },
    "alternative_solution_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./definitions.schema.json#/$defs/solutionRef"
      }
    },
    "rejected_solutions": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/rejectedSolution"
      }
    },
    "solution_exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "status_rationale", "considered_approaches"],
      "properties": {
        "status": {
          "$ref": "./definitions.schema.json#/$defs/solutionExplorationStatus"
        },
        "status_rationale": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "considered_approaches": {
          "type": "array",
          "items": {
            "$ref": "./definitions.schema.json#/$defs/consideredApproach"
          }
        }
      }
    },
    "baseline_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["solution_ref", "incremental_value", "migration_cost", "decision"],
        "properties": {
          "solution_ref": {
            "$ref": "./definitions.schema.json#/$defs/solutionRef"
          },
          "incremental_value": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "migration_cost": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          },
          "decision": {
            "enum": ["selected", "alternative", "rejected"]
          }
        }
      }
    },
    "solution_rationale": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "critical_unknowns": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "capability_only_signals": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "source_groups": {
      "$ref": "./definitions.schema.json#/$defs/sourceGroups"
    },
    "decision_sufficiency": {
      "enum": ["sufficient_for_thesis", "insufficient_evidence", "blocked"]
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/judgmentRef"
      },
      "uniqueItems": true
    },
    "audit_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/synthesisBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_evaluation_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_evaluation_ref": {
            "$ref": "./definitions.schema.json#/$defs/solutionEvaluationRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution_exploration": {
            "type": "object",
            "properties": {
              "status": {
                "const": "compared_multiple_formal_solutions"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["solution_exploration"]
      },
      "then": {
        "properties": {
          "solution_hypothesis_refs": {
            "type": "array",
            "minItems": 2
          },
          "decision_sufficiency": {
            "const": "sufficient_for_thesis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution_exploration": {
            "type": "object",
            "properties": {
              "status": {
                "const": "explored_no_other_formal_solution"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["solution_exploration"]
      },
      "then": {
        "properties": {
          "solution_hypothesis_refs": {
            "type": "array",
            "maxItems": 1
          },
          "solution_exploration": {
            "type": "object",
            "properties": {
              "considered_approaches": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution_exploration": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not_yet_explored"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["solution_exploration"]
      },
      "then": {
        "properties": {
          "solution_exploration": {
            "type": "object",
            "properties": {
              "considered_approaches": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solution_exploration": {
            "type": "object",
            "properties": {
              "status": {
                "const": "insufficient_evidence"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["solution_exploration"]
      },
      "then": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient_evidence", "blocked"]
          },
          "critical_unknowns": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
