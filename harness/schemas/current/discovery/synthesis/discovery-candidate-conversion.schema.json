{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/discovery-candidate-conversion.schema.json",
  "title": "Startup Opportunity Executable Discovery Candidate Conversion v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversion_id",
    "revision",
    "parent_conversion_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "source_candidate_ref",
    "source_candidate_schema_version",
    "source_candidate_kind",
    "source_candidate_revision",
    "source_candidate_content_hash",
    "source_pre_candidate_ref",
    "source_pre_candidate_revision",
    "source_pre_candidate_content_hash",
    "discovery_fan_in_ref",
    "target_schema_version",
    "target_artifact_ref",
    "target_content_hash",
    "promotion_preconditions",
    "conversion_status",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_candidate_conversion.v2"
    },
    "conversion_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_conversion_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/conversionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/nullableHash"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "source_candidate_ref": {
      "$ref": "./definitions.schema.json#/$defs/candidateRef"
    },
    "source_candidate_schema_version": {
      "const": "startup_opportunity.discovery_candidate.v1"
    },
    "source_candidate_kind": {
      "$ref": "../candidates/definitions.schema.json#/$defs/candidateKind"
    },
    "source_candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_candidate_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "source_pre_candidate_ref": {
      "$ref": "./definitions.schema.json#/$defs/concretePreCandidateRef"
    },
    "source_pre_candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_pre_candidate_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "discovery_fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/fanInRef"
    },
    "target_schema_version": {
      "enum": [
        "startup_opportunity.demand_thesis.v1",
        "startup_opportunity.baseline_option.v1",
        "startup_opportunity.solution_hypothesis.v1"
      ]
    },
    "target_artifact_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "target_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "promotion_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_candidate_is_current_revision",
        "source_candidate_is_retained",
        "typed_evidence_lineage_valid",
        "decision_sufficiency_satisfied",
        "target_schema_installed",
        "conversion_evaluator_installed",
        "promotion_authorized"
      ],
      "properties": {
        "source_candidate_is_current_revision": {
          "const": true
        },
        "source_candidate_is_retained": {
          "const": true
        },
        "typed_evidence_lineage_valid": {
          "const": true
        },
        "decision_sufficiency_satisfied": {
          "const": true
        },
        "target_schema_installed": {
          "const": true
        },
        "conversion_evaluator_installed": {
          "const": true
        },
        "promotion_authorized": {
          "const": true
        }
      }
    },
    "conversion_status": {
      "const": "promoted_to_formal_artifact"
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/synthesisBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_conversion_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_conversion_ref": {
            "$ref": "./definitions.schema.json#/$defs/conversionRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
