{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/synthesis/solution-hypothesis.schema.json",
  "title": "Startup Opportunity Solution Hypothesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "solution_id",
    "revision",
    "parent_solution_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "discovery_fan_in_ref",
    "source_conversion_ref",
    "source_candidate_ref",
    "demand_thesis_ref",
    "baseline_option_ref",
    "selected",
    "delivery_form",
    "solution_type",
    "uses_ai",
    "solution_behavior",
    "workflow_change",
    "required_capabilities",
    "capability_evidence_refs",
    "incremental_value_over_baseline",
    "market_motion",
    "acquisition_motion",
    "buyer_model",
    "payment_mode",
    "expected_outcomes",
    "risks",
    "kill_criteria",
    "supporting_claim_refs",
    "opposing_claim_refs",
    "judgment_assessment_refs",
    "audit_refs",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.solution_hypothesis.v1"
    },
    "solution_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_solution_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/solutionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/nullableHash"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "discovery_fan_in_ref": {
      "$ref": "./definitions.schema.json#/$defs/fanInRef"
    },
    "source_conversion_ref": {
      "$ref": "./definitions.schema.json#/$defs/conversionRef"
    },
    "source_candidate_ref": {
      "$ref": "./definitions.schema.json#/$defs/candidateRef"
    },
    "demand_thesis_ref": {
      "$ref": "./definitions.schema.json#/$defs/demandRef"
    },
    "baseline_option_ref": {
      "$ref": "./definitions.schema.json#/$defs/baselineRef"
    },
    "selected": {
      "const": false
    },
    "delivery_form": {
      "$ref": "./definitions.schema.json#/$defs/deliveryForm"
    },
    "solution_type": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "uses_ai": {
      "type": "boolean"
    },
    "solution_behavior": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "workflow_change": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "required_capabilities": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "capability_evidence_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "incremental_value_over_baseline": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "market_motion": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "acquisition_motion": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "buyer_model": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "payment_mode": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "expected_outcomes": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "risks": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "kill_criteria": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "supporting_claim_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/claimRef"
      },
      "uniqueItems": true
    },
    "opposing_claim_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/claimRef"
      },
      "uniqueItems": true
    },
    "judgment_assessment_refs": {
      "type": "array",
      "items": {
        "$ref": "../candidates/definitions.schema.json#/$defs/judgmentRef"
      },
      "uniqueItems": true
    },
    "audit_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "source_boundary": {
      "$ref": "./definitions.schema.json#/$defs/synthesisBoundary"
    },
    "limitations": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_solution_ref": {
            "type": "null"
          },
          "parent_content_hash": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_solution_ref": {
            "$ref": "./definitions.schema.json#/$defs/solutionRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
