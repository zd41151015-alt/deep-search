{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/candidates/judgment-assessment.schema.json",
  "title": "Startup Opportunity Discovery Candidate Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "unit_id",
    "lineage",
    "judgment_id",
    "subject_ref",
    "dimension",
    "judgment_signal",
    "evidence_tier_summary",
    "supporting_refs",
    "opposing_refs",
    "representativeness",
    "independence",
    "decision_sufficiency",
    "insufficiency_reasons",
    "what_would_change_the_decision",
    "valid_as_of",
    "limitations",
    "validation_success_claimed"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.judgment_assessment.discovery_candidate.current"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "./definitions.schema.json#/$defs/discoveryLineage"
    },
    "judgment_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "subject_ref": {
      "$ref": "./definitions.schema.json#/$defs/candidateRef"
    },
    "dimension": {
      "enum": [
        "demand_signal",
        "workflow_and_loss",
        "baseline_failure",
        "migration_signal",
        "buyer_signal",
        "source_independence",
        "counter_evidence",
        "candidate_diversity",
        "solution_incremental_value"
      ]
    },
    "judgment_signal": {
      "enum": ["supported", "opposed", "mixed", "no_signal", "source_unavailable"]
    },
    "evidence_tier_summary": {
      "type": "array",
      "items": {
        "$ref": "../../assessment/core/definitions.schema.json#/$defs/evidenceTier"
      },
      "uniqueItems": true
    },
    "supporting_refs": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "opposing_refs": {
      "type": "array",
      "items": {
        "$ref": "./definitions.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "representativeness": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "independence": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "decision_sufficiency": {
      "enum": ["sufficient_for_triage", "insufficient", "blocked"]
    },
    "insufficiency_reasons": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "what_would_change_the_decision": {
      "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "limitations": {
      "allOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "validation_success_claimed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "supported"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "supporting_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "opposed"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "opposing_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "mixed"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "supporting_refs": {
            "type": "array",
            "minItems": 1
          },
          "opposing_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient", "blocked"]
          }
        },
        "required": ["decision_sufficiency"]
      },
      "then": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
