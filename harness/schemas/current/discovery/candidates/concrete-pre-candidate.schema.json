{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/candidates/concrete-pre-candidate.schema.json",
  "title": "Startup Opportunity Concrete Pre-candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pre_candidate_id",
    "revision",
    "parent_pre_candidate_ref",
    "parent_content_hash",
    "run_id",
    "mode",
    "phase",
    "owner_role",
    "scope_frame_ref",
    "research_plan_ref",
    "formation",
    "seed_bindings",
    "lane_result_bindings",
    "triage_profile",
    "material_dispositions",
    "materialization_rationale",
    "pre_formal_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concrete_pre_candidate.v1"
    },
    "pre_candidate_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_pre_candidate_ref": {
      "anyOf": [
        { "$ref": "./definitions.schema.json#/$defs/concretePreCandidateRef" },
        { "type": "null" }
      ]
    },
    "parent_content_hash": {
      "anyOf": [{ "$ref": "./definitions.schema.json#/$defs/sha256" }, { "type": "null" }]
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "const": "opportunity_discovery"
    },
    "phase": {
      "const": "discovery"
    },
    "owner_role": {
      "const": "main_agent"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "formation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_kind", "relationship_group_id"],
      "properties": {
        "relationship_kind": {
          "enum": ["direct", "split", "merge"]
        },
        "relationship_group_id": {
          "anyOf": [{ "$ref": "./definitions.schema.json#/$defs/identifier" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "relationship_kind": { "const": "direct" } },
            "required": ["relationship_kind"]
          },
          "then": {
            "properties": { "relationship_group_id": { "type": "null" } }
          },
          "else": {
            "properties": {
              "relationship_group_id": {
                "$ref": "./definitions.schema.json#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "seed_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/seedBinding" }
    },
    "lane_result_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/laneResultBinding" }
    },
    "triage_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users",
        "job_to_be_done",
        "entry_scene",
        "buyer_or_payment_logic",
        "current_alternatives",
        "solution_boundary"
      ],
      "properties": {
        "users": { "$ref": "#/$defs/triageDimension" },
        "job_to_be_done": { "$ref": "#/$defs/triageDimension" },
        "entry_scene": { "$ref": "#/$defs/triageDimension" },
        "buyer_or_payment_logic": { "$ref": "#/$defs/triageDimension" },
        "current_alternatives": { "$ref": "#/$defs/triageDimension" },
        "solution_boundary": { "$ref": "#/$defs/triageDimension" }
      }
    },
    "material_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/materialDisposition" }
    },
    "materialization_rationale": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "pre_formal_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_opportunity_created",
        "validated_market_claim",
        "harness_inferred_candidate",
        "harness_ranked_candidate",
        "external_validation_performed"
      ],
      "properties": {
        "formal_opportunity_created": { "const": false },
        "validated_market_claim": { "const": false },
        "harness_inferred_candidate": { "const": false },
        "harness_ranked_candidate": { "const": false },
        "external_validation_performed": { "const": false }
      }
    },
    "limitations": {
      "allOf": [
        { "$ref": "./definitions.schema.json#/$defs/uniqueStringArray" },
        { "type": "array", "minItems": 1 }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_pre_candidate_ref": { "type": "null" },
          "parent_content_hash": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "parent_pre_candidate_ref": {
            "$ref": "./definitions.schema.json#/$defs/concretePreCandidateRef"
          },
          "parent_content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "seedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "schema_version", "candidate_kind", "content_hash"],
      "properties": {
        "ref": { "$ref": "./definitions.schema.json#/$defs/candidateRef" },
        "schema_version": { "const": "startup_opportunity.discovery_candidate.v1" },
        "candidate_kind": { "$ref": "./definitions.schema.json#/$defs/candidateKind" },
        "content_hash": { "$ref": "./definitions.schema.json#/$defs/sha256" }
      }
    },
    "laneResultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "schema_version", "status", "content_hash"],
      "properties": {
        "ref": { "$ref": "./definitions.schema.json#/$defs/discoveryLaneResultRef" },
        "schema_version": { "const": "startup_opportunity.discovery_lane_result.v1" },
        "status": { "enum": ["completed", "partial", "insufficient_evidence"] },
        "content_hash": { "$ref": "./definitions.schema.json#/$defs/sha256" }
      }
    },
    "triageDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "statements", "basis_material_refs", "limitations"],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "inferred",
            "partial",
            "unknown",
            "unavailable",
            "conflicting",
            "not_applicable"
          ]
        },
        "statements": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        "basis_material_refs": {
          "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
        },
        "limitations": {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        }
      }
    },
    "materialDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_ref",
        "material_schema_version",
        "material_content_hash",
        "disposition",
        "rationale"
      ],
      "properties": {
        "material_ref": {
          "$ref": "./definitions.schema.json#/$defs/artifactRef"
        },
        "material_schema_version": {
          "enum": [
            "startup_opportunity.evidence.discovery_candidate.current",
            "startup_opportunity.claim.discovery_candidate.current",
            "startup_opportunity.finding.discovery_candidate.current",
            "startup_opportunity.insight.discovery_candidate.current",
            "startup_opportunity.judgment_assessment.discovery_candidate.current"
          ]
        },
        "material_content_hash": {
          "$ref": "./definitions.schema.json#/$defs/sha256"
        },
        "disposition": {
          "enum": ["supporting", "opposing", "background", "conflicting", "not_applicable"]
        },
        "rationale": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
