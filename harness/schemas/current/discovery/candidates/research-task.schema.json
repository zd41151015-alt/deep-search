{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/candidates/research-task.schema.json",
  "title": "Startup Opportunity Discovery Candidate Research Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "unit_id",
    "mode",
    "phase",
    "wave_id",
    "unit_type",
    "research_goal",
    "commercial_research_requirements",
    "target_candidate_refs",
    "scope_frame_ref",
    "research_plan_ref",
    "input_refs",
    "attempt",
    "supersedes_task_ref",
    "agent_role",
    "source_phase",
    "required_source_group_ids",
    "allowed_output_path",
    "required_artifact_schema",
    "lane_submission_contract",
    "required_stances",
    "stop_conditions",
    "completion_message_contract",
    "execution_contract",
    "dispatched_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.research_task.discovery_candidate.current"
    },
    "task_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "mode": {
      "const": "opportunity_discovery"
    },
    "phase": {
      "const": "discovery"
    },
    "wave_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "unit_type": {
      "$ref": "../../core/definitions.schema.json#/$defs/unitType"
    },
    "research_goal": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "commercial_research_requirements": {
      "$ref": "../../assessment/commercial/commercial-research-requirements.schema.json#/$defs/requirements"
    },
    "target_candidate_refs": {
      "$ref": "./definitions.schema.json#/$defs/candidateRefArray"
    },
    "scope_frame_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "input_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_task_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/discoveryTaskRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_role": {
      "const": "lane-researcher"
    },
    "source_phase": {
      "enum": ["candidate_generation", "candidate_evaluation", "adversarial_challenger"]
    },
    "required_source_group_ids": {
      "allOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "allowed_output_path": {
      "oneOf": [
        { "$ref": "./definitions.schema.json#/$defs/discoveryLaneResultRef" },
        {
          "type": "string",
          "pattern": "^artifacts/discovery/generation/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
        }
      ]
    },
    "required_artifact_schema": {
      "enum": [
        "startup_opportunity.discovery_lane_result.v1",
        "startup_opportunity.discovery_generation_result.v1"
      ]
    },
    "lane_submission_contract": {
      "$ref": "../../runtime/common/lane-submission-contract.schema.json"
    },
    "required_stances": {
      "type": "array",
      "items": {
        "enum": ["support", "oppose"]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "support"
          }
        },
        {
          "contains": {
            "const": "oppose"
          }
        }
      ]
    },
    "stop_conditions": {
      "allOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/uniqueStringArray"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "completion_message_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_artifact_authority", "include_artifact_path", "include_limitations"],
      "properties": {
        "formal_artifact_authority": {
          "const": false
        },
        "include_artifact_path": {
          "const": true
        },
        "include_limitations": {
          "const": true
        }
      }
    },
    "execution_contract": {
      "$ref": "./definitions.schema.json#/$defs/sourceBoundary"
    },
    "dispatched_at": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "required_artifact_schema": {
            "const": "startup_opportunity.discovery_generation_result.v1"
          }
        },
        "required": ["required_artifact_schema"]
      },
      "then": {
        "properties": {
          "target_candidate_refs": { "type": "array", "maxItems": 0 },
          "allowed_output_path": {
            "type": "string",
            "pattern": "^artifacts/discovery/generation/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
          },
          "required_artifact_schema": {
            "const": "startup_opportunity.discovery_generation_result.v1"
          }
        }
      },
      "else": {
        "properties": {
          "target_candidate_refs": { "type": "array", "minItems": 1 },
          "allowed_output_path": {
            "$ref": "./definitions.schema.json#/$defs/discoveryLaneResultRef"
          },
          "required_artifact_schema": { "const": "startup_opportunity.discovery_lane_result.v1" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt": {
            "const": 1
          }
        },
        "required": ["attempt"]
      },
      "then": {
        "properties": {
          "supersedes_task_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_task_ref": {
            "$ref": "./definitions.schema.json#/$defs/discoveryTaskRef"
          }
        }
      }
    }
  ]
}
