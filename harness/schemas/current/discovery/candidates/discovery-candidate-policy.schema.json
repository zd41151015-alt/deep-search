{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/candidates/discovery-candidate-policy.schema.json",
  "title": "Startup Opportunity Discovery Candidate Contract Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "artifact_contracts",
    "candidate_kinds",
    "ownership",
    "revision_contract",
    "source_separation_contract",
    "disposition_contract",
    "fan_in_contract",
    "publication_contract",
    "manifest_projection_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_candidate_policy.current"
    },
    "policy_id": {
      "const": "startup_opportunity.g2_2_pre_thesis_candidate_contract"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "artifact_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "research_task",
        "evidence",
        "claim",
        "finding",
        "insight",
        "judgment",
        "source_manifest",
        "lane_result",
        "fan_in",
        "artifact_envelope",
        "document_bundle"
      ],
      "properties": {
        "candidate": {
          "const": "startup_opportunity.discovery_candidate.v1"
        },
        "research_task": {
          "const": "startup_opportunity.research_task.discovery_candidate.current"
        },
        "evidence": {
          "const": "startup_opportunity.evidence.discovery_candidate.current"
        },
        "claim": {
          "const": "startup_opportunity.claim.discovery_candidate.current"
        },
        "finding": {
          "const": "startup_opportunity.finding.discovery_candidate.current"
        },
        "insight": {
          "const": "startup_opportunity.insight.discovery_candidate.current"
        },
        "judgment": {
          "const": "startup_opportunity.judgment_assessment.discovery_candidate.current"
        },
        "source_manifest": {
          "const": "startup_opportunity.source_manifest.discovery_candidate.current"
        },
        "lane_result": {
          "const": "startup_opportunity.discovery_lane_result.v1"
        },
        "fan_in": {
          "const": "startup_opportunity.discovery_fan_in.v2"
        },
        "artifact_envelope": {
          "const": "startup_opportunity.artifact_envelope.current"
        },
        "document_bundle": {
          "const": "startup_opportunity.document_bundle.current"
        }
      }
    },
    "candidate_kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand_seed", "baseline_seed", "solution_seed"],
      "properties": {
        "demand_seed": {
          "$ref": "#/$defs/candidateKindRule"
        },
        "baseline_seed": {
          "$ref": "#/$defs/candidateKindRule"
        },
        "solution_seed": {
          "$ref": "#/$defs/candidateKindRule"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "research_task", "lane_material", "lane_result", "fan_in"],
      "properties": {
        "candidate": {
          "const": "main_agent"
        },
        "research_task": {
          "const": "main_agent"
        },
        "lane_material": {
          "const": "lane_researcher"
        },
        "lane_result": {
          "const": "lane_researcher"
        },
        "fan_in": {
          "const": "main_agent"
        }
      }
    },
    "revision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_pattern",
        "parent_revision",
        "parent_hash",
        "append_only_ref_fields",
        "mutable_enrichment_fields",
        "new_material_requires_exact_source_candidate_task_binding",
        "new_judgment_subject_must_equal_source_candidate",
        "in_place_overwrite"
      ],
      "properties": {
        "path_pattern": {
          "const": "artifacts/discovery/candidates/<candidate_id>.r<revision>.json"
        },
        "parent_revision": {
          "const": "exactly_previous"
        },
        "parent_hash": {
          "const": "canonical_json_sha256"
        },
        "append_only_ref_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 7,
          "uniqueItems": true
        },
        "mutable_enrichment_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "new_material_requires_exact_source_candidate_task_binding": {
          "const": true
        },
        "new_judgment_subject_must_equal_source_candidate": {
          "const": true
        },
        "in_place_overwrite": {
          "const": false
        }
      }
    },
    "source_separation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_and_evaluation_distinct_by_default",
        "overlap_requires_disclosure",
        "source_manifest_required",
        "evidence_phase_role_required"
      ],
      "properties": {
        "generation_and_evaluation_distinct_by_default": {
          "const": true
        },
        "overlap_requires_disclosure": {
          "const": true
        },
        "source_manifest_required": {
          "const": true
        },
        "evidence_phase_role_required": {
          "const": true
        }
      }
    },
    "disposition_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "sets_are_exclusive",
        "decision_identity_required",
        "typed_candidate_target_required",
        "judgment_subject_equals_candidate_ref",
        "judgment_task_matches_lane_task",
        "diversity_retention_explicit"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "enum": ["retained", "watchlist", "rejected"]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "sets_are_exclusive": {
          "const": true
        },
        "decision_identity_required": {
          "const": true
        },
        "typed_candidate_target_required": {
          "const": true
        },
        "judgment_subject_equals_candidate_ref": {
          "const": true
        },
        "judgment_task_matches_lane_task": {
          "const": true
        },
        "diversity_retention_explicit": {
          "const": true
        }
      }
    },
    "fan_in_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_only",
        "eligible_lane_statuses",
        "excluded_lane_statuses",
        "missing_work_is_neutral",
        "candidate_revision_upgrade_explicit",
        "judgment_subject_matches_source_candidate_revision",
        "judgment_subject_must_ancestor_final_candidate",
        "judgments_must_come_from_supporting_lane_disposition",
        "top_level_judgment_refs_exact_disposition_closure"
      ],
      "properties": {
        "reference_only": {
          "const": true
        },
        "eligible_lane_statuses": {
          "type": "array",
          "items": {
            "enum": ["completed", "partial", "insufficient_evidence"]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "excluded_lane_statuses": {
          "type": "array",
          "items": {
            "enum": ["failed", "ignored_late", "superseded"]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "missing_work_is_neutral": {
          "const": false
        },
        "candidate_revision_upgrade_explicit": {
          "const": true
        },
        "judgment_subject_matches_source_candidate_revision": {
          "const": true
        },
        "judgment_subject_must_ancestor_final_candidate": {
          "const": true
        },
        "judgments_must_come_from_supporting_lane_disposition": {
          "const": true
        },
        "top_level_judgment_refs_exact_disposition_closure": {
          "const": true
        }
      }
    },
    "publication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_schema_version",
        "document_bundle_schema_version",
        "explicit_artifact_input_only",
        "publication_implies_validation"
      ],
      "properties": {
        "envelope_schema_version": {
          "const": "startup_opportunity.artifact_envelope.current"
        },
        "document_bundle_schema_version": {
          "const": "startup_opportunity.document_bundle.current"
        },
        "explicit_artifact_input_only": {
          "const": true
        },
        "publication_implies_validation": {
          "const": false
        }
      }
    },
    "manifest_projection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_updates_manifest",
        "late_or_superseded_can_enter_current_refs",
        "status_mapping"
      ],
      "properties": {
        "publication_updates_manifest": {
          "const": true
        },
        "late_or_superseded_can_enter_current_refs": {
          "const": false
        },
        "status_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed",
            "partial",
            "insufficient_evidence",
            "failed",
            "ignored_late",
            "superseded"
          ],
          "properties": {
            "completed": {
              "const": "completed_units"
            },
            "partial": {
              "const": "completed_units"
            },
            "insufficient_evidence": {
              "const": "completed_units"
            },
            "failed": {
              "const": "failed_units"
            },
            "ignored_late": {
              "const": "ignored_late_artifact_refs"
            },
            "superseded": {
              "const": "superseded_units"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "candidateKindRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_schema_version",
        "allowed_fragment_collections",
        "fragment_id_field",
        "formal_target_schema"
      ],
      "properties": {
        "map_schema_version": {
          "type": "string"
        },
        "allowed_fragment_collections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9_-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fragment_id_field": {
          "type": "string"
        },
        "formal_target_schema": {
          "type": "string"
        }
      }
    }
  }
}
