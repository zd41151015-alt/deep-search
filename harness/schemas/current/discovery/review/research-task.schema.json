{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/discovery/review/research-task.schema.json",
  "title": "Startup Opportunity Discovery Review Research Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "unit_id",
    "mode",
    "phase",
    "wave_id",
    "unit_type",
    "research_goal",
    "commercial_research_requirements",
    "scope_frame_ref",
    "research_plan_ref",
    "input_refs",
    "attempt",
    "supersedes_task_ref",
    "agent_role",
    "source_phase",
    "required_source_group_ids",
    "assigned_plan_question_refs",
    "allowed_output_path",
    "required_artifact_schema",
    "lane_submission_contract",
    "required_stances",
    "stop_conditions",
    "completion_message_contract",
    "execution_contract",
    "dispatched_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.research_task.discovery_review.current"
    },
    "task_id": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/identifier"
    },
    "mode": {
      "const": "opportunity_discovery"
    },
    "phase": {
      "const": "review"
    },
    "wave_id": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/identifier"
    },
    "unit_type": {
      "const": "adversarial_review"
    },
    "research_goal": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/nonEmptyString"
    },
    "commercial_research_requirements": {
      "$ref": "../../assessment/commercial/commercial-research-requirements.schema.json#/$defs/requirements"
    },
    "scope_frame_ref": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "input_refs": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/artifactRefArray"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_task_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tasks/discovery/reviews/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_role": {
      "const": "adversarial-reviewer"
    },
    "source_phase": {
      "const": "adversarial_challenger"
    },
    "required_source_group_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../evaluation/definitions.schema.json#/$defs/identifier"
      }
    },
    "assigned_plan_question_refs": {
      "type": "array",
      "allOf": [
        {
          "$ref": "../evaluation/definitions.schema.json#/$defs/artifactRefArray"
        }
      ],
      "minItems": 1
    },
    "allowed_output_path": {
      "type": "string",
      "pattern": "^artifacts/reviews/[A-Za-z0-9._-]+\\.json$"
    },
    "required_artifact_schema": {
      "const": "startup_opportunity.discovery_adversarial_review.current"
    },
    "lane_submission_contract": {
      "$ref": "../../runtime/common/lane-submission-contract.schema.json"
    },
    "required_stances": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["support", "oppose"]
      },
      "allOf": [
        {
          "contains": {
            "const": "support"
          }
        },
        {
          "contains": {
            "const": "oppose"
          }
        }
      ]
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../evaluation/definitions.schema.json#/$defs/nonEmptyString"
      }
    },
    "completion_message_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_artifact_authority", "include_artifact_path", "include_limitations"],
      "properties": {
        "formal_artifact_authority": {
          "const": false
        },
        "include_artifact_path": {
          "const": true
        },
        "include_limitations": {
          "const": true
        }
      }
    },
    "execution_contract": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/executionBoundary"
    },
    "dispatched_at": {
      "$ref": "../evaluation/definitions.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt": {
            "const": 1
          }
        },
        "required": ["attempt"]
      },
      "then": {
        "properties": {
          "supersedes_task_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_task_ref": {
            "type": "string",
            "pattern": "^tasks/discovery/reviews/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
          }
        }
      }
    }
  ]
}
