{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/ai/economics/capability-commoditization-risk.schema.json",
  "title": "Startup Opportunity Capability Commoditization Risk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "risk_id",
    "run_id",
    "lineage",
    "research_mode",
    "capability_evidence_ref",
    "data_dependency_ref",
    "provider_substitution",
    "platform_native_substitution",
    "open_source_substitution",
    "provider_portability",
    "platform_bundle_risk",
    "capability_half_life",
    "defensibility_beyond_model_access",
    "overall_risk",
    "conclusion_ceiling",
    "ceiling_reasons",
    "evidence_refs",
    "judgment_assessment_refs",
    "freshness",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.capability_commoditization_risk.v1"
    },
    "risk_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "lineage": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/lineage"
    },
    "research_mode": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/researchMode"
    },
    "capability_evidence_ref": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
    },
    "data_dependency_ref": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
    },
    "provider_substitution": {
      "$ref": "#/$defs/substitution"
    },
    "platform_native_substitution": {
      "$ref": "#/$defs/substitution"
    },
    "open_source_substitution": {
      "$ref": "#/$defs/substitution"
    },
    "provider_portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "switching_cost", "dependency_boundary"],
      "properties": {
        "status": {
          "enum": ["provider_independent", "portable_with_cost", "provider_locked", "unknown"]
        },
        "switching_cost": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "dependency_boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "platform_bundle_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "bundle_path", "migration_response"],
      "properties": {
        "risk_level": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "bundle_path": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "migration_response": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "capability_half_life": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate_band", "revalidate_by", "rationale"],
      "properties": {
        "estimate_band": {
          "enum": [
            "under_6_months",
            "6_to_12_months",
            "12_to_24_months",
            "over_24_months",
            "unknown"
          ]
        },
        "revalidate_by": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "defensibility_beyond_model_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sources", "boundary"],
      "properties": {
        "status": {
          "enum": ["credible", "weak", "none", "unknown"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workflow_state",
              "data_rights",
              "distribution",
              "trust",
              "integration",
              "service",
              "none",
              "unknown"
            ]
          }
        },
        "boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "overall_risk": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "conclusion_ceiling": {
      "enum": ["prioritize_allowed", "investigate_further_only", "insufficient_evidence", "reject"]
    },
    "ceiling_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
      }
    },
    "evidence_refs": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/evidenceRefs"
    },
    "judgment_assessment_refs": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/assessmentRefs"
    },
    "freshness": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/freshness"
    },
    "source_boundary": {
      "$ref": "../capability/ai-contract-definitions.schema.json#/$defs/sourceBoundary"
    },
    "limitations": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "$defs": {
    "substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "time_horizon", "impact", "boundary"],
      "properties": {
        "status": {
          "enum": ["available", "emerging", "not_available", "unknown"]
        },
        "time_horizon": {
          "enum": ["current", "under_6_months", "6_to_12_months", "over_12_months", "unknown"]
        },
        "impact": {
          "enum": ["low", "medium", "high", "unknown"]
        },
        "boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
