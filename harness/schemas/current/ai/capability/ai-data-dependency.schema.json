{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/ai/capability/ai-data-dependency.schema.json",
  "title": "Startup Opportunity AI Data Dependency v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_dependency_id",
    "run_id",
    "lineage",
    "research_mode",
    "data_requirements",
    "ground_truth",
    "feedback_loop",
    "provider_portability",
    "privacy_boundary",
    "freshness",
    "source_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.ai_data_dependency.v1"
    },
    "data_dependency_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "lineage": {
      "$ref": "./ai-contract-definitions.schema.json#/$defs/lineage"
    },
    "research_mode": {
      "$ref": "./ai-contract-definitions.schema.json#/$defs/researchMode"
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data_kind",
          "purpose",
          "rights_basis",
          "availability",
          "retention_boundary",
          "evidence_refs"
        ],
        "properties": {
          "data_kind": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          },
          "purpose": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          },
          "rights_basis": {
            "enum": [
              "explicit_permission",
              "licensed",
              "public_domain",
              "first_party_contract",
              "restricted",
              "unknown"
            ]
          },
          "availability": {
            "enum": ["available", "partial", "unavailable", "unknown"]
          },
          "retention_boundary": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          },
          "evidence_refs": {
            "$ref": "./ai-contract-definitions.schema.json#/$defs/evidenceRefs"
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "collection_boundary", "judgment_assessment_refs"],
      "properties": {
        "status": {
          "enum": ["available", "partial", "unavailable", "unknown"]
        },
        "source": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "collection_boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "judgment_assessment_refs": {
          "$ref": "./ai-contract-definitions.schema.json#/$defs/assessmentRefs"
        }
      }
    },
    "feedback_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signal", "frequency", "moat_status"],
      "properties": {
        "status": {
          "enum": ["available", "limited", "unavailable", "unknown"]
        },
        "signal": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "frequency": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "moat_status": {
          "enum": ["credible", "weak", "none", "unknown"]
        }
      }
    },
    "provider_portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "export_format", "switching_boundary"],
      "properties": {
        "status": {
          "enum": ["provider_independent", "portable_with_cost", "provider_locked", "unknown"]
        },
        "export_format": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "switching_boundary": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "privacy_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "permission_model",
        "deletion_status",
        "export_status",
        "regulated_data",
        "accountability_owner"
      ],
      "properties": {
        "risk_level": {
          "enum": ["low", "medium", "high", "regulated", "unknown"]
        },
        "permission_model": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        },
        "deletion_status": {
          "enum": ["supported", "partial", "unsupported", "unknown"]
        },
        "export_status": {
          "enum": ["supported", "partial", "unsupported", "unknown"]
        },
        "regulated_data": {
          "type": "boolean"
        },
        "accountability_owner": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "freshness": {
      "$ref": "./ai-contract-definitions.schema.json#/$defs/freshness"
    },
    "source_boundary": {
      "$ref": "./ai-contract-definitions.schema.json#/$defs/sourceBoundary"
    },
    "limitations": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
