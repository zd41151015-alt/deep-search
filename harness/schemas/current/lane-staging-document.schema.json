{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/lane-staging-document.schema.json",
  "title": "Startup Opportunity Lane Staging Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "staging_id",
    "run_id",
    "task_ref",
    "created_at",
    "producer_role",
    "operation",
    "evidence_receipt_refs",
    "agent_document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.lane_staging_document.current" },
    "staging_id": { "$ref": "../v12/definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "task_ref": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRef" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "const": "lane_researcher" },
    "operation": { "enum": ["validate_only", "publish"] },
    "evidence_receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence/manifest\\.jsonl#[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "agent_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_path", "document"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "pattern": "^startup_opportunity(?:\\.[a-z][a-z0-9_]*)+(?:\\.v[1-9][0-9]*|\\.current)$"
        },
        "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
        "document": { "type": "object" }
      }
    }
  }
}
