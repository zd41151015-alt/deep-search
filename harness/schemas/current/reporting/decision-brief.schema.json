{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/reporting/decision-brief.schema.json",
  "title": "Startup Opportunity Terminal Decision Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "run_id",
    "mode",
    "research_language",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_ref",
    "report_content_hash",
    "terminal_outcome",
    "decision_question",
    "execution",
    "research_conclusion",
    "runtime_health",
    "directions",
    "sources",
    "ordered_validation_plan",
    "freshness",
    "limitations",
    "external_action_boundary",
    "audit_appendix_refs",
    "markdown",
    "markdown_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.decision_brief.terminal.current"
    },
    "brief_id": {
      "$ref": "../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "enum": ["opportunity_discovery", "concept_evidence_assessment"]
    },
    "research_language": {
      "type": "string",
      "minLength": 2
    },
    "producer_role": {
      "const": "harness"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/decision-brief\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "decision-brief.md"
    },
    "report_ref": {
      "type": "string",
      "pattern": "^artifacts/reporting/terminal-report-source\\.r[1-9][0-9]*\\.json$"
    },
    "report_content_hash": {
      "$ref": "../discovery/evaluation/definitions.schema.json#/$defs/sha256"
    },
    "terminal_outcome": {
      "enum": [
        "completed",
        "insufficient_evidence",
        "deprioritized",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object"
    },
    "research_conclusion": {
      "type": "object"
    },
    "runtime_health": {
      "type": "object"
    },
    "directions": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "ordered_validation_plan": {
      "type": "array"
    },
    "freshness": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "external_action_boundary": {
      "type": "object"
    },
    "audit_appendix_refs": {
      "$ref": "../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "markdown_content_hash": {
      "$ref": "../discovery/evaluation/definitions.schema.json#/$defs/sha256"
    }
  }
}
