{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/assessment/assessment-execution-policy.schema.json",
  "title": "Startup Opportunity Assessment Execution Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "mandatory_reporting_dimensions",
    "default_lanes",
    "stage_order",
    "initial_lane_count",
    "followup",
    "runtime_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.assessment_execution_policy.current"
    },
    "policy_id": {
      "const": "startup_opportunity.assessment_staged_execution"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "mandatory_reporting_dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "../../assessment/core/definitions.schema.json#/$defs/assessmentDimension"
      }
    },
    "default_lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_key", "stage_kind", "unit_type", "reporting_dimensions"],
        "properties": {
          "lane_key": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
          },
          "stage_kind": {
            "enum": ["assessment_early_kill", "assessment_commercial", "assessment_delivery"]
          },
          "unit_type": {
            "$ref": "../../core/definitions.schema.json#/$defs/unitType"
          },
          "reporting_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "../../assessment/core/definitions.schema.json#/$defs/assessmentDimension"
            }
          }
        }
      }
    },
    "stage_order": {
      "type": "array",
      "prefixItems": [
        {
          "const": "assessment_early_kill"
        },
        {
          "const": "assessment_commercial"
        },
        {
          "const": "assessment_delivery"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "initial_lane_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "const": 4
        },
        "maximum": {
          "const": 5
        }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_additions_per_dimension",
        "gap_type",
        "requires_plan_revision",
        "dimension_unit_types"
      ],
      "properties": {
        "max_rounds": {
          "const": 2
        },
        "max_additions_per_dimension": {
          "const": 1
        },
        "gap_type": {
          "const": "decision_relevant_evidence_gap"
        },
        "requires_plan_revision": {
          "const": true
        },
        "dimension_unit_types": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension_id", "unit_type"],
            "properties": {
              "dimension_id": {
                "$ref": "../../assessment/core/definitions.schema.json#/$defs/assessmentDimension"
              },
              "unit_type": {
                "$ref": "../../core/definitions.schema.json#/$defs/unitType"
              }
            }
          }
        }
      }
    },
    "runtime_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_dispatch_performed",
        "research_judgment_generated",
        "generic_workflow_runtime",
        "external_validation"
      ],
      "properties": {
        "agent_dispatch_performed": {
          "const": false
        },
        "research_judgment_generated": {
          "const": false
        },
        "generic_workflow_runtime": {
          "const": false
        },
        "external_validation": {
          "const": false
        }
      }
    }
  }
}
