{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/assessment/runtime-artifact-compilation-result.schema.json",
  "title": "Startup Opportunity Assessment Runtime Artifact Compilation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "status",
    "current_leaf_run_id",
    "compiled_envelopes",
    "publication_plan",
    "publication_preflight",
    "working_directory",
    "validation_closure",
    "timing_ms",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.runtime_artifact_compilation_result.assessment.current"
    },
    "request_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "status": {
      "enum": ["validated", "published", "idempotent_replay"]
    },
    "current_leaf_run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "compiled_envelopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../store/artifact-envelope.schema.json"
      }
    },
    "publication_plan": {
      "$ref": "../common/runtime-publication-plan.schema.json"
    },
    "publication_preflight": {
      "$ref": "../common/runtime-publication-preflight.schema.json"
    },
    "working_directory": {
      "type": "string",
      "pattern": "^dist/research-working/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "validation_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_bundle_schema_version", "document_count", "exact_record_count"],
      "properties": {
        "document_bundle_schema_version": {
          "const": "startup_opportunity.document_bundle.current"
        },
        "document_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_record_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilation", "closure_validation", "publication", "total"],
      "properties": {
        "compilation": {
          "type": "number",
          "minimum": 0
        },
        "closure_validation": {
          "type": "number",
          "minimum": 0
        },
        "publication": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "publication": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_path", "content_hash", "status"],
        "properties": {
          "artifact_path": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactPath"
          },
          "content_hash": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256"
          },
          "status": {
            "enum": ["validated", "published", "idempotent_replay"]
          }
        }
      }
    }
  }
}
