{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/discovery/discovery-stage-readiness.schema.json",
  "title": "Startup Opportunity Discovery Stage Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "revision",
    "run_id",
    "research_plan_ref",
    "execution_plan_ref",
    "stage_id",
    "next_stage_id",
    "source_fan_in_ref",
    "generation_result_refs",
    "candidate_roles",
    "pre_candidate_roles",
    "required_candidate_kinds",
    "missing_candidate_kinds",
    "question_coverage",
    "commercial_signal_gate",
    "next_stage_readiness",
    "blockers",
    "allowed_next_actions",
    "stop_basis",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.discovery_stage_readiness.v1"
    },
    "readiness_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "research_plan_ref": {
      "$ref": "../../core/definitions.schema.json#/$defs/planRef"
    },
    "execution_plan_ref": {
      "type": "string",
      "pattern": "^plans/research-execution\\.r[1-9][0-9]*\\.json$"
    },
    "stage_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "next_stage_id": {
      "anyOf": [
        {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_fan_in_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^artifacts/discovery/fan-in\\.r[1-9][0-9]*\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation_result_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifacts/discovery/generation/.+\\.json$"
      }
    },
    "candidate_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_ref", "candidate_kind", "reporting_role", "disposition"],
        "properties": {
          "candidate_ref": {
            "type": "string",
            "pattern": "^artifacts/discovery/candidates/.+\\.json$"
          },
          "candidate_kind": {
            "enum": ["demand_seed", "baseline_seed", "solution_seed"]
          },
          "reporting_role": {
            "enum": ["opportunity_direction", "comparison_baseline", "solution_hypothesis"]
          },
          "disposition": {
            "enum": ["retained", "watchlist", "rejected"]
          }
        }
      }
    },
    "pre_candidate_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pre_candidate_ref", "disposition"],
        "properties": {
          "pre_candidate_ref": {
            "type": "string",
            "pattern": "^artifacts/discovery/concrete-pre-candidates/.+\\.json$"
          },
          "disposition": {
            "enum": ["retained", "watchlist", "rejected"]
          }
        }
      }
    },
    "required_candidate_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["demand_seed", "baseline_seed", "solution_seed"]
      }
    },
    "missing_candidate_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["demand_seed", "baseline_seed", "solution_seed"]
      }
    },
    "question_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_ref", "status", "judgment_refs", "evidence_refs", "basis_refs"],
        "properties": {
          "question_ref": {
            "type": "string",
            "pattern": "^plans/research-plan\\.r[1-9][0-9]*\\.json#[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "enum": ["answered", "unresolved", "method_boundary", "runtime_blocked"]
          },
          "judgment_refs": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
          },
          "evidence_refs": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
          },
          "basis_refs": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
          }
        }
      }
    },
    "commercial_signal_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand_signal", "buyer_signal", "purchase_signal", "decision"],
      "properties": {
        "demand_signal": {
          "type": "boolean"
        },
        "buyer_signal": {
          "type": "boolean"
        },
        "purchase_signal": {
          "type": "boolean"
        },
        "decision": {
          "enum": ["continue_research", "early_stop_insufficient_evidence"]
        }
      }
    },
    "next_stage_readiness": {
      "enum": ["ready", "blocked", "terminal"]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "blocker_kind",
          "candidate_kind",
          "basis_refs",
          "allowed_actions",
          "detail"
        ],
        "properties": {
          "blocker_id": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
          },
          "blocker_kind": {
            "enum": [
              "evidence_missing",
              "candidate_kind_missing",
              "method_boundary",
              "no_information_gain",
              "runtime_blocked"
            ]
          },
          "candidate_kind": {
            "anyOf": [
              {
                "enum": ["demand_seed", "baseline_seed", "solution_seed"]
              },
              {
                "type": "null"
              }
            ]
          },
          "basis_refs": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "continue_stage",
                "add_unit",
                "run_solution_generation",
                "run_candidate_evaluation",
                "stop_method_boundary",
                "record_runtime_failure",
                "terminate_insufficient_evidence"
              ]
            }
          },
          "detail": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "allowed_next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "continue_stage",
          "add_unit",
          "run_solution_generation",
          "run_candidate_evaluation",
          "stop_method_boundary",
          "record_runtime_failure",
          "terminate_insufficient_evidence"
        ]
      }
    },
    "stop_basis": {
      "anyOf": [
        {
          "enum": [
            "method_boundary",
            "budget_exhausted",
            "no_information_gain",
            "decisive_counterevidence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
