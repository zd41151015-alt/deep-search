{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/discovery/continuation-lineage-entry.schema.json",
  "title": "Startup Opportunity Continuation Lineage Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_run_id",
    "child_run_id",
    "child_identity_hash",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.continuation_lineage_entry.v1"
    },
    "parent_run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "child_run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "child_identity_hash": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256"
    },
    "state": {
      "enum": ["pending", "committed"]
    },
    "created_at": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
    }
  }
}
