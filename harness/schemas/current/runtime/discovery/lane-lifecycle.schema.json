{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/discovery/lane-lifecycle.schema.json",
  "title": "Startup Opportunity Lane Lifecycle Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_id",
    "revision",
    "parent_lifecycle_ref",
    "run_id",
    "unit_id",
    "attempt",
    "execution_attempt_id",
    "dispatch_batch_ref",
    "dispatch_batch_hash",
    "task_ref",
    "task_id",
    "launch_registration_ref",
    "launch_registration_id",
    "launch_registration_hash",
    "state",
    "timestamps",
    "failure",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.lane_lifecycle.v1"
    },
    "lifecycle_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_lifecycle_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^artifacts/runtime/lane-lifecycle/lifecycle_[a-f0-9]{32}\\.r[1-9][0-9]*\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "execution_attempt_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "dispatch_batch_ref": {
      "type": "string",
      "pattern": "^tasks/dispatch/[A-Za-z0-9][A-Za-z0-9._-]*\\.r1\\.json#[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dispatch_batch_hash": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^tasks/dispatch/[A-Za-z0-9][A-Za-z0-9._-]*\\.r1\\.json#[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "launch_registration_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^artifacts/runtime/dispatch-launch-registrations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\.json$"
        },
        { "type": "null" }
      ]
    },
    "launch_registration_id": {
      "anyOf": [
        { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "launch_registration_hash": {
      "anyOf": [
        { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "state": {
      "enum": [
        "dispatch_requested",
        "agent_started",
        "researching",
        "evidence_recorded",
        "handoff_ready",
        "formalization_validated",
        "published",
        "partial",
        "failed",
        "late_ignored"
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ready_at",
        "dispatch_requested_at",
        "agent_started_at",
        "evidence_recorded_at",
        "handoff_ready_at",
        "formalization_validated_at",
        "published_at"
      ],
      "properties": {
        "task_ready_at": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
        },
        "dispatch_requested_at": {
          "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
        },
        "agent_started_at": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_recorded_at": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_ready_at": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "formalization_validated_at": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "detail", "retryable"],
          "properties": {
            "kind": {
              "enum": [
                "agent_failed",
                "timeout",
                "validation_failed",
                "publication_failed",
                "runtime_blocked"
              ]
            },
            "detail": {
              "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/nonEmptyString"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "launch_registration_id": { "type": "string" } },
        "required": ["launch_registration_id"]
      },
      "then": {
        "properties": {
          "launch_registration_ref": { "type": "string" },
          "launch_registration_hash": { "type": "string" }
        }
      },
      "else": {
        "properties": {
          "launch_registration_ref": { "type": "null" },
          "launch_registration_hash": { "type": "null" }
        }
      }
    }
  ]
}
