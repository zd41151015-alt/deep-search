{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/discovery/runtime-artifact-compilation-request.schema.json",
  "title": "Startup Opportunity Runtime Artifact Compilation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "operation", "created_at", "artifacts"],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.runtime_artifact_compilation_request.v1"
    },
    "request_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "operation": {
      "enum": ["validate_only", "publish"]
    },
    "created_at": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "artifact_path", "producer_role", "document"],
        "properties": {
          "artifact_type": {
            "type": "string",
            "pattern": "^startup_opportunity(?:\\.[a-z][a-z0-9_]*)+(?:\\.v[1-9][0-9]*|\\.current)$"
          },
          "artifact_path": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactPath"
          },
          "producer_role": {
            "enum": ["main_agent", "lane_researcher", "adversarial_reviewer", "harness"]
          },
          "input_refs": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRefArray"
          },
          "document": {
            "type": "object"
          }
        }
      }
    },
    "publication_plan": {
      "$ref": "../common/runtime-publication-plan.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_only"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1
          }
        },
        "not": {
          "required": ["publication_plan"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "publish"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "artifacts": {
                "type": "array",
                "minItems": 1
              }
            },
            "not": {
              "required": ["publication_plan"]
            }
          },
          {
            "properties": {
              "artifacts": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": ["publication_plan"]
          }
        ]
      }
    }
  ]
}
