{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/common/lane-staging-document.schema.json",
  "title": "Startup Opportunity Lane Staging Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "staging_id",
    "run_id",
    "task_ref",
    "created_at",
    "producer_role",
    "operation",
    "evidence_receipt_refs",
    "delivery_contract",
    "agent_documents"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.lane_staging_document.current"
    },
    "staging_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId"
    },
    "task_ref": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef"
    },
    "created_at": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/timestamp"
    },
    "producer_role": {
      "const": "lane_researcher"
    },
    "operation": {
      "enum": ["validate_only", "publish"]
    },
    "publication_plan": {
      "$ref": "./runtime-publication-plan.schema.json"
    },
    "evidence_receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence/manifest\\.jsonl#[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "delivery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_closure"],
      "properties": {
        "search_closure": {
          "$ref": "./lane-delivery-receipt.schema.json#/$defs/searchClosure"
        }
      }
    },
    "agent_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_family", "document"],
        "properties": {
          "artifact_family": {
            "enum": [
              "lane_result",
              "commercial_audit",
              "evidence",
              "finding",
              "claim",
              "judgment",
              "insight",
              "source_manifest"
            ]
          },
          "evidence_receipt_ref": {
            "type": "string",
            "pattern": "^evidence/manifest\\.jsonl#ev_[a-f0-9]{64}$"
          },
          "document": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "artifact_family": {
                  "const": "commercial_audit"
                }
              },
              "required": ["artifact_family"]
            },
            "then": {
              "properties": {
                "document": {
                  "$ref": "../../assessment/commercial/commercial-research-delivery.schema.json#/$defs/authoredSemantics"
                }
              }
            }
          },
          {
            "if": {
              "properties": { "artifact_family": { "const": "evidence" } },
              "required": ["artifact_family"]
            },
            "then": { "required": ["evidence_receipt_ref"] },
            "else": { "not": { "required": ["evidence_receipt_ref"] } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "publish" } },
        "required": ["operation"]
      },
      "then": { "required": ["publication_plan"] },
      "else": { "not": { "required": ["publication_plan"] } }
    }
  ]
}
