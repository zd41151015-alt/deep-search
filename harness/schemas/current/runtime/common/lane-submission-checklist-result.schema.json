{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/common/lane-submission-checklist-result.schema.json",
  "title": "Startup Opportunity Lane Submission Checklist Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_ref",
    "checklist",
    "additional_material_allowed",
    "formal_artifact"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.lane_submission_checklist_result.current" },
    "run_id": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId" },
    "task_ref": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactRef" },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_key", "status", "reason", "evidence_refs", "limitations"],
        "properties": {
          "scope_key": {
            "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
          },
          "status": { "type": "null" },
          "reason": { "type": "null" },
          "evidence_refs": { "type": "array", "maxItems": 0 },
          "limitations": { "type": "array", "maxItems": 0 }
        }
      }
    },
    "additional_material_allowed": { "const": true },
    "formal_artifact": { "const": false }
  }
}
