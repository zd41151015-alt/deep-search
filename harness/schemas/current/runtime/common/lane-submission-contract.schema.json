{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/common/lane-submission-contract.schema.json",
  "title": "Startup Opportunity Lane Submission Contract",
  "$defs": {
    "stagingOutputPath": {
      "type": "string",
      "pattern": "^staging/lane-submissions/[a-f0-9]{32}\\.json$"
    },
    "artifactFamily": {
      "enum": [
        "lane_result",
        "commercial_audit",
        "evidence",
        "finding",
        "claim",
        "judgment",
        "insight",
        "source_manifest"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "unit_id",
    "task_id",
    "attempt",
    "path_basis",
    "staging_output_path",
    "staging_schema",
    "formal_output_path",
    "formal_artifact_schema",
    "allowed_artifact_families",
    "required_sequence",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.lane_submission_contract.current"
    },
    "run_id": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId" },
    "unit_id": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier" },
    "task_id": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier" },
    "attempt": { "type": "integer", "minimum": 1 },
    "path_basis": { "const": "run_root_relative" },
    "staging_output_path": { "$ref": "#/$defs/stagingOutputPath" },
    "staging_schema": { "const": "startup_opportunity.lane_staging_document.current" },
    "formal_output_path": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/artifactPath"
    },
    "formal_artifact_schema": {
      "type": "string",
      "pattern": "^startup_opportunity(?:\\.[a-z][a-z0-9_]*)+(?:\\.v[1-9][0-9]*|\\.current)$"
    },
    "allowed_artifact_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactFamily" }
    },
    "required_sequence": {
      "type": "array",
      "prefixItems": [
        { "const": "lane_writes_staging_file" },
        { "const": "main_agent_reads_staging_file" },
        { "const": "materialize_lane_result_validate_only" },
        { "const": "materialize_lane_result_publish_exact_plan" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_writes_formal_artifact_path",
        "staging_file_is_formal_artifact",
        "staging_file_is_manifest_authority",
        "harness_publishes_formal_artifacts",
        "completion_message_is_formal_artifact",
        "completion_message_can_substitute_delivery"
      ],
      "properties": {
        "lane_writes_formal_artifact_path": { "const": false },
        "staging_file_is_formal_artifact": { "const": false },
        "staging_file_is_manifest_authority": { "const": false },
        "harness_publishes_formal_artifacts": { "const": true },
        "completion_message_is_formal_artifact": { "const": false },
        "completion_message_can_substitute_delivery": { "const": false }
      }
    }
  }
}
