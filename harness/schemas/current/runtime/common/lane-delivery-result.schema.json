{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/runtime/common/lane-delivery-result.schema.json",
  "title": "Startup Opportunity Lane Delivery Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "staging_id",
    "run_id",
    "status",
    "preflight",
    "delivery_receipt",
    "compilation"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.lane_delivery_result.current" },
    "staging_id": {
      "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/identifier"
    },
    "run_id": { "$ref": "../../discovery/evaluation/definitions.schema.json#/$defs/runId" },
    "status": { "const": "accepted" },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues",
        "root_causes",
        "required_artifact_count",
        "delivered_artifact_count",
        "scope_count",
        "evidence_ref_count",
        "search_closure_status"
      ],
      "properties": {
        "status": { "const": "accepted" },
        "issues": { "type": "array", "maxItems": 0 },
        "root_causes": { "type": "array", "maxItems": 0 },
        "required_artifact_count": { "type": "integer", "minimum": 1 },
        "delivered_artifact_count": { "type": "integer", "minimum": 1 },
        "scope_count": { "type": "integer", "minimum": 1 },
        "evidence_ref_count": { "type": "integer", "minimum": 0 },
        "search_closure_status": { "enum": ["completed", "not_required"] }
      }
    },
    "delivery_receipt": { "$ref": "../../store/artifact-envelope.schema.json" },
    "compilation": {
      "oneOf": [
        { "$ref": "../discovery/runtime-artifact-compilation-result.schema.json" },
        { "$ref": "../assessment/runtime-artifact-compilation-result.schema.json" }
      ]
    }
  }
}
