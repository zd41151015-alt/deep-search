{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/core/decision.schema.json",
  "title": "Startup Opportunity Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "decision_type",
    "timestamp",
    "actor",
    "reason",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.decision.v1"
    },
    "decision_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "decision_type": {
      "enum": [
        "scope_proposed",
        "scope_assumption_confirmed",
        "scope_changed_by_user",
        "initial_belief_recorded",
        "belief_changed_by_evidence",
        "remaining_disagreement_recorded",
        "candidate_rejected_by_user",
        "followup_requested_by_user",
        "plan_change_requested_by_user",
        "prior_input_admitted",
        "prior_input_consumed",
        "research_handoff_consumed",
        "subject_reformed",
        "limitation_accepted",
        "run_paused",
        "run_cancelled"
      ]
    },
    "timestamp": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "actor": {
      "enum": ["user", "main_agent"]
    },
    "reason": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "prior_input_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "prior_source_run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "prior_source_artifact_path": {
      "$ref": "./definitions.schema.json#/$defs/artifactPath"
    },
    "prior_source_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "prior_input_consumer": {
      "enum": ["discovery_maps", "discovery_candidates"]
    },
    "prior_target_artifact_path": {
      "$ref": "./definitions.schema.json#/$defs/artifactPath"
    },
    "prior_use_boundary": {
      "const": "hypothesis_input_only"
    },
    "prior_admission_ref": {
      "type": "string",
      "pattern": "^decisions\\.jsonl#prior_input_admitted_[A-Za-z0-9._-]+$"
    },
    "prior_admission_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "prior_taint_exempt_artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "research_handoff_ref": {
      "type": "string",
      "pattern": "^artifacts/research-handoffs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\.json$"
    },
    "research_handoff_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "research_handoff_item_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifacts/research-handoffs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\.json#[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "research_handoff_target_artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "terminal_snapshot_ref": {
      "type": "string",
      "pattern": "^artifacts/reporting/decision-subject-snapshot\\.r[1-9][0-9]*\\.json$"
    },
    "terminal_snapshot_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "terminal_snapshot_publication_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "reformation_subject_kind": {
      "enum": ["discovery_candidate", "opportunity_thesis", "concept_hypothesis"]
    },
    "terminal_subject_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "terminal_subject_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "terminal_subject_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "reformed_subject_ref": {
      "$ref": "./definitions.schema.json#/$defs/artifactRef"
    },
    "reformed_subject_content_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "reformed_subject_publication_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "reformation_input_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "content_hash", "publication_ordinal"],
        "properties": {
          "ref": {
            "$ref": "./definitions.schema.json#/$defs/artifactRef"
          },
          "content_hash": {
            "$ref": "./definitions.schema.json#/$defs/sha256"
          },
          "publication_ordinal": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "scope_revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "scope_proposal_ref": {
      "type": "string",
      "pattern": "^decisions\\.jsonl#scope_proposal_[A-Za-z0-9._-]*$"
    },
    "scope_proposal_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "confirmation_basis": {
      "const": "caller_attested_user_confirmation"
    },
    "harness_identity_verification": {
      "const": "not_available"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "geography",
        "customer_model",
        "target_users",
        "decision_goal",
        "research_language"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "geography": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "customer_model": {
          "enum": ["b2c", "b2b", "b2b2c", "mixed"]
        },
        "target_users": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
          }
        },
        "decision_goal": {
          "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
        },
        "research_language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_type": {
            "const": "subject_reformed"
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": [
          "terminal_snapshot_ref",
          "terminal_snapshot_hash",
          "terminal_snapshot_publication_ordinal",
          "reformation_subject_kind",
          "terminal_subject_id",
          "terminal_subject_ref",
          "terminal_subject_content_hash",
          "reformed_subject_ref",
          "reformed_subject_content_hash",
          "reformed_subject_publication_ordinal",
          "reformation_input_hashes"
        ],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_type": {
            "const": "research_handoff_consumed"
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": [
          "research_handoff_ref",
          "research_handoff_hash",
          "research_handoff_item_refs",
          "research_handoff_target_artifact_refs"
        ],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_type": {
            "const": "prior_input_admitted"
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": [
          "prior_input_id",
          "prior_source_run_id",
          "prior_source_artifact_path",
          "prior_source_content_hash",
          "prior_input_consumer",
          "prior_target_artifact_path",
          "prior_use_boundary"
        ],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_type": {
            "const": "prior_input_consumed"
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": [
          "prior_input_id",
          "prior_admission_ref",
          "prior_admission_hash",
          "prior_source_run_id",
          "prior_source_artifact_path",
          "prior_source_content_hash",
          "prior_input_consumer",
          "prior_target_artifact_path",
          "prior_use_boundary",
          "prior_taint_exempt_artifact_refs"
        ],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_type": {
            "const": "scope_proposed"
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": ["scope_revision", "scope_hash", "scope"],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_type": {
            "enum": ["scope_assumption_confirmed", "scope_changed_by_user"]
          }
        },
        "required": ["decision_type"]
      },
      "then": {
        "required": [
          "scope_revision",
          "scope_hash",
          "scope",
          "scope_proposal_ref",
          "scope_proposal_hash",
          "confirmation_basis",
          "harness_identity_verification"
        ],
        "properties": {
          "actor": {
            "const": "main_agent"
          }
        }
      }
    }
  ]
}
