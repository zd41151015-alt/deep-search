{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/core/event.schema.json",
  "title": "Startup Opportunity Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "timestamp",
    "actor",
    "reason",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.event.v1"
    },
    "event_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "event_type": {
      "enum": [
        "run_created",
        "decision_context_written",
        "scope_written",
        "plan_validated",
        "research_unit_started",
        "research_unit_completed",
        "artifact_validation_failed",
        "gap_snapshot_created",
        "adaptation_proposed",
        "adaptation_validated",
        "adaptation_rejected",
        "adaptation_applied",
        "plan_revision_created",
        "research_unit_invalidated",
        "checkpoint_written",
        "followup_stopped",
        "report_completed"
      ]
    },
    "timestamp": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "./definitions.schema.json#/$defs/actor"
    },
    "reason": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    }
  }
}
