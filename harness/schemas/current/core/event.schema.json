{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/core/event.schema.json",
  "title": "Startup Opportunity Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "timestamp",
    "actor",
    "reason",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.event.v1"
    },
    "event_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "event_type": {
      "enum": [
        "run_created",
        "decision_context_written",
        "scope_written",
        "plan_validated",
        "research_unit_started",
        "research_unit_completed",
        "artifact_validation_failed",
        "gap_snapshot_created",
        "adaptation_proposed",
        "adaptation_validated",
        "adaptation_rejected",
        "adaptation_applied",
        "plan_revision_created",
        "research_unit_invalidated",
        "checkpoint_written",
        "followup_stopped",
        "report_completed",
        "runtime_operation_observed"
      ]
    },
    "timestamp": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "./definitions.schema.json#/$defs/actor"
    },
    "reason": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "operation_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "attempt",
        "started_at",
        "completed_at",
        "duration_ms",
        "outcome",
        "failure_classification",
        "error_code"
      ],
      "properties": {
        "operation": {
          "const": "runtime_compile_publish"
        },
        "operation_id": {
          "$ref": "./definitions.schema.json#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "./definitions.schema.json#/$defs/timestamp"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "enum": ["published", "failed"]
        },
        "failure_classification": {
          "anyOf": [
            {
              "enum": ["validation_failed", "publication_failed", "runtime_blocked"]
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "runtime_operation_observed"
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "required": ["operation_observation"]
      },
      "else": {
        "not": {
          "required": ["operation_observation"]
        }
      }
    }
  ]
}
