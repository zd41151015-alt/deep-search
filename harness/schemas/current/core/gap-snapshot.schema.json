{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/core/gap-snapshot.schema.json",
  "title": "Startup Opportunity Discovery Plan Gap Snapshot",
  "$defs": {
    "gapTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["judgment_ref", "decision_sufficiency", "independent_source_count"],
          "properties": {
            "judgment_ref": {
              "$ref": "./definitions.schema.json#/$defs/artifactRef"
            },
            "decision_sufficiency": {
              "enum": ["sufficient", "insufficient", "blocked", "not_applicable"]
            },
            "independent_source_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_id", "observed_artifact_refs", "detail"],
          "properties": {
            "check_id": {
              "$ref": "./definitions.schema.json#/$defs/identifier"
            },
            "observed_artifact_refs": {
              "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
            },
            "detail": {
              "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_ref", "detail"],
          "properties": {
            "event_ref": {
              "$ref": "./definitions.schema.json#/$defs/eventRef"
            },
            "detail": {
              "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "snapshot_cycle_key",
    "run_id",
    "based_on_plan_ref",
    "revision",
    "parent_snapshot_ref",
    "created_at",
    "trigger_kind",
    "trigger_event_ref",
    "phase",
    "wave_id",
    "observed_artifact_refs",
    "gaps",
    "material_new_evidence_observed",
    "unresolved_decision_relevant_questions",
    "stop_signals"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.gap_snapshot.discovery.plan.current"
    },
    "snapshot_id": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "snapshot_cycle_key": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "based_on_plan_ref": {
      "$ref": "./definitions.schema.json#/$defs/planRef"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/gapSnapshotRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    },
    "trigger_kind": {
      "enum": [
        "wave_completed",
        "user_decision",
        "artifact_validation_failed",
        "adversarial_review_completed",
        "resume_reconciliation"
      ]
    },
    "trigger_event_ref": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/eventRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "$ref": "./definitions.schema.json#/$defs/identifier"
    },
    "wave_id": {
      "anyOf": [
        {
          "$ref": "./definitions.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_artifact_refs": {
      "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "subject_ref",
          "gap_type",
          "detection_mode",
          "triggered_by",
          "decision_impact",
          "severity",
          "basis_refs",
          "evidence_refs",
          "recommended_unit_types"
        ],
        "properties": {
          "gap_id": {
            "$ref": "./definitions.schema.json#/$defs/identifier"
          },
          "subject_ref": {
            "$ref": "./definitions.schema.json#/$defs/artifactRef"
          },
          "gap_type": {
            "enum": [
              "mandatory_dimension_missing",
              "evidence_insufficient",
              "evidence_conflict",
              "baseline_unclear",
              "buyer_evidence_insufficient",
              "acquisition_evidence_insufficient",
              "freshness_failed",
              "reviewer_challenge",
              "candidate_pre_killed",
              "unit_failed",
              "runtime_blocked",
              "scope_invalidated",
              "user_plan_change_requested",
              "source_repetition",
              "no_material_new_evidence"
            ]
          },
          "detection_mode": {
            "enum": ["deterministic", "agent_semantic"]
          },
          "triggered_by": {
            "$ref": "#/$defs/gapTrigger"
          },
          "decision_impact": {
            "$ref": "./definitions.schema.json#/$defs/decisionImpactArray"
          },
          "severity": {
            "enum": ["blocking", "material", "advisory"]
          },
          "basis_refs": {
            "type": "array",
            "items": {
              "$ref": "./definitions.schema.json#/$defs/artifactRef"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_refs": {
            "$ref": "./definitions.schema.json#/$defs/artifactRefArray"
          },
          "recommended_unit_types": {
            "type": "array",
            "items": {
              "$ref": "./definitions.schema.json#/$defs/unitType"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "material_new_evidence_observed": {
      "type": "boolean"
    },
    "unresolved_decision_relevant_questions": {
      "$ref": "./definitions.schema.json#/$defs/identifierArray"
    },
    "stop_signals": {
      "type": "array",
      "items": {
        "enum": [
          "max_followup_rounds_reached",
          "no_material_new_evidence",
          "source_repetition",
          "runtime_blocked",
          "user_stop",
          "limitation_accepted"
        ]
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_snapshot_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "parent_snapshot_ref": {
            "$ref": "./definitions.schema.json#/$defs/gapSnapshotRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger_kind": {
            "const": "wave_completed"
          }
        },
        "required": ["trigger_kind"]
      },
      "then": {
        "properties": {
          "wave_id": {
            "$ref": "./definitions.schema.json#/$defs/identifier"
          },
          "trigger_event_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "trigger_event_ref": {
            "$ref": "./definitions.schema.json#/$defs/eventRef"
          }
        }
      }
    }
  ]
}
