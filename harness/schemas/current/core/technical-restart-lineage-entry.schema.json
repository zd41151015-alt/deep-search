{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/core/technical-restart-lineage-entry.schema.json",
  "title": "Startup Opportunity Technical Restart Lineage Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run_id",
    "replacement_run_id",
    "replacement_identity_hash",
    "source_manifest_ref",
    "source_manifest_hash",
    "source_terminal_report_source_ref",
    "source_terminal_report_source_hash",
    "terminal_authority",
    "restart_boundary",
    "relationship_basis",
    "inherited_run_state",
    "user_authorization_attestation",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.technical_restart_lineage_entry.v1"
    },
    "source_run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "replacement_run_id": {
      "$ref": "./definitions.schema.json#/$defs/runId"
    },
    "replacement_identity_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "source_manifest_ref": {
      "const": "manifest.json"
    },
    "source_manifest_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "source_terminal_report_source_ref": {
      "type": "string",
      "pattern": "^artifacts/reporting/terminal-report-source\\.r[1-9][0-9]*\\.json$"
    },
    "source_terminal_report_source_hash": {
      "$ref": "./definitions.schema.json#/$defs/sha256"
    },
    "terminal_authority": {
      "const": "record_runtime_failure"
    },
    "restart_boundary": {
      "const": "technical_fix_new_attempt"
    },
    "relationship_basis": {
      "const": "caller_declared_exact_terminal_runtime_failure"
    },
    "inherited_run_state": {
      "const": "none"
    },
    "user_authorization_attestation": {
      "$ref": "./definitions.schema.json#/$defs/nonEmptyString"
    },
    "state": {
      "enum": ["pending", "committed"]
    },
    "created_at": {
      "$ref": "./definitions.schema.json#/$defs/timestamp"
    }
  }
}
