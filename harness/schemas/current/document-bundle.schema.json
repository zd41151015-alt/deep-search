{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/current/document-bundle.schema.json",
  "title": "Startup Opportunity Current Document Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.document_bundle.current"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "document"],
        "properties": {
          "path": {
            "$ref": "../v12/definitions.schema.json#/$defs/artifactPath"
          },
          "document": {
            "type": "object"
          }
        }
      }
    },
    "exact_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "document"],
        "properties": {
          "ref": {
            "$ref": "../v12/definitions.schema.json#/$defs/artifactRef"
          },
          "document": {
            "oneOf": [
              {
                "$ref": "../v5/evidence-substrate-record.schema.json"
              },
              {
                "$ref": "../v1/event.schema.json"
              },
              {
                "$ref": "../v1/decision.schema.json"
              }
            ]
          }
        }
      }
    }
  }
}
