{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v13/research-publication-policy-v8.schema.json",
  "title": "Startup Opportunity Research Publication Policy v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "current_schema_bundle_version",
    "adapters",
    "evidence_contract",
    "traceability_contract",
    "task_lifecycle_contract",
    "branch_status_adapter",
    "discovery_lane_status_adapter",
    "enrichment_branch_status_adapter",
    "report_publication_contract",
    "discovery_map_contract",
    "discovery_runtime_contract",
    "discovery_synthesis_contract",
    "discovery_evaluation_contract",
    "discovery_adaptation_binding_contract"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.research_publication_policy.v8" },
    "policy_id": { "const": "startup_opportunity.g2_4_research_publication" },
    "policy_version": { "const": "8.0.0" },
    "current_schema_bundle_version": { "const": "12.0.0" },
    "adapters": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "envelope_version",
          "document_bundle_version",
          "receipt_version",
          "manifest_schema_bundle_version",
          "checkpoint_preferred",
          "blocked_artifact_types"
        ],
        "properties": {
          "envelope_version": {
            "type": "string",
            "pattern": "^startup_opportunity\\.artifact_envelope\\.v[1-9][0-9]*$"
          },
          "document_bundle_version": {
            "type": "string",
            "pattern": "^startup_opportunity\\.document_bundle\\.v[1-9][0-9]*$"
          },
          "receipt_version": {
            "type": "string",
            "pattern": "^startup_opportunity\\.artifact_store_operation\\.v[1-9][0-9]*$"
          },
          "manifest_schema_bundle_version": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "checkpoint_preferred": { "type": "boolean" },
          "blocked_artifact_types": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "../v1/definitions.schema.json#/$defs/schemaVersion" }
          }
        }
      }
    },
    "evidence_contract": { "type": "object" },
    "traceability_contract": { "type": "object" },
    "task_lifecycle_contract": { "type": "object" },
    "branch_status_adapter": { "type": "object" },
    "discovery_lane_status_adapter": { "type": "object" },
    "enrichment_branch_status_adapter": { "type": "object" },
    "report_publication_contract": { "type": "object" },
    "discovery_map_contract": { "type": "object" },
    "discovery_runtime_contract": { "type": "object" },
    "discovery_synthesis_contract": { "type": "object" },
    "discovery_evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_envelope_version",
        "runtime_document_bundle_version",
        "evaluation_policy_ref",
        "evaluation_policy_schema_version",
        "ai_missing_bundle_behavior",
        "report_scan_contract_version",
        "explicit_artifact_input_only",
        "harness_generates_semantics",
        "report_materialization",
        "publication_implies_validation",
        "recovery"
      ],
      "properties": {
        "runtime_envelope_version": { "const": "startup_opportunity.artifact_envelope.v13" },
        "runtime_document_bundle_version": { "const": "startup_opportunity.document_bundle.v13" },
        "evaluation_policy_ref": { "const": "harness/policies/discovery-evaluation.v2.json" },
        "evaluation_policy_schema_version": {
          "const": "startup_opportunity.discovery_evaluation_policy.v2"
        },
        "ai_missing_bundle_behavior": {
          "const": "insufficient_evidence_and_investigate_further_ceiling"
        },
        "report_scan_contract_version": {
          "const": "startup_opportunity.deterministic_forbidden_expression_scan.v1"
        },
        "explicit_artifact_input_only": { "const": true },
        "harness_generates_semantics": { "const": false },
        "report_materialization": { "const": "deterministic_from_validated_report_sidecar" },
        "publication_implies_validation": { "const": false },
        "recovery": { "const": "receipt_driven_fail_closed" }
      }
    },
    "discovery_adaptation_binding_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "policy_schema_version",
        "candidate_pre_kill_skip_binding",
        "shared_unit_behavior",
        "apply_revalidates"
      ],
      "properties": {
        "policy_ref": { "const": "harness/policies/discovery-adaptation-binding.v1.json" },
        "policy_schema_version": {
          "const": "startup_opportunity.discovery_adaptation_binding_policy.v1"
        },
        "candidate_pre_kill_skip_binding": { "const": "exact_exclusive_candidate_input" },
        "shared_unit_behavior": { "const": "retain_or_supersede" },
        "apply_revalidates": { "const": true }
      }
    }
  }
}
