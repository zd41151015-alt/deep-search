{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/user-state-context-model.schema.json",
  "title": "Startup Opportunity User State Context Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "run_id",
    "opportunity_ref",
    "source_snapshot_ref",
    "enrichment_fan_in_ref",
    "state_variables",
    "context_sources",
    "state_update_triggers",
    "feedback_or_ground_truth",
    "collaboration_participants",
    "retention_boundary",
    "privacy_permission_boundary",
    "deletion_export_boundary",
    "data_feedback_moat",
    "unavailable_or_unreliable_inputs",
    "judgment_assessment_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.user_state_context_model.v1"
    },
    "model_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "opportunity_ref": {
      "$ref": "definitions.schema.json#/$defs/opportunityRef"
    },
    "source_snapshot_ref": {
      "$ref": "definitions.schema.json#/$defs/snapshotRef"
    },
    "enrichment_fan_in_ref": {
      "$ref": "definitions.schema.json#/$defs/enrichmentFanInRef"
    },
    "state_variables": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "context_sources": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "state_update_triggers": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "feedback_or_ground_truth": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "collaboration_participants": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "retention_boundary": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "privacy_permission_boundary": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "deletion_export_boundary": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "data_feedback_moat": {
      "enum": ["high", "medium", "low", "unknown", "not_applicable"]
    },
    "unavailable_or_unreliable_inputs": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentJudgmentRef"
      }
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
