{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/sensitivity.schema.json",
  "title": "Startup Opportunity Sensitivity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sensitivity_id",
    "run_id",
    "source_snapshot_ref",
    "comparison_refs",
    "comparison_policy_version",
    "scenario_relations",
    "pairwise_relations",
    "robust_leader_refs",
    "close_to_indistinguishable_groups",
    "evidence_insufficient_for_ordering_refs",
    "most_sensitive_dimensions",
    "stability_band",
    "global_score_used",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.sensitivity.v1"
    },
    "sensitivity_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "source_snapshot_ref": {
      "$ref": "definitions.schema.json#/$defs/snapshotRef"
    },
    "comparison_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/comparisonRef"
      }
    },
    "comparison_policy_version": {
      "const": "1.0.0"
    },
    "scenario_relations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "leader_group_refs",
          "relation",
          "changed_dimensions",
          "limitations"
        ],
        "properties": {
          "scenario": {
            "enum": ["downside", "expected", "upside"]
          },
          "leader_group_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "definitions.schema.json#/$defs/opportunityRef"
            }
          },
          "relation": {
            "enum": [
              "robust_leader",
              "close_to_indistinguishable",
              "evidence_insufficient_for_ordering"
            ]
          },
          "changed_dimensions": {
            "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
          },
          "limitations": {
            "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "pairwise_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_opportunity_ref",
          "right_opportunity_ref",
          "relation",
          "basis_panel_ids",
          "limitations"
        ],
        "properties": {
          "left_opportunity_ref": {
            "$ref": "definitions.schema.json#/$defs/opportunityRef"
          },
          "right_opportunity_ref": {
            "$ref": "definitions.schema.json#/$defs/opportunityRef"
          },
          "relation": {
            "enum": [
              "dominates",
              "dominated_by",
              "close_to_indistinguishable",
              "incomparable",
              "insufficient_evidence"
            ]
          },
          "basis_panel_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "demand_and_market",
                "solution_and_business",
                "evidence_strength",
                "team_fit_and_learning"
              ]
            }
          },
          "limitations": {
            "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "robust_leader_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "close_to_indistinguishable_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "$ref": "definitions.schema.json#/$defs/opportunityRef"
        }
      }
    },
    "evidence_insufficient_for_ordering_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/opportunityRef"
      }
    },
    "most_sensitive_dimensions": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "stability_band": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "global_score_used": {
      "const": false
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
