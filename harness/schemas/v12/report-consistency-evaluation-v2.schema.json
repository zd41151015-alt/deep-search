{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/report-consistency-evaluation-v2.schema.json",
  "title": "Startup Opportunity Discovery Report Consistency Evaluation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "producer_role",
    "owned_output_path",
    "report_ref",
    "decision_brief_ref",
    "report_view_ref",
    "decision_recommendation_ref",
    "traceability_ref",
    "checked_dimensions",
    "forbidden_expression_matches",
    "evaluator_result",
    "evaluation_issues",
    "input_artifact_hashes",
    "valid_as_of",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.report_consistency_evaluation.v2" },
    "evaluation_id": { "$ref": "definitions.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "producer_role": { "const": "harness" },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/consistency-evaluation\\.r[1-9][0-9]*\\.json$"
    },
    "report_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "decision_brief_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "report_view_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "decision_recommendation_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "traceability_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "checked_dimensions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "decision",
          "refs",
          "hashes",
          "freshness",
          "limitations",
          "counter_evidence",
          "partial_order",
          "panel_independence",
          "evidence_ceiling",
          "external_action_boundary",
          "new_conclusions",
          "market_validation_language",
          "probability_language"
        ]
      }
    },
    "forbidden_expression_matches": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
    "evaluator_result": { "$ref": "definitions.schema.json#/$defs/evaluatorResult" },
    "evaluation_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "definitions.schema.json#/$defs/evaluationIssue" }
    },
    "input_artifact_hashes": { "$ref": "definitions.schema.json#/$defs/inputHashes" },
    "valid_as_of": { "type": "string", "format": "date" },
    "limitations": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" }
  }
}
