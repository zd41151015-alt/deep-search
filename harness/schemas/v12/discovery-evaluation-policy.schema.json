{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/discovery-evaluation-policy.schema.json",
  "title": "Startup Opportunity Discovery Evaluation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "schema_bundle_version",
    "eligible_branch_statuses",
    "excluded_branch_statuses",
    "required_hard_gates",
    "required_comparison_panels",
    "recommendation_ceiling",
    "publication_order",
    "reporting_contract",
    "execution_boundary"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.discovery_evaluation_policy.v1" },
    "policy_id": { "const": "startup_opportunity.g2_4_evaluation" },
    "policy_version": { "const": "1.0.0" },
    "schema_bundle_version": { "const": "11.0.0" },
    "eligible_branch_statuses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["completed", "partial", "insufficient_evidence"] }
    },
    "excluded_branch_statuses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["failed", "ignored_late", "superseded"] }
    },
    "required_hard_gates": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_comparison_panels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "demand_and_market",
          "solution_and_business",
          "evidence_strength",
          "team_fit_and_learning"
        ]
      }
    },
    "recommendation_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_gate",
        "insufficient_gate",
        "weak_or_unknown_evidence",
        "partial_branch",
        "missing_ai_bundle",
        "business_engine_unknown",
        "external_validation_missing"
      ],
      "properties": {
        "failed_gate": { "const": "reject" },
        "insufficient_gate": { "const": "investigate_further" },
        "weak_or_unknown_evidence": { "const": "investigate_further" },
        "partial_branch": { "const": "investigate_further" },
        "missing_ai_bundle": { "const": "investigate_further" },
        "business_engine_unknown": { "const": "investigate_further" },
        "external_validation_missing": { "const": "no_automatic_downgrade_beyond_evidence_ceiling" }
      }
    },
    "publication_order": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "enrichment_task",
          "typed_material",
          "enrichment_branch",
          "enrichment_fan_in",
          "domain_enrichment",
          "opportunity_comparison",
          "sensitivity",
          "portfolio",
          "decision_recommendation",
          "traceability",
          "report"
        ]
      }
    },
    "reporting_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structured_source",
        "materialized_views",
        "consistency_required",
        "consistency_dimensions",
        "global_score_forbidden",
        "market_validation_claim_forbidden"
      ],
      "properties": {
        "structured_source": { "const": "startup_opportunity.report.v1" },
        "materialized_views": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["decision-brief.md", "report.md"] }
        },
        "consistency_required": { "const": true },
        "consistency_dimensions": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "enum": [
              "decision",
              "refs",
              "hashes",
              "freshness",
              "limitations",
              "counter_evidence",
              "partial_order",
              "panel_independence",
              "evidence_ceiling",
              "external_action_boundary",
              "new_conclusions",
              "market_validation_language",
              "probability_language"
            ]
          }
        },
        "global_score_forbidden": { "const": true },
        "market_validation_claim_forbidden": { "const": true }
      }
    },
    "execution_boundary": { "$ref": "definitions.schema.json#/$defs/executionBoundary" }
  }
}
