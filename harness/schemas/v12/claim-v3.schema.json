{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/claim-v3.schema.json",
  "title": "Startup Opportunity Enrichment Claim v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "run_id",
    "unit_id",
    "lineage",
    "claim_type",
    "statement",
    "stance",
    "evidence_refs",
    "confidence_band",
    "sample_bias",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.claim.v3"
    },
    "claim_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "unit_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "lineage": {
      "$ref": "definitions.schema.json#/$defs/enrichmentLineage"
    },
    "claim_type": {
      "enum": [
        "competitor_gap",
        "market_space",
        "monetization",
        "buyer_signal",
        "acquisition_signal",
        "business_engine",
        "delivery_feasibility",
        "compliance_platform_risk",
        "counter_evidence",
        "unit_economics",
        "source_limitation"
      ]
    },
    "statement": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "stance": {
      "enum": ["support", "oppose"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentEvidenceRef"
      }
    },
    "confidence_band": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "sample_bias": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
