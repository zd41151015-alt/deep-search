{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/opportunity-comparison.schema.json",
  "title": "Startup Opportunity Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "revision",
    "parent_comparison_ref",
    "parent_content_hash",
    "run_id",
    "scope_frame_ref",
    "research_plan_ref",
    "source_snapshot_ref",
    "source_merge_ref",
    "enrichment_fan_in_ref",
    "opportunity_ref",
    "value_layer_analysis_ref",
    "user_state_context_model_ref",
    "buyer_purchase_language_ref",
    "business_engine_ref",
    "comparison_policy_version",
    "rubric_version",
    "input_artifact_hashes",
    "hard_gates_evaluated_at",
    "compared_at",
    "hard_gate_results",
    "hard_gate_outcome",
    "recommendation_band",
    "decision_value_band",
    "uncertainty_band",
    "comparison_panels",
    "ordering_mode",
    "judgment_assessment_refs",
    "what_would_change_the_decision",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.opportunity_comparison.v1"
    },
    "comparison_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_comparison_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/comparisonRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_content_hash": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "scope_frame_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "research_plan_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "source_snapshot_ref": {
      "$ref": "definitions.schema.json#/$defs/snapshotRef"
    },
    "source_merge_ref": {
      "$ref": "definitions.schema.json#/$defs/mergeRef"
    },
    "enrichment_fan_in_ref": {
      "$ref": "definitions.schema.json#/$defs/enrichmentFanInRef"
    },
    "opportunity_ref": {
      "$ref": "definitions.schema.json#/$defs/opportunityRef"
    },
    "value_layer_analysis_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "user_state_context_model_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "buyer_purchase_language_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "business_engine_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "comparison_policy_version": {
      "const": "1.0.0"
    },
    "rubric_version": {
      "const": "1.0.0"
    },
    "input_artifact_hashes": {
      "$ref": "definitions.schema.json#/$defs/inputHashes"
    },
    "hard_gates_evaluated_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    },
    "compared_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    },
    "hard_gate_results": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "judgment_assessment_refs", "rationale", "limitations"],
        "properties": {
          "gate_id": {
            "enum": [
              "user_jtbd_entry_scene",
              "baseline_delta",
              "buyer_purchase",
              "business_engine",
              "source_independence",
              "generation_evaluation_separation",
              "opposing_evidence",
              "compliance_boundary",
              "ai_mandatory_bundle",
              "ai_baseline_gap",
              "ai_reliability",
              "data_rights",
              "unit_economics"
            ]
          },
          "status": {
            "enum": ["passed", "failed", "insufficient_evidence", "not_applicable"]
          },
          "judgment_assessment_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "definitions.schema.json#/$defs/enrichmentJudgmentRef"
            }
          },
          "rationale": {
            "$ref": "definitions.schema.json#/$defs/nonEmptyString"
          },
          "limitations": {
            "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "hard_gate_outcome": {
      "enum": ["eligible", "watchlist", "reject", "insufficient_evidence"]
    },
    "recommendation_band": {
      "enum": ["strong_candidate", "investigate_further", "watchlist", "reject"]
    },
    "decision_value_band": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "uncertainty_band": {
      "enum": ["low", "medium", "high", "unknown"]
    },
    "comparison_panels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel_id",
          "band",
          "dimension_assessments",
          "decision_sufficiency",
          "source_overlap",
          "limitations"
        ],
        "properties": {
          "panel_id": {
            "enum": [
              "demand_and_market",
              "solution_and_business",
              "evidence_strength",
              "team_fit_and_learning"
            ]
          },
          "band": {
            "enum": ["strong", "medium", "weak", "unknown", "not_applicable"]
          },
          "dimension_assessments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "band",
                "observable_anchors",
                "supporting_refs",
                "opposing_refs",
                "limitations"
              ],
              "properties": {
                "dimension": {
                  "$ref": "definitions.schema.json#/$defs/identifier"
                },
                "band": {
                  "enum": ["strong", "medium", "weak", "unknown", "not_applicable"]
                },
                "observable_anchors": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                },
                "supporting_refs": {
                  "$ref": "definitions.schema.json#/$defs/artifactRefArray"
                },
                "opposing_refs": {
                  "$ref": "definitions.schema.json#/$defs/artifactRefArray"
                },
                "limitations": {
                  "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
                }
              }
            }
          },
          "decision_sufficiency": {
            "enum": ["sufficient", "partial", "insufficient", "not_applicable"]
          },
          "source_overlap": {
            "enum": ["none", "low", "high", "unknown", "not_applicable"]
          },
          "limitations": {
            "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
          }
        }
      }
    },
    "ordering_mode": {
      "const": "partial_order"
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentJudgmentRef"
      }
    },
    "what_would_change_the_decision": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
