{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/value-layer-analysis.schema.json",
  "title": "Startup Opportunity Value Layer Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "run_id",
    "opportunity_ref",
    "source_snapshot_ref",
    "enrichment_fan_in_ref",
    "primary_value_layer",
    "output_value",
    "workflow_value",
    "outcome_metrics",
    "baseline_outcome",
    "expected_delta",
    "measurement_feasibility",
    "supporting_claim_refs",
    "opposing_claim_refs",
    "judgment_assessment_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.value_layer_analysis.v1"
    },
    "analysis_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "opportunity_ref": {
      "$ref": "definitions.schema.json#/$defs/opportunityRef"
    },
    "source_snapshot_ref": {
      "$ref": "definitions.schema.json#/$defs/snapshotRef"
    },
    "enrichment_fan_in_ref": {
      "$ref": "definitions.schema.json#/$defs/enrichmentFanInRef"
    },
    "primary_value_layer": {
      "enum": ["output", "workflow", "outcome", "unknown"]
    },
    "output_value": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "workflow_value": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "outcome_metrics": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "baseline_outcome": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "expected_delta": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "measurement_feasibility": {
      "enum": ["high", "medium", "low", "unknown"]
    },
    "supporting_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentClaimRef"
      }
    },
    "opposing_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentClaimRef"
      }
    },
    "judgment_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/enrichmentJudgmentRef"
      }
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  }
}
