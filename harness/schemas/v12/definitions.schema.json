{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v12/definitions.schema.json",
  "$defs": {
    "nonEmptyString": { "$ref": "../v1/definitions.schema.json#/$defs/nonEmptyString" },
    "identifier": { "$ref": "../v1/definitions.schema.json#/$defs/identifier" },
    "runId": { "$ref": "../v1/definitions.schema.json#/$defs/runId" },
    "timestamp": { "$ref": "../v1/definitions.schema.json#/$defs/timestamp" },
    "sha256": { "$ref": "../v1/definitions.schema.json#/$defs/sha256" },
    "artifactPath": { "$ref": "../v1/definitions.schema.json#/$defs/artifactPath" },
    "artifactRef": { "$ref": "../v1/definitions.schema.json#/$defs/artifactRef" },
    "artifactRefArray": { "$ref": "../v1/definitions.schema.json#/$defs/artifactRefArray" },
    "uniqueStringArray": { "$ref": "../v1/definitions.schema.json#/$defs/uniqueStringArray" },
    "inputHashes": { "$ref": "../v7/definitions.schema.json#/$defs/inputHashes" },
    "beliefUpdate": { "$ref": "../v7/definitions.schema.json#/$defs/beliefUpdate" },
    "externalActionBoundary": {
      "$ref": "../v7/definitions.schema.json#/$defs/externalActionBoundary"
    },
    "evaluatorResult": { "$ref": "../v7/definitions.schema.json#/$defs/evaluatorResult" },
    "evaluationIssue": { "$ref": "../v7/definitions.schema.json#/$defs/evaluationIssue" },
    "candidateRef": { "$ref": "../v9/definitions.schema.json#/$defs/candidateRef" },
    "opportunityRef": { "$ref": "../v11/definitions.schema.json#/$defs/opportunityRef" },
    "snapshotRef": { "$ref": "../v11/definitions.schema.json#/$defs/snapshotRef" },
    "mergeRef": { "$ref": "../v11/definitions.schema.json#/$defs/mergeRef" },
    "enrichmentTaskRef": {
      "type": "string",
      "pattern": "^tasks/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
    },
    "enrichmentBranchRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/enrichment/branches/[A-Za-z0-9][A-Za-z0-9._-]*\\.attempt-[1-9][0-9]*\\.json$"
    },
    "enrichmentFanInRef": {
      "type": "string",
      "pattern": "^artifacts/discovery/enrichment/fan-in\\.r[1-9][0-9]*\\.json$"
    },
    "enrichmentEvidenceRef": {
      "type": "string",
      "pattern": "^evidence/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentClaimRef": {
      "type": "string",
      "pattern": "^claims/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentFindingRef": {
      "type": "string",
      "pattern": "^findings/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentInsightRef": {
      "type": "string",
      "pattern": "^insights/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentJudgmentRef": {
      "type": "string",
      "pattern": "^judgments/discovery/enrichment/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "enrichmentSourceManifestRef": {
      "type": "string",
      "pattern": "^evidence/discovery/enrichment/source-manifests/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "comparisonRef": {
      "type": "string",
      "pattern": "^artifacts/comparison/opportunities/[A-Za-z0-9][A-Za-z0-9._-]*\\.r[1-9][0-9]*\\.json$"
    },
    "revisionBase": { "$ref": "../v11/definitions.schema.json#/$defs/revisionBase" },
    "enrichmentLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ref",
        "unit_id",
        "attempt",
        "opportunity_refs",
        "source_snapshot_ref",
        "source_merge_ref",
        "scope_frame_ref",
        "research_plan_ref"
      ],
      "properties": {
        "task_ref": { "$ref": "#/$defs/enrichmentTaskRef" },
        "unit_id": { "$ref": "#/$defs/identifier" },
        "attempt": { "type": "integer", "minimum": 1 },
        "opportunity_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opportunityRef" }
        },
        "source_snapshot_ref": { "$ref": "#/$defs/snapshotRef" },
        "source_merge_ref": { "$ref": "#/$defs/mergeRef" },
        "scope_frame_ref": { "$ref": "#/$defs/artifactRef" },
        "research_plan_ref": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_artifacts_explicit",
        "harness_generated_research",
        "harness_generated_judgment",
        "agent_dispatch",
        "hidden_llm_calls",
        "network_research",
        "external_validation",
        "publication_implies_validation"
      ],
      "properties": {
        "formal_artifacts_explicit": { "const": true },
        "harness_generated_research": { "const": false },
        "harness_generated_judgment": { "const": false },
        "agent_dispatch": { "const": false },
        "hidden_llm_calls": { "const": false },
        "network_research": { "const": false },
        "external_validation": { "const": false },
        "publication_implies_validation": { "const": false }
      }
    },
    "decisionSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "conclusion_ceiling",
        "insufficiency_reasons",
        "what_would_change_the_decision"
      ],
      "properties": {
        "status": { "enum": ["sufficient", "partial", "insufficient"] },
        "conclusion_ceiling": {
          "enum": [
            "strong_candidate",
            "investigate_further",
            "watchlist",
            "reject",
            "insufficient_evidence"
          ]
        },
        "insufficiency_reasons": { "$ref": "#/$defs/uniqueStringArray" },
        "what_would_change_the_decision": { "$ref": "#/$defs/uniqueStringArray" }
      }
    },
    "summaryRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "refs"],
        "properties": {
          "summary": { "$ref": "#/$defs/nonEmptyString" },
          "refs": { "$ref": "#/$defs/artifactRefArray" }
        }
      }
    }
  }
}
