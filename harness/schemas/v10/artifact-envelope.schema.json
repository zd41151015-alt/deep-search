{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v10/artifact-envelope.schema.json",
  "title": "Startup Opportunity G2.2 Runtime Artifact Envelope v10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v10" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.discovery_candidate.v1",
        "startup_opportunity.research_task.v2",
        "startup_opportunity.evidence.v2",
        "startup_opportunity.claim.v2",
        "startup_opportunity.finding.v2",
        "startup_opportunity.insight.v2",
        "startup_opportunity.judgment_assessment.v2",
        "startup_opportunity.source_manifest.v2",
        "startup_opportunity.discovery_lane_result.v1",
        "startup_opportunity.discovery_fan_in.v2",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "../v9/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v9/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v9/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["main_agent", "lane_researcher", "harness"] },
    "input_refs": { "$ref": "../v9/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v9/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.discovery_candidate.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v9/discovery-candidate.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.research_task.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v9/research-task-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.evidence.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/evidence-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.claim.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/claim-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.finding.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/finding-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.insight.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/insight-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.judgment_assessment.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/judgment-assessment-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.source_manifest.v2" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/source-manifest-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.discovery_lane_result.v1" },
        "producer_role": { "const": "lane_researcher" },
        "document": { "$ref": "../v9/discovery-lane-result.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.discovery_fan_in.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "discovery-fan-in-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    }
  ]
}
