{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v10/research-publication-policy-v5.schema.json",
  "title": "Startup Opportunity Research Publication Policy v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "current_schema_bundle_version",
    "adapters",
    "evidence_contract",
    "traceability_contract",
    "task_lifecycle_contract",
    "branch_status_adapter",
    "discovery_lane_status_adapter",
    "report_publication_contract",
    "discovery_map_contract",
    "discovery_runtime_contract"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.research_publication_policy.v5" },
    "policy_id": { "const": "startup_opportunity.g2_2_research_publication" },
    "policy_version": { "const": "5.0.0" },
    "current_schema_bundle_version": { "const": "9.0.0" },
    "adapters": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "envelope_version",
          "document_bundle_version",
          "receipt_version",
          "manifest_schema_bundle_version",
          "checkpoint_preferred",
          "blocked_artifact_types"
        ],
        "properties": {
          "envelope_version": {
            "enum": [
              "startup_opportunity.artifact_envelope.v1",
              "startup_opportunity.artifact_envelope.v2",
              "startup_opportunity.artifact_envelope.v3",
              "startup_opportunity.artifact_envelope.v4",
              "startup_opportunity.artifact_envelope.v5",
              "startup_opportunity.artifact_envelope.v6",
              "startup_opportunity.artifact_envelope.v7",
              "startup_opportunity.artifact_envelope.v8",
              "startup_opportunity.artifact_envelope.v10"
            ]
          },
          "document_bundle_version": {
            "enum": [
              "startup_opportunity.document_bundle.v1",
              "startup_opportunity.document_bundle.v2",
              "startup_opportunity.document_bundle.v3",
              "startup_opportunity.document_bundle.v4",
              "startup_opportunity.document_bundle.v5",
              "startup_opportunity.document_bundle.v6",
              "startup_opportunity.document_bundle.v7",
              "startup_opportunity.document_bundle.v8",
              "startup_opportunity.document_bundle.v10"
            ]
          },
          "receipt_version": {
            "enum": [
              "startup_opportunity.artifact_store_operation.v1",
              "startup_opportunity.artifact_store_operation.v2",
              "startup_opportunity.artifact_store_operation.v3",
              "startup_opportunity.artifact_store_operation.v4",
              "startup_opportunity.artifact_store_operation.v5",
              "startup_opportunity.artifact_store_operation.v6",
              "startup_opportunity.artifact_store_operation.v7",
              "startup_opportunity.artifact_store_operation.v8"
            ]
          },
          "manifest_schema_bundle_version": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "checkpoint_preferred": { "type": "boolean" },
          "blocked_artifact_types": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "../v1/definitions.schema.json#/$defs/schemaVersion" }
          }
        }
      }
    },
    "evidence_contract": { "type": "object" },
    "traceability_contract": { "type": "object" },
    "task_lifecycle_contract": { "type": "object" },
    "branch_status_adapter": { "type": "object" },
    "discovery_lane_status_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "partial",
        "insufficient_evidence",
        "failed",
        "ignored_late",
        "superseded"
      ],
      "properties": {
        "completed": { "const": "completed_units" },
        "partial": { "const": "completed_units" },
        "insufficient_evidence": { "const": "completed_units" },
        "failed": { "const": "failed_units" },
        "ignored_late": { "const": "ignored_late_artifact_refs" },
        "superseded": { "const": "superseded_units_existing" }
      }
    },
    "report_publication_contract": { "type": "object" },
    "discovery_map_contract": { "type": "object" },
    "discovery_runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_envelope_version",
        "runtime_envelope_version",
        "runtime_document_bundle_version",
        "task_artifact_type",
        "lane_artifact_type",
        "fan_in_artifact_type",
        "explicit_artifact_input_only",
        "harness_dispatches_agent",
        "hidden_llm_calls",
        "network_research",
        "external_validation",
        "recovery"
      ],
      "properties": {
        "contract_envelope_version": { "const": "startup_opportunity.artifact_envelope.v9" },
        "runtime_envelope_version": { "const": "startup_opportunity.artifact_envelope.v10" },
        "runtime_document_bundle_version": { "const": "startup_opportunity.document_bundle.v10" },
        "task_artifact_type": { "const": "startup_opportunity.research_task.v2" },
        "lane_artifact_type": { "const": "startup_opportunity.discovery_lane_result.v1" },
        "fan_in_artifact_type": { "const": "startup_opportunity.discovery_fan_in.v2" },
        "explicit_artifact_input_only": { "const": true },
        "harness_dispatches_agent": { "const": false },
        "hidden_llm_calls": { "const": false },
        "network_research": { "const": false },
        "external_validation": { "const": false },
        "recovery": { "const": "receipt_driven_fail_closed" }
      }
    }
  }
}
