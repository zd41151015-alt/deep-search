{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v10/document-bundle.schema.json",
  "title": "Startup Opportunity G2.2 Runtime Document Bundle v10",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents", "exact_records"],
  "properties": {
    "schema_version": { "const": "startup_opportunity.document_bundle.v10" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "document"],
        "properties": {
          "path": { "$ref": "../v9/definitions.schema.json#/$defs/artifactPath" },
          "document": { "type": "object" }
        }
      }
    },
    "exact_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "document"],
        "properties": {
          "ref": { "$ref": "../v9/definitions.schema.json#/$defs/artifactRef" },
          "document": {
            "oneOf": [
              { "$ref": "../v5/evidence-substrate-record.schema.json" },
              { "$ref": "../v1/event.schema.json" },
              { "$ref": "../v1/decision.schema.json" }
            ]
          }
        }
      }
    }
  }
}
