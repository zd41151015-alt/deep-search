{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v11/artifact-envelope.schema.json",
  "title": "Startup Opportunity G2.3 Synthesis Artifact Envelope v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v11" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.discovery_candidate_conversion.v2",
        "startup_opportunity.demand_thesis.v1",
        "startup_opportunity.baseline_option.v1",
        "startup_opportunity.solution_hypothesis.v1",
        "startup_opportunity.solution_evaluation.v1",
        "startup_opportunity.opportunity_thesis.v1",
        "startup_opportunity.thesis_evaluation_snapshot.v1",
        "startup_opportunity.merge.v1",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["main_agent", "harness"] },
    "input_refs": { "$ref": "definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.discovery_candidate_conversion.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "discovery-candidate-conversion-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.demand_thesis.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "demand-thesis.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.baseline_option.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "baseline-option.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.solution_hypothesis.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "solution-hypothesis.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.solution_evaluation.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "solution-evaluation.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.opportunity_thesis.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "opportunity-thesis.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.thesis_evaluation_snapshot.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "thesis-evaluation-snapshot.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.merge.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "merge.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    }
  ]
}
