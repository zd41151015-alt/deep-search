{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v2/ai-trigger-source-binding-policy.schema.json",
  "title": "Startup Opportunity AI Trigger Source Binding Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "compatible_schema_bundle_versions",
    "base_adaptation_policy_binding",
    "contract_versions",
    "source_resolution",
    "source_content_hash_algorithm",
    "required_exact_bindings",
    "future_declared_source_schemas",
    "stale_on_change"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.ai_trigger_source_binding_policy.v1"
    },
    "policy_id": { "const": "startup_opportunity.ai_trigger_source_binding" },
    "policy_version": { "const": "1.0.0" },
    "compatible_schema_bundle_versions": {
      "type": "array",
      "prefixItems": [{ "const": "2.1.0" }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "base_adaptation_policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "schema_version", "policy_version", "content_hash"],
      "properties": {
        "policy_ref": { "const": "harness/policies/adaptation.v1.json" },
        "schema_version": { "const": "startup_opportunity.adaptation_policy.v1" },
        "policy_version": { "const": "1.0.0" },
        "content_hash": { "$ref": "../v1/definitions.schema.json#/$defs/sha256" }
      }
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_context", "source_attestation", "trigger"],
      "properties": {
        "planning_context": { "const": "startup_opportunity.planning_context.v2" },
        "source_attestation": {
          "const": "startup_opportunity.ai_trigger_source_attestation.v1"
        },
        "trigger": {
          "const": "startup_opportunity.ai_mandatory_coverage_trigger.v1"
        }
      }
    },
    "source_resolution": { "const": "explicit_document_bundle_path" },
    "source_content_hash_algorithm": { "const": "canonical_json_sha256.v1" },
    "required_exact_bindings": {
      "type": "array",
      "prefixItems": [
        { "const": "run_id" },
        { "const": "mode" },
        { "const": "planning_context.context_id" },
        { "const": "planning_context.revision" },
        { "const": "subject_ref" },
        { "const": "trigger.trigger_version" },
        { "const": "trigger.signal" },
        { "const": "trigger.declared_value" }
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "future_declared_source_schemas": { "const": "forbidden" },
    "stale_on_change": {
      "type": "array",
      "prefixItems": [
        { "const": "source_ref" },
        { "const": "source_schema_version" },
        { "const": "source_content_hash" },
        { "const": "exact_binding" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
