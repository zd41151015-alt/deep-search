{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v2/coverage-attestation.schema.json",
  "title": "Startup Opportunity Coverage Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage_key",
    "relation",
    "run_id",
    "based_on_plan_ref",
    "based_on_plan_revision",
    "based_on_plan_hash",
    "gap_ref",
    "subject_ref",
    "target_unit_ref",
    "gap_research_goal",
    "target_research_goal",
    "semantic_equivalence_declared",
    "declared_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.coverage_attestation.v1"
    },
    "coverage_key": {
      "$ref": "../v1/definitions.schema.json#/$defs/sha256"
    },
    "relation": {
      "const": "same_subject_and_semantically_equivalent_research_goal"
    },
    "run_id": {
      "$ref": "../v1/definitions.schema.json#/$defs/runId"
    },
    "based_on_plan_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/planRef"
    },
    "based_on_plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "based_on_plan_hash": {
      "$ref": "../v1/definitions.schema.json#/$defs/sha256"
    },
    "gap_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/gapRef"
    },
    "subject_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/artifactRef"
    },
    "target_unit_ref": {
      "type": "string",
      "pattern": "^plans/research-plan\\.r[1-9][0-9]*\\.json#[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "gap_research_goal": {
      "$ref": "../v1/definitions.schema.json#/$defs/nonEmptyString"
    },
    "target_research_goal": {
      "$ref": "../v1/definitions.schema.json#/$defs/nonEmptyString"
    },
    "semantic_equivalence_declared": {
      "const": true
    },
    "declared_by": {
      "const": "main_agent"
    },
    "created_at": {
      "$ref": "../v1/definitions.schema.json#/$defs/timestamp"
    }
  }
}
