{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v2/adaptation-policy.schema.json",
  "title": "Startup Opportunity Adaptation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "contract_versions",
    "phase_catalog",
    "artifact_schema_catalog",
    "unit_rules",
    "coverage_contract",
    "retry_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.adaptation_policy.v1"
    },
    "policy_id": {
      "const": "startup_opportunity.closed_planning_and_adaptation"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_context",
        "research_plan",
        "adaptation_decision",
        "coverage_attestation",
        "run_manifest"
      ],
      "properties": {
        "planning_context": {
          "const": "startup_opportunity.planning_context.v1"
        },
        "research_plan": {
          "const": "startup_opportunity.research_plan.v1"
        },
        "adaptation_decision": {
          "const": "startup_opportunity.adaptation_decision.discovery.current"
        },
        "coverage_attestation": {
          "const": "startup_opportunity.coverage_attestation.v1"
        },
        "run_manifest": {
          "const": "startup_opportunity.run_manifest.v1"
        }
      }
    },
    "phase_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "phase"],
        "properties": {
          "mode": {
            "$ref": "../v1/definitions.schema.json#/$defs/mode"
          },
          "phase": {
            "enum": ["discovery", "enrichment", "assessment", "review"]
          }
        }
      }
    },
    "artifact_schema_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../v1/definitions.schema.json#/$defs/schemaVersion"
      }
    },
    "unit_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "phase", "unit_type", "agent_role", "required_artifact_schema"],
        "properties": {
          "mode": {
            "$ref": "../v1/definitions.schema.json#/$defs/mode"
          },
          "phase": {
            "enum": ["discovery", "enrichment", "assessment", "review"]
          },
          "unit_type": {
            "$ref": "../v1/definitions.schema.json#/$defs/unitType"
          },
          "agent_role": {
            "enum": ["lane-researcher", "evidence-auditor", "adversarial-reviewer"]
          },
          "required_artifact_schema": {
            "$ref": "../v1/definitions.schema.json#/$defs/schemaVersion"
          }
        }
      }
    },
    "coverage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "key_algorithm",
        "allowed_manifest_states",
        "require_exact_gap_and_unit_refs",
        "require_subject_in_unit_inputs",
        "semantic_equivalence_owner"
      ],
      "properties": {
        "relation": {
          "const": "same_subject_and_semantically_equivalent_research_goal"
        },
        "key_algorithm": {
          "const": "canonical_json_sha256.v1"
        },
        "allowed_manifest_states": {
          "type": "array",
          "prefixItems": [
            {
              "const": "pending"
            },
            {
              "const": "active"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "require_exact_gap_and_unit_refs": {
          "const": true
        },
        "require_subject_in_unit_inputs": {
          "const": true
        },
        "semantic_equivalence_owner": {
          "const": "main_agent"
        }
      }
    },
    "retry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanical_precondition", "partial_artifact_retry"],
      "properties": {
        "mechanical_precondition": {
          "const": "manifest.failed_units"
        },
        "partial_artifact_retry": {
          "const": "fail_closed"
        }
      }
    }
  }
}
