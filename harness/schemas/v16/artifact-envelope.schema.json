{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v16/artifact-envelope.schema.json",
  "title": "Startup Opportunity G3.3 Artifact Envelope v16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v16" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.ai_mandatory_bundle.v1",
        "startup_opportunity.opportunity_comparison.v1",
        "startup_opportunity.decision_recommendation.v1",
        "startup_opportunity.traceability.v2",
        "startup_opportunity.report.v1",
        "startup_opportunity.decision_brief.v2",
        "startup_opportunity.discovery_report_view.v1",
        "startup_opportunity.report_consistency_evaluation.v3",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["lane_researcher", "main_agent", "harness"] },
    "input_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" },
    "ai_bundle_binding": { "$ref": "ai-bundle-definitions.schema.json#/$defs/consumerBinding" },
    "document": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.ai_mandatory_bundle.v1" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "lane_researcher" },
          "document": { "$ref": "ai-mandatory-bundle.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "startup_opportunity.opportunity_comparison.v1",
              "startup_opportunity.decision_recommendation.v1",
              "startup_opportunity.traceability.v2",
              "startup_opportunity.report.v1",
              "startup_opportunity.decision_brief.v2",
              "startup_opportunity.discovery_report_view.v1",
              "startup_opportunity.report_consistency_evaluation.v3"
            ]
          }
        }
      },
      "then": { "required": ["ai_bundle_binding"] }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.opportunity_comparison.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "document": { "$ref": "../v12/opportunity-comparison.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.decision_recommendation.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "document": { "$ref": "../v12/decision-recommendation.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.traceability.v2" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "document": { "$ref": "../v12/traceability-v2.schema.json" }
        }
      }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "startup_opportunity.report.v1" } } },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "document": { "$ref": "../v12/discovery-report.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.decision_brief.v2" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v12/decision-brief-v2.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.discovery_report_view.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v12/discovery-report-view.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.report_consistency_evaluation.v3" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v13/report-consistency-evaluation-v3.schema.json" }
        }
      }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "startup_opportunity.checkpoint.v1" } } },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v1/checkpoint.schema.json" }
        }
      }
    }
  ]
}
