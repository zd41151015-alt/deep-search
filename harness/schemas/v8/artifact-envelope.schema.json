{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v8/artifact-envelope.schema.json",
  "title": "Startup Opportunity G2.1 Artifact Envelope v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v8" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.checkpoint.v1",
        "startup_opportunity.intake.v1",
        "startup_opportunity.decision_context.v1",
        "startup_opportunity.scope_frame.v2",
        "startup_opportunity.research_plan.v1",
        "startup_opportunity.planning_context.v2",
        "startup_opportunity.seed_probe.v1",
        "startup_opportunity.opportunity_space_map.v1",
        "startup_opportunity.solution_space_map.v1"
      ]
    },
    "artifact_path": { "$ref": "definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["main_agent", "harness"] },
    "input_refs": { "$ref": "definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "producer_role": { "const": "harness" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.intake.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v4/intake.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.decision_context.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v4/decision-context.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.scope_frame.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "scope-frame-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.research_plan.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v1/research-plan.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.planning_context.v2" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "../v2/planning-context-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.seed_probe.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "seed-probe.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.opportunity_space_map.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "opportunity-space-map.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.solution_space_map.v1" },
        "producer_role": { "const": "main_agent" },
        "document": { "$ref": "solution-space-map.schema.json" }
      }
    }
  ]
}
