{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v8/scope-frame-v2.schema.json",
  "title": "Startup Opportunity Discovery Scope Frame v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "decision_context_ref",
    "direction",
    "discovery_profile",
    "research_axes",
    "market",
    "language",
    "target_users",
    "excluded_users",
    "platform",
    "market_motion",
    "acquisition_motion",
    "buyer_models",
    "payment_modes",
    "native_app_required",
    "delivery_form_preferences",
    "business_model_preferences",
    "team_capability_constraints",
    "risk_preferences",
    "ai_scope",
    "assumptions",
    "open_questions"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.scope_frame.v2" },
    "run_id": { "$ref": "definitions.schema.json#/$defs/runId" },
    "mode": { "const": "opportunity_discovery" },
    "decision_context_ref": { "$ref": "definitions.schema.json#/$defs/artifactRef" },
    "direction": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "discovery_profile": { "$ref": "definitions.schema.json#/$defs/discoveryProfile" },
    "research_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "user_language",
          "industry_demand",
          "jtbd_workflow",
          "solution_failure",
          "competitor_gap",
          "buyer_market",
          "distribution",
          "ai_capability",
          "regulation"
        ]
      }
    },
    "market": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "language": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "target_users": {
      "allOf": [
        { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
        { "type": "array", "minItems": 1 }
      ]
    },
    "excluded_users": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
    "platform": { "$ref": "definitions.schema.json#/$defs/nonEmptyString" },
    "market_motion": { "const": "consumer" },
    "acquisition_motion": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["direct", "community", "channel", "marketplace"] }
    },
    "buyer_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["self_payer", "household_payer", "sponsor_payer", "provider_channel"]
      }
    },
    "payment_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "subscription",
          "one_time",
          "transaction",
          "service_fee",
          "referral",
          "free_with_indirect_revenue"
        ]
      }
    },
    "native_app_required": { "type": "boolean" },
    "delivery_form_preferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "../v4/definitions.schema.json#/$defs/deliveryForm" }
    },
    "business_model_preferences": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
    "team_capability_constraints": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "risk_preferences": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
    "ai_scope": { "enum": ["excluded", "optional", "priority_seed"] },
    "assumptions": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" },
    "open_questions": { "$ref": "definitions.schema.json#/$defs/uniqueStringArray" }
  }
}
