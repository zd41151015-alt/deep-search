{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v4/concept-evidence-assessment-plan.schema.json",
  "title": "Startup Opportunity Concept Evidence Assessment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_plan_id",
    "run_id",
    "revision",
    "parent_plan_ref",
    "research_plan_ref",
    "triggered_by_adaptation_refs",
    "created_at",
    "concept_hypothesis_ref",
    "assessment_profile",
    "dimensions",
    "mandatory_bundles",
    "followup_policy",
    "assessment_gate_version",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.concept_evidence_assessment_plan.v1"
    },
    "assessment_plan_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_plan_ref": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/assessmentPlanRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "research_plan_ref": {
      "$ref": "../v1/definitions.schema.json#/$defs/planRef"
    },
    "triggered_by_adaptation_refs": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/adaptationRef"
      },
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "definitions.schema.json#/$defs/timestamp"
    },
    "concept_hypothesis_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "assessment_profile": {
      "$ref": "definitions.schema.json#/$defs/assessmentProfile"
    },
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "hypothesis",
          "decision_impact",
          "required_evidence_types",
          "supporting_questions",
          "disconfirming_questions",
          "branch_unit_type",
          "stop_condition"
        ],
        "properties": {
          "dimension_id": {
            "$ref": "definitions.schema.json#/$defs/assessmentDimension"
          },
          "hypothesis": {
            "$ref": "definitions.schema.json#/$defs/nonEmptyString"
          },
          "decision_impact": {
            "type": "array",
            "items": {
              "$ref": "definitions.schema.json#/$defs/decisionImpact"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required_evidence_types": {
            "type": "array",
            "items": {
              "$ref": "definitions.schema.json#/$defs/evidenceTier"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "supporting_questions": {
            "type": "array",
            "items": {
              "$ref": "definitions.schema.json#/$defs/nonEmptyString"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "disconfirming_questions": {
            "type": "array",
            "items": {
              "$ref": "definitions.schema.json#/$defs/nonEmptyString"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "branch_unit_type": {
            "$ref": "../v1/definitions.schema.json#/$defs/unitType"
          },
          "stop_condition": {
            "$ref": "definitions.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "mandatory_bundles": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "followup_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_followup_rounds",
        "require_decision_relevance",
        "stop_when_no_material_new_evidence"
      ],
      "properties": {
        "max_followup_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "require_decision_relevance": {
          "const": true
        },
        "stop_when_no_material_new_evidence": {
          "const": true
        }
      }
    },
    "assessment_gate_version": {
      "$ref": "../v1/definitions.schema.json#/$defs/semanticVersion"
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "parent_plan_ref": {
            "type": "null"
          },
          "triggered_by_adaptation_refs": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "parent_plan_ref": {
            "$ref": "definitions.schema.json#/$defs/assessmentPlanRef"
          },
          "triggered_by_adaptation_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
