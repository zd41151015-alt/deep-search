{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v4/judgment-assessment.schema.json",
  "title": "Startup Opportunity Judgment Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "judgment_id",
    "subject_ref",
    "dimension",
    "judgment_signal",
    "evidence_tier_summary",
    "supporting_claim_refs",
    "opposing_claim_refs",
    "representativeness",
    "independence",
    "decision_sufficiency",
    "insufficiency_reasons",
    "what_would_change_the_decision",
    "valid_as_of",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.judgment_assessment.v1"
    },
    "run_id": {
      "$ref": "definitions.schema.json#/$defs/runId"
    },
    "judgment_id": {
      "$ref": "definitions.schema.json#/$defs/identifier"
    },
    "subject_ref": {
      "$ref": "definitions.schema.json#/$defs/artifactRef"
    },
    "dimension": {
      "$ref": "definitions.schema.json#/$defs/assessmentDimension"
    },
    "judgment_signal": {
      "$ref": "definitions.schema.json#/$defs/judgmentSignal"
    },
    "evidence_tier_summary": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/evidenceTier"
      },
      "uniqueItems": true
    },
    "supporting_claim_refs": {
      "$ref": "definitions.schema.json#/$defs/evidenceOrClaimRefArray"
    },
    "opposing_claim_refs": {
      "$ref": "definitions.schema.json#/$defs/evidenceOrClaimRefArray"
    },
    "representativeness": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "independence": {
      "$ref": "definitions.schema.json#/$defs/nonEmptyString"
    },
    "decision_sufficiency": {
      "$ref": "definitions.schema.json#/$defs/decisionSufficiency"
    },
    "insufficiency_reasons": {
      "$ref": "definitions.schema.json#/$defs/insufficiencyReasons"
    },
    "what_would_change_the_decision": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    },
    "valid_as_of": {
      "type": "string",
      "format": "date"
    },
    "limitations": {
      "$ref": "definitions.schema.json#/$defs/uniqueStringArray"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "supported"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "supporting_claim_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "opposed"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "opposing_claim_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "mixed"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "supporting_claim_refs": {
            "type": "array",
            "minItems": 1
          },
          "opposing_claim_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient", "blocked"]
          }
        },
        "required": ["decision_sufficiency"]
      },
      "then": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "insufficiency_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "not_applicable"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "decision_sufficiency": {
            "const": "not_applicable"
          },
          "limitations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_sufficiency": {
            "const": "not_applicable"
          }
        },
        "required": ["decision_sufficiency"]
      },
      "then": {
        "properties": {
          "judgment_signal": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "no_signal"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient", "blocked"]
          },
          "insufficiency_reasons": {
            "type": "array",
            "contains": {
              "const": "no_signal"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment_signal": {
            "const": "source_unavailable"
          }
        },
        "required": ["judgment_signal"]
      },
      "then": {
        "properties": {
          "decision_sufficiency": {
            "enum": ["insufficient", "blocked"]
          },
          "insufficiency_reasons": {
            "type": "array",
            "contains": {
              "const": "source_unavailable"
            }
          }
        }
      }
    }
  ]
}
