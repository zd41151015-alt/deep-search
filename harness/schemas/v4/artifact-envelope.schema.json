{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v4/artifact-envelope.schema.json",
  "title": "Startup Opportunity Formal Assess Contract Envelope v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v4" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.run_manifest.v1",
        "startup_opportunity.research_plan.v1",
        "startup_opportunity.gap_snapshot.v1",
        "startup_opportunity.adaptation_decision.v1",
        "startup_opportunity.adaptation_decision.v2",
        "startup_opportunity.event.v1",
        "startup_opportunity.decision.v1",
        "startup_opportunity.checkpoint.v1",
        "startup_opportunity.planning_context.v1",
        "startup_opportunity.planning_context.v2",
        "startup_opportunity.ai_trigger_source_attestation.v1",
        "startup_opportunity.coverage_attestation.v1",
        "startup_opportunity.intake.v1",
        "startup_opportunity.decision_context.v1",
        "startup_opportunity.scope_frame.v1",
        "startup_opportunity.concept_hypothesis.v1",
        "startup_opportunity.judgment_assessment.v1",
        "startup_opportunity.concept_evidence_assessment_plan.v1",
        "startup_opportunity.concept_evidence_assessment_branch_result.v1",
        "startup_opportunity.concept_evidence_assessment_fan_in.v1",
        "startup_opportunity.hypothesis_evidence_matrix.v1",
        "startup_opportunity.business_engine_thesis.v1",
        "startup_opportunity.concept_evidence_assessment.v1"
      ]
    },
    "artifact_path": { "$ref": "../v1/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v1/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v1/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "$ref": "../v1/definitions.schema.json#/$defs/producerRole" },
    "input_refs": { "$ref": "../v1/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v1/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.run_manifest.v1" },
        "document": { "$ref": "../v1/run-manifest.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.research_plan.v1" },
        "document": { "$ref": "../v1/research-plan.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.gap_snapshot.v1" },
        "document": { "$ref": "../v1/gap-snapshot.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.adaptation_decision.v1" },
        "document": { "$ref": "../v1/adaptation-decision.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.adaptation_decision.v2" },
        "document": { "$ref": "../v2/adaptation-decision.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.event.v1" },
        "document": { "$ref": "../v1/event.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.decision.v1" },
        "document": { "$ref": "../v1/decision.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.checkpoint.v1" },
        "document": { "$ref": "../v1/checkpoint.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.planning_context.v1" },
        "document": { "$ref": "../v2/planning-context.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.planning_context.v2" },
        "document": { "$ref": "../v2/planning-context-v2.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": {
          "const": "startup_opportunity.ai_trigger_source_attestation.v1"
        },
        "document": { "$ref": "../v2/ai-trigger-source-attestation.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.coverage_attestation.v1" },
        "document": { "$ref": "../v2/coverage-attestation.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.intake.v1" },
        "document": { "$ref": "intake.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.decision_context.v1" },
        "document": { "$ref": "decision-context.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.scope_frame.v1" },
        "document": { "$ref": "scope-frame.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.concept_hypothesis.v1" },
        "document": { "$ref": "concept-hypothesis.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.judgment_assessment.v1" },
        "document": { "$ref": "judgment-assessment.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": {
          "const": "startup_opportunity.concept_evidence_assessment_plan.v1"
        },
        "document": { "$ref": "concept-evidence-assessment-plan.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": {
          "const": "startup_opportunity.concept_evidence_assessment_branch_result.v1"
        },
        "document": { "$ref": "concept-evidence-assessment-branch-result.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": {
          "const": "startup_opportunity.concept_evidence_assessment_fan_in.v1"
        },
        "document": { "$ref": "concept-evidence-assessment-fan-in.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.hypothesis_evidence_matrix.v1" },
        "document": { "$ref": "hypothesis-evidence-matrix.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.business_engine_thesis.v1" },
        "document": { "$ref": "business-engine-thesis.schema.json" }
      }
    },
    {
      "properties": {
        "artifact_type": { "const": "startup_opportunity.concept_evidence_assessment.v1" },
        "document": { "$ref": "concept-evidence-assessment.schema.json" }
      }
    }
  ]
}
