{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v17/terminal-report-view.schema.json",
  "title": "Startup Opportunity Terminal Report View v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_id",
    "run_id",
    "mode",
    "research_language",
    "producer_role",
    "owned_output_path",
    "materialized_path",
    "report_ref",
    "report_content_hash",
    "terminal_outcome",
    "section_ids",
    "limitations",
    "audit_appendix_refs",
    "markdown",
    "markdown_content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "startup_opportunity.terminal_report_view.v1"
    },
    "view_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../v12/definitions.schema.json#/$defs/runId"
    },
    "mode": {
      "enum": ["opportunity_discovery", "concept_evidence_assessment"]
    },
    "research_language": {
      "type": "string",
      "minLength": 2
    },
    "producer_role": {
      "const": "harness"
    },
    "owned_output_path": {
      "type": "string",
      "pattern": "^artifacts/reporting/report-markdown\\.r[1-9][0-9]*\\.json$"
    },
    "materialized_path": {
      "const": "report.md"
    },
    "report_ref": {
      "type": "string",
      "pattern": "^artifacts/reporting/terminal-report-source\\.r[1-9][0-9]*\\.json$"
    },
    "report_content_hash": {
      "$ref": "../v12/definitions.schema.json#/$defs/sha256"
    },
    "terminal_outcome": {
      "enum": [
        "completed",
        "insufficient_evidence",
        "deprioritized",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "section_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "execution",
          "research_conclusion",
          "runtime_health",
          "directions",
          "decisive_evidence",
          "ordered_validation_plan",
          "freshness",
          "limitations"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "audit_appendix_refs": {
      "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray"
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "markdown_content_hash": {
      "$ref": "../v12/definitions.schema.json#/$defs/sha256"
    }
  }
}
