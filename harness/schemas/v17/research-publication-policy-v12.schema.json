{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v17/research-publication-policy-v12.schema.json",
  "title": "Startup Opportunity Terminal Reporting Publication Policy v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "current_schema_bundle_version",
    "base_policy_binding",
    "adapter",
    "terminal_reporting_contract"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.research_publication_policy.v12" },
    "policy_id": { "const": "startup_opportunity.terminal_reporting_publication" },
    "policy_version": { "const": "12.0.0" },
    "current_schema_bundle_version": { "const": "16.0.0" },
    "base_policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "schema_version", "policy_version", "content_hash"],
      "properties": {
        "policy_ref": { "const": "harness/policies/research-publication.v11.json" },
        "schema_version": { "const": "startup_opportunity.research_publication_policy.v11" },
        "policy_version": { "const": "11.0.0" },
        "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_version",
        "document_bundle_version",
        "receipt_version",
        "manifest_schema_bundle_version",
        "checkpoint_preferred",
        "blocked_artifact_types"
      ],
      "properties": {
        "envelope_version": { "const": "startup_opportunity.artifact_envelope.v17" },
        "document_bundle_version": { "const": "startup_opportunity.document_bundle.v17" },
        "receipt_version": { "const": "startup_opportunity.artifact_store_operation.v15" },
        "manifest_schema_bundle_version": { "const": "16.0.0" },
        "checkpoint_preferred": { "const": true },
        "blocked_artifact_types": { "type": "array", "maxItems": 0 }
      }
    },
    "terminal_reporting_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_type",
        "derived_artifact_types",
        "shared_across_modes",
        "caller_supplied_judgment",
        "harness_generated_judgment",
        "hidden_model_calls",
        "network_research",
        "external_validation"
      ],
      "properties": {
        "source_artifact_type": { "const": "startup_opportunity.terminal_report_source.v1" },
        "derived_artifact_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "startup_opportunity.decision_brief.v3" },
            { "const": "startup_opportunity.terminal_report_view.v1" },
            { "const": "startup_opportunity.report_consistency_evaluation.v4" }
          ],
          "items": false
        },
        "shared_across_modes": { "const": true },
        "caller_supplied_judgment": { "const": true },
        "harness_generated_judgment": { "const": false },
        "hidden_model_calls": { "const": false },
        "network_research": { "const": false },
        "external_validation": { "const": false }
      }
    }
  }
}
