{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-opportunity.local/schemas/v17/artifact-envelope.schema.json",
  "title": "Startup Opportunity Terminal Reporting Artifact Envelope v17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_path",
    "run_id",
    "created_at",
    "producer_role",
    "input_refs",
    "content_hash",
    "document"
  ],
  "properties": {
    "schema_version": { "const": "startup_opportunity.artifact_envelope.v17" },
    "artifact_type": {
      "enum": [
        "startup_opportunity.terminal_report_source.v1",
        "startup_opportunity.decision_brief.v3",
        "startup_opportunity.terminal_report_view.v1",
        "startup_opportunity.report_consistency_evaluation.v4",
        "startup_opportunity.checkpoint.v1"
      ]
    },
    "artifact_path": { "$ref": "../v12/definitions.schema.json#/$defs/artifactPath" },
    "run_id": { "$ref": "../v12/definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "../v12/definitions.schema.json#/$defs/timestamp" },
    "producer_role": { "enum": ["main_agent", "harness"] },
    "input_refs": { "$ref": "../v12/definitions.schema.json#/$defs/artifactRefArray" },
    "content_hash": { "$ref": "../v12/definitions.schema.json#/$defs/sha256" },
    "document": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.terminal_report_source.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "main_agent" },
          "artifact_path": {
            "type": "string",
            "pattern": "^artifacts/reporting/terminal-report-source\\.r[1-9][0-9]*\\.json$"
          },
          "document": { "$ref": "terminal-report-source.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": { "artifact_type": { "const": "startup_opportunity.decision_brief.v3" } }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "decision-brief-v3.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.terminal_report_view.v1" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "terminal-report-view.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": { "const": "startup_opportunity.report_consistency_evaluation.v4" }
        }
      },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "report-consistency-evaluation-v4.schema.json" }
        }
      }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "startup_opportunity.checkpoint.v1" } } },
      "then": {
        "properties": {
          "producer_role": { "const": "harness" },
          "document": { "$ref": "../v1/checkpoint.schema.json" }
        }
      }
    }
  ]
}
